# Copy to .env (git-ignored). CI passes these as variables instead.

# The GymBook API the app talks to, in Debug and Release builds alike, e.g. https://api.example.com/
# For the local API (GymBook.Api's https profile): https://localhost:7292/ - or https://10.0.2.2:7292/
# from the Android emulator. Debug builds accept the local development certificate for those two hosts.
API_BASE_URL=
