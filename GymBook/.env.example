# Copy to .env (git-ignored). CI passes these as variables instead.

# The GymBook API the app talks to, in Debug and Release builds alike, e.g. https://api.example.com/
# For the local API (GymBook.Api's https profile): https://localhost:7292/ - or https://10.0.2.2:7292/
# from the Android emulator. Debug builds accept the local development certificate for those two hosts.
API_BASE_URL=

# Google sign-in (Android): the Web application OAuth client ID from Google Cloud Console, the same value as the
# API's Google__ClientId. The project also needs an Android OAuth client for the app's package name and signing
# certificate's SHA-1. Optional: leave empty to hide "Continue with Google".
GOOGLE_WEB_CLIENT_ID=

# Google sign-in (iOS): an iOS OAuth client ID from the same Google Cloud project, for bundle ID
# com.yehorskudilov.gymbook; the same value as the API's Google__IosClientId. Optional: leave empty to hide
# "Continue with Google" on iOS.
GOOGLE_IOS_CLIENT_ID=

# Google sign-in (Windows): a Desktop app OAuth client from the same Google Cloud project, and its secret (Google
# doesn't treat a Desktop client's secret as confidential; it ships in the app). The ID is the same value as the
# API's Google__DesktopClientId. Optional: leave empty to hide "Continue with Google" on Windows.
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
