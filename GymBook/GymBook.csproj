<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>GymBook</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Gym Book</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.yehorskudilov.gymbook</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.63</ApplicationDisplayVersion>
		<ApplicationVersion>1000063</ApplicationVersion>
		<!-- Pin Version for every TFM, or MAUI sets it per platform and NuGet restore fails with NU1105. -->
		<Version>$(ApplicationDisplayVersion)</Version>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- iOS can't JIT, and EF Core (LocalStore's Migrate() at startup) hits code AOT can't precompile, crashing on launch.
	     "-all" still AOT-compiles everything and only falls back to the interpreter where AOT can't. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<MtouchInterpreter>-all</MtouchInterpreter>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.45" />
	</ItemGroup>
	<!-- iOS -->
	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios'">
		<!-- The App Store rejects icons with transparency, so fill the background with the app's colour. -->
		<!-- Scale 1 fits the book's full height to the icon, so the corner mask clips it; 0.65 leaves a margin around it. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.65" Color="#0B0D12" />
	</ItemGroup>
	<!-- macOS (MacCatalyst) -->
	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'">
		<!-- The Mac App Store rejects icons with transparency too. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="1" Color="#0B0D12" />
	</ItemGroup>
	<!-- WINDOWS (no scaling, no adaptive layers) -->
	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="1" />
	</ItemGroup>

	<ItemGroup>
		

		<!-- Splash Screen -->
		<!-- Android 12+ shows the splash image masked to a circle two thirds of its size, so splash.svg's viewBox pads the
		     logo into that circle; scaling here doesn't change it. -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B0D12" BaseSize="400,400" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>



	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- Live sync with the API's SyncHub (Src/Services/Sync/LiveSync.cs). -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
	</ItemGroup>

	<!-- Google sign-in on Android (Platforms/Android/GoogleSignInService.cs). -->
	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
		<PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="121.6.0.1" />
		<!-- The Wear OS app's link to the phone (Platforms/Android/WatchSync.cs). -->
		<PackageReference Include="Xamarin.GooglePlayServices.Wearable" Version="120.0.1.2" />
		<!-- Play services brings newer AndroidX libraries than MAUI asks for, but not their -ktx/companion packages, so
		     both versions of some classes end up in the app ("Type ... is defined multiple times"). Lift them to match. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GymBook.Shared\GymBook.Shared.csproj" />
		<ProjectReference Include="..\GymBook.LocalData\GymBook.LocalData.csproj" />
		<ProjectReference Include="..\..\AppSkeleton\AppSkeleton\AppSkeleton.csproj" />
	</ItemGroup>

	<!-- The API the app talks to, in every configuration (see Src/Services/Sync/ApiConfig.cs). Pass it with
	     -p:ApiBaseUrl=https://..., an API_BASE_URL environment variable, or API_BASE_URL in GymBook/.env
	     (see .env.example), in that order; CI sets it from the API_BASE_URL variable. -->
	<PropertyGroup>
		<ApiBaseUrl Condition="'$(ApiBaseUrl)' == ''">$(API_BASE_URL)</ApiBaseUrl>
		<_EnvFile>$(MSBuildProjectDirectory)\.env</_EnvFile>
		<_EnvFileContent Condition="Exists('$(_EnvFile)')">$([System.IO.File]::ReadAllText('$(_EnvFile)'))</_EnvFileContent>
		<ApiBaseUrl Condition="'$(ApiBaseUrl)' == '' and '$(_EnvFileContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_EnvFileContent)', '(?m)^API_BASE_URL=(.*?)\r?$').Groups[1].Value)</ApiBaseUrl>
	</PropertyGroup>

	<!-- The Web application OAuth client ID Google sign-in asks tokens for, the same value as the API's Google__ClientId.
	     Found the same ways as ApiBaseUrl (-p:GoogleWebClientId, GOOGLE_WEB_CLIENT_ID, GymBook/.env). Optional: without it
	     the Google button is hidden. -->
	<PropertyGroup>
		<GoogleWebClientId Condition="'$(GoogleWebClientId)' == ''">$(GOOGLE_WEB_CLIENT_ID)</GoogleWebClientId>
		<GoogleWebClientId Condition="'$(GoogleWebClientId)' == '' and '$(_EnvFileContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_EnvFileContent)', '(?m)^GOOGLE_WEB_CLIENT_ID=(.*?)\r?$').Groups[1].Value)</GoogleWebClientId>
	</PropertyGroup>

	<!-- The iOS OAuth client ID (Google Cloud Console, type iOS, bundle ID com.yehorskudilov.gymbook), the same value as the
	     API's Google__IosClientId. Found the same ways (-p:GoogleIosClientId, GOOGLE_IOS_CLIENT_ID, GymBook/.env).
	     Optional: without it the Google button is hidden on iOS. -->
	<PropertyGroup>
		<GoogleIosClientId Condition="'$(GoogleIosClientId)' == ''">$(GOOGLE_IOS_CLIENT_ID)</GoogleIosClientId>
		<GoogleIosClientId Condition="'$(GoogleIosClientId)' == '' and '$(_EnvFileContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_EnvFileContent)', '(?m)^GOOGLE_IOS_CLIENT_ID=(.*?)\r?$').Groups[1].Value)</GoogleIosClientId>
	</PropertyGroup>

	<Target Name="ValidateApiBaseUrl" BeforeTargets="BeforeBuild;CoreCompile">
		<Error Condition="'$(ApiBaseUrl)' == ''" Text="ApiBaseUrl is not set. Set it via -p:ApiBaseUrl=https://..., an API_BASE_URL environment variable, or GymBook/.env (see .env.example)." />
	</Target>

	<ItemGroup>
		<AssemblyMetadata Include="ApiBaseUrl" Value="$(ApiBaseUrl)" />
		<AssemblyMetadata Include="GoogleWebClientId" Value="$(GoogleWebClientId)" />
		<AssemblyMetadata Include="GoogleIosClientId" Value="$(GoogleIosClientId)" />
	</ItemGroup>

</Project>
