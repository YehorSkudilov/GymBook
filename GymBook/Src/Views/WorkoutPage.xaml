<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.WorkoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:WorkoutViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <Grid Padding="12,16,12,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <ImageButton Source="{StaticResource IconChevronDown}" WidthRequest="40" HeightRequest="40" Padding="8"
                         BackgroundColor="{StaticResource Surface2}" CornerRadius="20" Command="{Binding MinimizeCommand}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Padding="4,0">
                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RenameCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding Elapsed}" Style="{StaticResource Caption}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <ImageButton Grid.Column="2" Source="{StaticResource IconMore}" WidthRequest="40" HeightRequest="40" Padding="9"
                         BackgroundColor="{StaticResource Surface2}" CornerRadius="20" Command="{Binding WorkoutMenuCommand}" />
            <Button Grid.Column="3" Text="Finish" BackgroundColor="{StaticResource Success}" TextColor="#06200F"
                    CornerRadius="12" Padding="18,6" HeightRequest="40" MinimumHeightRequest="40" Command="{Binding FinishCommand}" />
        </Grid>
        <ProgressBar Grid.Row="1" Progress="{Binding Progress}" HeightRequest="3" Margin="16,0" />

        <!-- One photo per exercise; the one on screen is highlighted. Tap to jump to it. -->
        <ScrollView x:Name="Strip" Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
            <HorizontalStackLayout x:Name="StripItems" Spacing="8" Padding="16,0" BindableLayout.ItemsSource="{Binding Exercises}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkoutExerciseViewModel">
                        <Border WidthRequest="76" HeightRequest="58" StrokeShape="RoundRectangle 14" StrokeThickness="2"
                                Stroke="{Binding ThumbStroke}" BackgroundColor="{Binding Thumb.Soft}" Opacity="{Binding ThumbOpacity}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label Text="{Binding Thumb.Initial}" TextColor="{Binding Thumb.Color}" FontFamily="OpenSansSemibold" FontSize="14"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding Thumb.Image}" IsVisible="{Binding Thumb.HasImage}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Exercises: swipe sideways from one to the next -->
        <Grid Grid.Row="3">
            <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="16,24" Spacing="12">
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Empty workout" Style="{StaticResource H3}" HorizontalOptions="Center" />
                        <Label Text="Add exercises to start logging sets." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="+ Add exercise" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Accent}" Command="{Binding AddExerciseCommand}" />
            </VerticalStackLayout>

            <CarouselView ItemsSource="{Binding Exercises}" Position="{Binding CurrentIndex, Mode=TwoWay}" Loop="False"
                          IsBounceEnabled="False" IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkoutExerciseViewModel">
                        <ScrollView>
                            <VerticalStackLayout Padding="16,14,16,110" Spacing="14">

                                <!-- Exercise -->
                                <VerticalStackLayout Spacing="4">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="28" FontAttributes="Bold"
                                               TextColor="{StaticResource Accent}" VerticalOptions="Center" MaximumWidthRequest="280" />
                                        <ImageButton Source="{StaticResource IconMore}" WidthRequest="44" HeightRequest="34" Padding="10,5" VerticalOptions="Center"
                                                     BackgroundColor="{StaticResource Surface2}" CornerRadius="17" Command="{Binding MenuCommand}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding TargetText}" Style="{StaticResource Caption}" FontSize="15" />
                                </VerticalStackLayout>

                                <Label IsVisible="{Binding HasRecommendation}" Text="{Binding Recommendation}" FontSize="14" TextColor="#BFD2FF" />
                                <!-- How to do the exercise for the goal. -->
                                <Label IsVisible="{Binding HasTip}" Text="{Binding Tip}" Style="{StaticResource Caption}" FontSize="13" />
                                <!-- After a set outside the rep range. -->
                                <Border IsVisible="{Binding HasLiveAdvice}" BackgroundColor="{StaticResource WarningSoft}" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <Label Text="{Binding LiveAdvice}" FontSize="13" TextColor="{StaticResource Warning}" />
                                </Border>

                                <!-- Warm-ups fold away behind this -->
                                <Border IsVisible="{Binding HasWarmups}" Style="{StaticResource Pill}" Padding="16,9" HorizontalOptions="Start">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleWarmupsCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding WarmupText}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextSecondary}" />
                                </Border>

                                <!-- Set table -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="48,*,*,Auto,*,56" ColumnSpacing="8" Padding="0,0,0,4">
                                        <Label Text="#" Style="{StaticResource Overline}" FontSize="13" HorizontalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding UnitLabel}" Style="{StaticResource Overline}" FontSize="13" HorizontalOptions="Center" />
                                        <Label Grid.Column="2" Text="REPS" Style="{StaticResource Overline}" FontSize="13" HorizontalOptions="Center" />
                                        <Label Grid.Column="3" Text="RIR" WidthRequest="52" HorizontalTextAlignment="Center" IsVisible="{Binding TrackRir}"
                                               Style="{StaticResource Overline}" FontSize="13" />
                                        <Label Grid.Column="4" Text="E1RM" Style="{StaticResource Overline}" FontSize="13" HorizontalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SetRowViewModel">
                                                <Grid IsVisible="{Binding IsVisible}" ColumnDefinitions="48,*,*,Auto,*,56" ColumnSpacing="8" MinimumHeightRequest="52">
                                                    <!-- Tapping a row that isn't being logged opens it for editing. -->
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding EditCommand}" />
                                                    </Grid.GestureRecognizers>

                                                    <!-- Set number; tap for delete / warm-up -->
                                                    <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 14" HeightRequest="46" StrokeThickness="0"
                                                            Opacity="{Binding NumberOpacity}">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding MenuCommand}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="{Binding Label}" TextColor="{Binding LabelColor}" FontFamily="OpenSansSemibold" FontSize="18"
                                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>

                                                    <!-- The current set: edited in place -->
                                                    <Border Grid.Column="1" Style="{StaticResource InputBox}" HeightRequest="46" StrokeShape="RoundRectangle 14" IsVisible="{Binding IsCurrent}">
                                                        <Entry Text="{Binding WeightText}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontFamily="OpenSansSemibold" FontSize="20" Placeholder="0" />
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource InputBox}" HeightRequest="46" StrokeShape="RoundRectangle 14" IsVisible="{Binding IsCurrent}">
                                                        <Entry Text="{Binding RepsText}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontFamily="OpenSansSemibold" FontSize="20" Placeholder="0" />
                                                    </Border>
                                                    <Border Grid.Column="3" Style="{StaticResource InputBox}" HeightRequest="46" WidthRequest="52" StrokeShape="RoundRectangle 14" IsVisible="{Binding ShowRirInput}">
                                                        <Entry Text="{Binding RirText}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="18" Placeholder="–" />
                                                    </Border>

                                                    <!-- Every other set: plain values -->
                                                    <Label Grid.Column="1" Text="{Binding WeightDisplay}" TextColor="{Binding ValueColor}" FontSize="20" FontFamily="OpenSansSemibold"
                                                           HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsNotCurrent}" />
                                                    <Label Grid.Column="2" Text="{Binding RepsDisplay}" TextColor="{Binding ValueColor}" FontSize="20" FontFamily="OpenSansSemibold"
                                                           HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsNotCurrent}" />
                                                    <Label Grid.Column="3" Text="{Binding RirDisplay}" TextColor="{Binding ValueColor}" FontSize="18" WidthRequest="52"
                                                           HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding ShowRirValue}" />

                                                    <Label Grid.Column="4" Text="{Binding E1Rm}" TextColor="{StaticResource TextSecondary}" FontSize="18"
                                                           HorizontalOptions="Center" VerticalOptions="Center" />

                                                    <!-- Check: big on the current set, a small tick on finished ones -->
                                                    <Border Grid.Column="5" BackgroundColor="{Binding CheckBackground}" StrokeShape="RoundRectangle 14" HeightRequest="46"
                                                            StrokeThickness="0" IsVisible="{Binding IsCurrent}">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                        </Border.GestureRecognizers>
                                                        <Image Source="{Binding CheckIcon}" WidthRequest="24" HeightRequest="24" />
                                                    </Border>
                                                    <Image Grid.Column="5" Source="{StaticResource IconCheck}" WidthRequest="18" HeightRequest="18" Opacity="0.8" IsVisible="{Binding ShowDoneTick}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Button Text="+ Add set" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Command="{Binding AddSetCommand}" />
                                </VerticalStackLayout>

                                <!-- Last time -->
                                <Border IsVisible="{Binding HasPrevious}" Style="{StaticResource InnerCard}" StrokeShape="RoundRectangle 20" Padding="18,14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding PreviousTitle}" Style="{StaticResource Caption}" FontSize="15" FontFamily="OpenSansSemibold" />
                                        <Grid ColumnDefinitions="0.6*,*,*,*">
                                            <Label Text="#" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding UnitLabel}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                            <Label Grid.Column="2" Text="REPS" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                            <Label Grid.Column="3" Text="E1RM" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                        </Grid>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreviousRows}" Spacing="4">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlanDaySetRow">
                                                    <Grid ColumnDefinitions="0.6*,*,*,*">
                                                        <Label Text="{Binding Number}" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding First}" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" />
                                                        <Label Grid.Column="2" Text="{Binding Second}" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" />
                                                        <Label Grid.Column="3" Text="{Binding Third}" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <Label Text="Help" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" FontSize="18">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding HelpCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </ScrollView>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- Rest timer button, floating over the exercise -->
            <Border IsVisible="{Binding IsResting, Converter={StaticResource Not}}" WidthRequest="72" HeightRequest="60" StrokeShape="RoundRectangle 20"
                    StrokeThickness="0" BackgroundColor="{StaticResource Surface3}" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartRestNowCommand}" />
                </Border.GestureRecognizers>
                <Image Source="{StaticResource IconTimer}" WidthRequest="28" HeightRequest="28" />
            </Border>
        </Grid>

        <!-- Rest timer -->
        <Border Grid.Row="4" IsVisible="{Binding IsResting}" BackgroundColor="{StaticResource Surface2}"
                StrokeShape="RoundRectangle 24,24,0,0" Padding="20,14,20,22">
            <VerticalStackLayout Spacing="12">
                <ProgressBar Progress="{Binding RestProgress}" HeightRequest="4" />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Image Source="{StaticResource IconTimer}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Rest" Style="{StaticResource Caption}" FontSize="12" />
                        <Label Text="{Binding RestText}" FontFamily="OpenSansSemibold" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="−15" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Surface3}"
                            Command="{Binding AdjustRestCommand}" CommandParameter="-15" VerticalOptions="Center" />
                    <Button Grid.Column="3" Text="+15" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Surface3}"
                            Command="{Binding AdjustRestCommand}" CommandParameter="15" VerticalOptions="Center" />
                    <Button Grid.Column="4" Text="Skip" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Accent}" TextColor="White"
                            Command="{Binding SkipRestCommand}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
