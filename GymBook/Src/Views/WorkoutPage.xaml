<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.WorkoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:WorkoutViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Grid Padding="12,16,16,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <ImageButton Source="ic_chevron_down.png" WidthRequest="40" HeightRequest="40" Padding="8"
                         BackgroundColor="{StaticResource Surface2}" CornerRadius="20" Command="{Binding MinimizeCommand}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Padding="4,0">
                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="17" LineBreakMode="TailTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RenameCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding Elapsed}" Style="{StaticResource Caption}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Accent}" />
                    <Label Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Finish" BackgroundColor="{StaticResource Success}" TextColor="#06200F"
                    CornerRadius="12" Padding="18,6" HeightRequest="40" MinimumHeightRequest="40" Command="{Binding FinishCommand}" />
        </Grid>
        <ProgressBar Grid.Row="1" Progress="{Binding Progress}" HeightRequest="3" Margin="16,0" />

        <!-- Exercises -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="12,14,12,32" Spacing="14">

                <Border IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Empty workout" Style="{StaticResource H3}" HorizontalOptions="Center" />
                        <Label Text="Add exercises to start logging sets." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkoutExerciseViewModel">
                            <Border Style="{StaticResource Card}" Padding="14,14,14,10">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Accent}" />
                                            <Label Text="{Binding TargetText}" Style="{StaticResource Caption}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <ImageButton Grid.Column="1" Source="ic_more.png" WidthRequest="34" HeightRequest="34" Padding="5"
                                                     VerticalOptions="Start" BackgroundColor="Transparent" Command="{Binding MenuCommand}" />
                                    </Grid>

                                    <Border IsVisible="{Binding HasRecommendation}" BackgroundColor="{StaticResource AccentSoft}" StrokeShape="RoundRectangle 10" Padding="10,8">
                                        <Label Text="{Binding Recommendation}" FontSize="13" TextColor="#BFD2FF" />
                                    </Border>

                                    <!-- Column headers -->
                                    <Grid ColumnDefinitions="34,*,72,56,48,40" ColumnSpacing="6" Padding="2,0">
                                        <Label Text="SET" Style="{StaticResource Overline}" FontSize="10" HorizontalOptions="Center" />
                                        <Label Grid.Column="1" Text="PREVIOUS" Style="{StaticResource Overline}" FontSize="10" />
                                        <Label Grid.Column="2" Text="{Binding UnitLabel}" Style="{StaticResource Overline}" FontSize="10" HorizontalOptions="Center" />
                                        <Label Grid.Column="3" Text="REPS" Style="{StaticResource Overline}" FontSize="10" HorizontalOptions="Center" />
                                        <Label Grid.Column="4" Text="RIR" IsVisible="{Binding TrackRir}" Style="{StaticResource Overline}" FontSize="10" HorizontalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SetRowViewModel">
                                                <Border BackgroundColor="{Binding RowBackground}" StrokeShape="RoundRectangle 10" Padding="2,3">
                                                    <Grid ColumnDefinitions="34,*,72,56,48,40" ColumnSpacing="6">
                                                        <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 8" HeightRequest="32" WidthRequest="32">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding MenuCommand}" />
                                                            </Border.GestureRecognizers>
                                                            <Label Text="{Binding Label}" TextColor="{Binding LabelColor}" FontFamily="OpenSansSemibold" FontSize="13"
                                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                                        </Border>
                                                        <Label Grid.Column="1" Text="{Binding Previous}" Style="{StaticResource Caption}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                        <Border Grid.Column="2" Style="{StaticResource InputBox}">
                                                            <Entry Text="{Binding WeightText}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontFamily="OpenSansSemibold" Placeholder="0" />
                                                        </Border>
                                                        <Border Grid.Column="3" Style="{StaticResource InputBox}">
                                                            <Entry Text="{Binding RepsText}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontFamily="OpenSansSemibold" Placeholder="0" />
                                                        </Border>
                                                        <Border Grid.Column="4" Style="{StaticResource InputBox}" IsVisible="{Binding TrackRir}">
                                                            <Entry Text="{Binding RirText}" Keyboard="Numeric" HorizontalTextAlignment="Center" Placeholder="–" />
                                                        </Border>
                                                        <Border Grid.Column="5" BackgroundColor="{Binding CheckBackground}" StrokeShape="RoundRectangle 10" HeightRequest="36" WidthRequest="38">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                            </Border.GestureRecognizers>
                                                            <Image Source="{Binding CheckIcon}" WidthRequest="20" HeightRequest="20" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Button Text="+ Add set" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Command="{Binding AddSetCommand}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="+ Add exercise" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Accent}" Command="{Binding AddExerciseCommand}" />
                <Button Text="Discard workout" Style="{StaticResource DangerButton}" Command="{Binding DiscardCommand}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Rest timer -->
        <Border Grid.Row="3" IsVisible="{Binding IsResting}" BackgroundColor="{StaticResource Surface2}"
                StrokeShape="RoundRectangle 24,24,0,0" Padding="20,14,20,22">
            <VerticalStackLayout Spacing="12">
                <ProgressBar Progress="{Binding RestProgress}" HeightRequest="4" />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Image Source="ic_timer.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Rest" Style="{StaticResource Caption}" FontSize="12" />
                        <Label Text="{Binding RestText}" FontFamily="OpenSansSemibold" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="−15" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Surface3}"
                            Command="{Binding AdjustRestCommand}" CommandParameter="-15" VerticalOptions="Center" />
                    <Button Grid.Column="3" Text="+15" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Surface3}"
                            Command="{Binding AdjustRestCommand}" CommandParameter="15" VerticalOptions="Center" />
                    <Button Grid.Column="4" Text="Skip" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Accent}" TextColor="White"
                            Command="{Binding SkipRestCommand}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
