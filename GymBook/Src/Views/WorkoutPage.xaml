<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.WorkoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    x:DataType="vm:WorkoutViewModel"
    Shell.PresentationMode="ModalNotAnimated"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Backdrop="#B3000000">

    <!-- Slides up over the page it was opened from; Minimize slides it back down. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" BackgroundColor="{StaticResource Bg}">

        <!-- Header -->
        <Grid Padding="12,16,12,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <ImageButton Source="{StaticResource IconChevronDown}" WidthRequest="40" HeightRequest="40" Padding="8"
                         BackgroundColor="{StaticResource Surface2}" CornerRadius="20" Command="{Binding MinimizeCommand}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Padding="4,0">
                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RenameCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding Elapsed}" Style="{StaticResource Caption}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding ProgressText}" Style="{StaticResource Caption}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <ImageButton Grid.Column="2" Source="{StaticResource IconMore}" WidthRequest="40" HeightRequest="40" Padding="9"
                         BackgroundColor="{StaticResource Surface2}" CornerRadius="20" Command="{Binding WorkoutMenuCommand}" />
            <!-- Only once every set is ticked; before that, Finish is in the ··· menu -->
            <Button Grid.Column="3" Text="Finish" BackgroundColor="{StaticResource Success}" TextColor="#06200F" IsVisible="{Binding CanFinish}" controls:Pop.When="{Binding CanFinish}"
                    CornerRadius="12" Padding="18,6" HeightRequest="40" MinimumHeightRequest="40" Command="{Binding FinishCommand}" />
        </Grid>
        <ProgressBar Grid.Row="1" controls:SmoothProgress.Value="{Binding Progress}" HeightRequest="3" Margin="10,0" />

        <!-- One photo per exercise, scrolling sideways; the one on screen is highlighted. Tap to jump to it, + to add more. -->
        <Grid Grid.Row="2" Margin="0,10,0,0" IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}">
            <CollectionView x:Name="Strip" ItemsSource="{Binding Exercises}" HeightRequest="62" HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView WidthRequest="8" Color="Transparent" />
                </CollectionView.Header>
                <!-- After the last photo: add more exercises -->
                <CollectionView.Footer>
                    <Border WidthRequest="58" HeightRequest="58" Margin="8,0,16,0" VerticalOptions="Center" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                            BackgroundColor="{StaticResource Surface2}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddExerciseCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="{StaticResource IconPlus}" WidthRequest="26" HeightRequest="26" />
                    </Border>
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkoutExerciseViewModel">
                        <Border WidthRequest="76" HeightRequest="58" VerticalOptions="Center" StrokeShape="RoundRectangle 14" StrokeThickness="2"
                                Stroke="{Binding ThumbStroke}" BackgroundColor="{Binding Thumb.TileBackground}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label Text="{Binding Thumb.Initial}" TextColor="{Binding Thumb.Color}" IsVisible="{Binding Thumb.HasFallback}"
                                       FontFamily="OpenSansSemibold" FontSize="14"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding Thumb.Image, Converter={StaticResource Thumb}}" IsVisible="{Binding Thumb.HasImage}" Aspect="AspectFill" Margin="-1" />
                                <!-- Every set done: a small tick in the corner -->
                                <Border WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" StrokeThickness="1.5" Stroke="{StaticResource Bg}"
                                        BackgroundColor="{StaticResource Success}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,3,3,0"
                                        IsVisible="{Binding IsFinished}" controls:Pop.When="{Binding IsFinished}" controls:Pop.Amount="1.4" InputTransparent="True">
                                    <Image Source="{StaticResource IconCheck}" WidthRequest="12" HeightRequest="12" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Exercises: swipe sideways from one to the next -->
        <Grid Grid.Row="3">
            <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="10,24" Spacing="12">
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Empty workout" Style="{StaticResource H3}" HorizontalOptions="Center" />
                        <Label Text="Add exercises to start logging sets." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="+ Add exercise" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Accent}" Command="{Binding AddExerciseCommand}" />
            </VerticalStackLayout>

            <!-- One page per exercise: swipe sideways (or drag with the mouse, or two fingers on a trackpad) for the next
                 or previous, which follows the finger like the app's tabs; tapping a photo in the strip slides over to
                 it. Filled in the code-behind. -->
            <skeleton:CView x:Name="ExercisePager" IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}" />

        </Grid>

        <!-- Rest after a set: counts down, then below zero in red once it's over (with a notification), until the next set
             is started. −15 / +15 move it; taken back above zero, it says so again when it gets there. -->
        <Border Grid.Row="4" IsVisible="{Binding IsResting}" BackgroundColor="{StaticResource Surface2}"
                StrokeShape="RoundRectangle 24,24,0,0" Padding="20,14,20,22">
            <VerticalStackLayout Spacing="12">
                <!-- Glides down second by second rather than stepping -->
                <ProgressBar controls:SmoothProgress.Value="{Binding RestProgress}" controls:SmoothProgress.Length="1000" HeightRequest="4" />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Image Source="{StaticResource IconTimer}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding RestCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        <Label Text="{Binding RestText}" TextColor="{Binding RestTextColor}" FontFamily="OpenSansSemibold" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="−15" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Surface3}"
                            Command="{Binding AdjustRestCommand}" CommandParameter="-15" VerticalOptions="Center" />
                    <Button Grid.Column="3" Text="+15" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Surface3}"
                            Command="{Binding AdjustRestCommand}" CommandParameter="15" VerticalOptions="Center" />
                    <Button Grid.Column="4" Text="Start set" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Success}" TextColor="White"
                            FontFamily="OpenSansSemibold" Command="{Binding StartSetCommand}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- The set being done: how long it's taken so far, from the end of the rest (or the workout's start). Back to the
             rest if it was started too soon. -->
        <Border Grid.Row="4" IsVisible="{Binding IsTimingSet}" BackgroundColor="{StaticResource Surface2}"
                StrokeShape="RoundRectangle 24,24,0,0" Padding="20,14,20,22">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Image Source="{StaticResource IconTimer}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding SetTimerCaption}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding SetTimerText}" FontFamily="OpenSansSemibold" FontSize="26" FontAttributes="Bold" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="Back to rest" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Surface3}"
                        Command="{Binding BackToRestCommand}" IsVisible="{Binding CanGoBackToRest}" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Celebrations over everything, never in the way of a tap: confetti when an exercise is done, and a banner for
             that or for the rest being over. Played from the code-behind. -->
        <controls:ConfettiView x:Name="Confetti" Grid.RowSpan="5" IsVisible="False" IsRunning="False" InputTransparent="True" />
        <Border x:Name="Banner" Grid.RowSpan="5" VerticalOptions="Start" HorizontalOptions="Center" Margin="16,72,16,0" Opacity="0"
                InputTransparent="True" StrokeShape="RoundRectangle 22" StrokeThickness="0" Padding="18,12" BackgroundColor="{StaticResource Surface3}">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.4" Radius="18" Offset="0,6" />
            </Border.Shadow>
            <HorizontalStackLayout Spacing="10">
                <Image x:Name="BannerIcon" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                <VerticalStackLayout VerticalOptions="Center">
                    <Label x:Name="BannerTitle" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource TextPrimary}" />
                    <Label x:Name="BannerText" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</views:SheetPage>
