<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.PlanDayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:PlanDayViewModel"
    Shell.PresentationMode="ModalNotAnimated"
    Shell.NavBarIsVisible="False"
    Backdrop="#B3000000">

    <!-- A sheet over the dimmed Home page, showing one day of the plan week. -->
    <Border Margin="0,28,0,0" BackgroundColor="{StaticResource Bg}" StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
            <Button Text="Close" Style="{StaticResource GhostButton}" TextColor="{StaticResource Accent}" FontSize="17"
                    HorizontalOptions="End" Margin="8,8,8,0" Command="{Binding CloseCommand}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="10,0,10,24" Spacing="18">

                    <!-- Day -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <!-- A grid, not a stack: a long name shortens instead of pushing the ··· under the diagram. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding DayName}" Style="{StaticResource Title}" FontSize="32" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <ImageButton Grid.Column="1" Source="{StaticResource IconMore}" WidthRequest="44" HeightRequest="36" Padding="10,6"
                                             BackgroundColor="{StaticResource Surface2}" CornerRadius="18" VerticalOptions="Center"
                                             Command="{Binding OptionsCommand}" />
                            </Grid>
                            <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="17" />
                            <Label Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="17" />
                            <Label Text="{Binding When}" IsVisible="{Binding HasWhen}" Style="{StaticResource Caption}" FontSize="17" />
                        </VerticalStackLayout>
                        <!-- Tap for the full muscle breakdown. -->
                        <GraphicsView Grid.Column="1" Drawable="{Binding DayMap}" WidthRequest="120" HeightRequest="120"
                                      VerticalOptions="Center" IsVisible="{Binding IsWorkoutDay}">
                            <GraphicsView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenMusclesCommand}" />
                            </GraphicsView.GestureRecognizers>
                        </GraphicsView>
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource AccentSoft}" IsVisible="{Binding IsNext}" Padding="12,6">
                            <Label Text="Up next" TextColor="{StaticResource Accent}" FontSize="13" FontFamily="OpenSansSemibold" />
                        </Border>
                        <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource SuccessSoft}" IsVisible="{Binding IsDone}" Padding="12,6">
                            <Label Text="✓  Finished" TextColor="{StaticResource Success}" FontSize="13" FontFamily="OpenSansSemibold" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- A finished workout's numbers, 2 by 2 so they fit, each with how it compares with last time -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" IsVisible="{Binding HasStats}">
                        <Border Style="{StaticResource InnerCard}" Padding="12,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding StatTime.Label}" Style="{StaticResource Overline}" FontSize="10" />
                                <Label Text="{Binding StatTime.Value}" Style="{StaticResource StatValue}" FontSize="20" />
                                <Label Text="{Binding StatTime.Note}" TextColor="{Binding StatTime.NoteColor}" FontSize="12" IsVisible="{Binding StatTime.HasNote}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="12,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding StatVolume.Label}" Style="{StaticResource Overline}" FontSize="10" />
                                <Label Text="{Binding StatVolume.Value}" Style="{StaticResource StatValue}" FontSize="20" />
                                <Label Text="{Binding StatVolume.Note}" TextColor="{Binding StatVolume.NoteColor}" FontSize="12" IsVisible="{Binding StatVolume.HasNote}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource InnerCard}" Padding="12,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding StatSets.Label}" Style="{StaticResource Overline}" FontSize="10" />
                                <Label Text="{Binding StatSets.Value}" Style="{StaticResource StatValue}" FontSize="20" />
                                <Label Text="{Binding StatSets.Note}" TextColor="{Binding StatSets.NoteColor}" FontSize="12" IsVisible="{Binding StatSets.HasNote}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InnerCard}" Padding="12,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding StatRecords.Label}" Style="{StaticResource Overline}" FontSize="10" />
                                <Label Text="{Binding StatRecords.Value}" Style="{StaticResource StatValue}" FontSize="20" />
                                <Label Text="{Binding StatRecords.Note}" TextColor="{Binding StatRecords.NoteColor}" FontSize="12" IsVisible="{Binding StatRecords.HasNote}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Each exercise against the last time it was done, with its recent trend -->
                    <Border Style="{StaticResource Card}" Padding="14" IsVisible="{Binding HasImprovements}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Compared with last time" Style="{StaticResource H3}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Improvements}" Spacing="16">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExerciseProgressItem">
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Ellipse Fill="{Binding Color}" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" LineBreakMode="TailTruncation" />
                                            </Grid>
                                            <Label Text="{Binding Headline}" TextColor="{Binding Color}" FontSize="14" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                            <GraphicsView Drawable="{Binding Chart}" HeightRequest="90" IsVisible="{Binding HasChart}" Margin="0,4,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- This workout over its last sessions -->
                    <Border Style="{StaticResource Card}" Padding="14" IsVisible="{Binding HasTrends}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="This workout over time" Style="{StaticResource H3}" />
                            <Label Text="VOLUME" Style="{StaticResource Overline}" FontSize="10" />
                            <GraphicsView Drawable="{Binding VolumeTrend}" HeightRequest="130" />
                            <Label Text="DURATION" Style="{StaticResource Overline}" FontSize="10" Margin="0,6,0,0" />
                            <GraphicsView Drawable="{Binding DurationTrend}" HeightRequest="130" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Exercises, each with its set table -->
                    <Border Style="{StaticResource Card}" Padding="14" IsVisible="{Binding IsWorkoutDay}">
                        <VerticalStackLayout Spacing="18">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="18">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanDaySheetExercise">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Grid WidthRequest="92" HeightRequest="68">
                                                    <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="{Binding Thumb.Soft}">
                                                        <Grid>
                                                            <Label Text="{Binding Thumb.Initial}" TextColor="{Binding Thumb.Color}" FontFamily="OpenSansSemibold"
                                                                   FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                                            <Image Source="{Binding Thumb.Image}" IsVisible="{Binding Thumb.HasImage}" Aspect="AspectFill" />
                                                        </Grid>
                                                    </Border>
                                                    <Border IsVisible="{Binding IsDone}" WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 13"
                                                            StrokeThickness="0" BackgroundColor="{StaticResource Accent}" Padding="4"
                                                            HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-4,-4">
                                                        <Image Source="{StaticResource IconCheck}" />
                                                    </Border>
                                                </Grid>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="18" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="15" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <Border Style="{StaticResource InnerCard}" Padding="12,10">
                                                <VerticalStackLayout Spacing="6">
                                                    <Grid ColumnDefinitions="0.6*,*,*,*">
                                                        <Label Text="#" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding FirstHeader}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                                        <Label Grid.Column="2" Text="{Binding SecondHeader}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                                        <Label Grid.Column="3" Text="{Binding ThirdHeader}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                                    </Grid>
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="6">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:PlanDaySetRow">
                                                                <Grid ColumnDefinitions="0.6*,*,*,*">
                                                                    <Label Text="{Binding Number}" TextColor="{StaticResource TextSecondary}" FontSize="15" HorizontalOptions="Center" />
                                                                    <Label Grid.Column="1" Text="{Binding First}" TextColor="{StaticResource TextSecondary}" FontSize="15" HorizontalOptions="Center" />
                                                                    <Label Grid.Column="2" Text="{Binding Second}" TextColor="{StaticResource TextSecondary}" FontSize="15" HorizontalOptions="Center" />
                                                                    <Label Grid.Column="3" Text="{Binding Third}" TextColor="{StaticResource TextSecondary}" FontSize="15" HorizontalOptions="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="No exercises yet. Add some from the ··· menu." Style="{StaticResource Caption}" HorizontalOptions="Center"
                                   IsVisible="{Binding IsEmptyDay}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- A finished workout: how fatigued each muscle was right after it, in detail -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasStats}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Fatigue after this workout" Style="{StaticResource H3}" />
                            <GraphicsView Drawable="{Binding FatigueMap}" HeightRequest="340" />
                            <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="5">
                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FF4D5E" VerticalOptions="Center" />
                                    <Label Text="Fatigued" Style="{StaticResource Caption}" FontSize="12" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FFB020" VerticalOptions="Center" />
                                    <Label Text="Recovering" Style="{StaticResource Caption}" FontSize="12" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#2ED47A" VerticalOptions="Center" />
                                    <Label Text="Fresh" Style="{StaticResource Caption}" FontSize="12" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                            <Label Text="{Binding FatigueSummary}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            <!-- Every muscle it worked, most fatigued first -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FatigueMuscles}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MuscleRecoveryItem">
                                        <VerticalStackLayout Padding="0,10" Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Ellipse Fill="{Binding Color}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                                    <Label Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="Center" />
                                                    <Label Text="{Binding Percent}" TextColor="{Binding Color}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding Color}" HeightRequest="6" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Rest -->
                    <Border Style="{StaticResource Card}" Padding="20,28" IsVisible="{Binding IsRestDay}">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Rest day" Style="{StaticResource H3}" HorizontalOptions="Center" />
                            <Label Text="{Binding Meta}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Button Grid.Row="2" Text="{Binding ActionText}" Style="{StaticResource PrimaryButton}"
                    Margin="10,8,10,16" IsVisible="{Binding HasAction}" Command="{Binding DayActionCommand}" />
            <!-- A finished workout, wherever it was opened from: remove it from the history (after asking). -->
            <Button Grid.Row="2" Text="Discard workout" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Danger}"
                    Margin="10,8,10,16" IsVisible="{Binding CanDiscard}" Command="{Binding DiscardCommand}" />
        </Grid>
    </Border>
</views:SheetPage>
