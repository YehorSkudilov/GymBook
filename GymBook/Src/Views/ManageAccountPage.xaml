<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.ManageAccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:ManageAccountViewModel"
    Shell.NavBarIsVisible="False"
    Backdrop="#B3000000">

    <Border Margin="0,28,0,0" BackgroundColor="{StaticResource Bg}" StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0" Padding="0">
    <Grid RowDefinitions="Auto,*" Padding="20,16,20,20">
        <Button Text="✕" FontSize="18" Style="{StaticResource StepButton}" WidthRequest="40" HeightRequest="40"
                BackgroundColor="{StaticResource Surface2}" HorizontalOptions="Start" Command="{Binding CloseCommand}" />

        <ScrollView Grid.Row="1" Margin="0,20,0,0">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding Title}" Style="{StaticResource Title}" FontSize="28" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="15" />

                <!-- Email: the new address, then the code sent to it -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEmail}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                        <Label Text="NEW EMAIL" Style="{StaticResource Overline}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Change" Style="{StaticResource GhostButton}" FontSize="13" Padding="4,0" HeightRequest="28"
                                Command="{Binding EditEmailCommand}" IsVisible="{Binding ShowCode}" />
                    </Grid>
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <Entry x:Name="EmailEntry" Text="{Binding NewEmail}" Placeholder="you@example.com" Keyboard="Email" MaxLength="256"
                               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Next" Completed="OnEmailCompleted"
                               IsEnabled="{Binding ShowCode, Converter={StaticResource Not}}" />
                    </Border>
                </VerticalStackLayout>

                <!-- The emailed code: for the new address, or to reset a forgotten password -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowCode}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="CODE" Style="{StaticResource Overline}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Resend code" Style="{StaticResource GhostButton}" FontSize="13" Padding="4,0" HeightRequest="28"
                                Command="{Binding ResendCodeCommand}" IsVisible="{Binding Resetting}" />
                    </Grid>
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <Entry x:Name="CodeEntry" Text="{Binding Code}" Placeholder="123456" Keyboard="Numeric" MaxLength="16"
                               ReturnType="{Binding CodeReturnType}" Completed="OnCodeCompleted" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowCurrentPassword}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="CURRENT PASSWORD" Style="{StaticResource Overline}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Forgot password?" Style="{StaticResource GhostButton}" FontSize="13" Padding="4,0" HeightRequest="28"
                                Command="{Binding ForgotPasswordCommand}" />
                    </Grid>
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <skeleton:CPasswordEntry x:Name="CurrentEntry" Text="{Binding CurrentPassword}" Completed="OnCurrentCompleted"
                                                 TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextTertiary}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Password: the new one, typed twice -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsPassword}">
                    <Label Text="NEW PASSWORD" Style="{StaticResource Overline}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <skeleton:CPasswordEntry x:Name="NewEntry" Text="{Binding NewPassword}" Completed="OnNewCompleted" ReturnType="Next"
                                                 TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextTertiary}" />
                    </Border>
                    <Label Text="CONFIRM NEW PASSWORD" Style="{StaticResource Overline}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <skeleton:CPasswordEntry x:Name="ConfirmEntry" Text="{Binding ConfirmPassword}" Completed="OnSubmit" ReturnType="Go"
                                                 TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextTertiary}" />
                    </Border>
                    <Label Text="{Binding PasswordHint}" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>

                <skeleton:CLabel Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="14" Margin="0,4,0,0" />

                <Grid Margin="0,8,0,0">
                    <Button Text="{Binding SubmitText}" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HeightRequest="24" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
    </Border>
</views:SheetPage>
