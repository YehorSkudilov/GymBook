<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.PlanDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:PlanDetailViewModel"
    Title="Edit plan"
    Shell.TabBarIsVisible="False">

    <!-- Leaving with unsaved changes asks to save or discard them first. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding BackCommand}" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="More" IconImageSource="{StaticResource IconMore}" Command="{Binding MoreCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="0,4,0,24" Spacing="18">

                <!-- Plan -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="20,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Name}" Style="{StaticResource H2}" TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="12" />
                        <!-- Edits aren't saved until "Save changes" in the ··· menu. -->
                        <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource WarningSoft}" IsVisible="{Binding HasChanges}"
                                HorizontalOptions="Start" Padding="8,2" Margin="0,4,0,0">
                            <Label Text="Unsaved changes · save from ···" TextColor="{StaticResource Warning}" FontSize="11" FontFamily="OpenSansSemibold" />
                        </Border>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{StaticResource SuccessSoft}"
                            IsVisible="{Binding IsActive}" VerticalOptions="Center">
                        <Label Text="Active" TextColor="{StaticResource Success}" FontSize="12" FontFamily="OpenSansSemibold" />
                    </Border>
                    <Button Grid.Column="1" Text="Set active" Style="{StaticResource SmallButton}" VerticalOptions="Center"
                            IsVisible="{Binding IsActive, Converter={StaticResource Not}}" Command="{Binding SetActiveCommand}" />
                </Grid>

                <!-- Only when the weekly AI check found something to improve in this (active) plan. Otherwise it's in the ··· menu. -->
                <Border BackgroundColor="{StaticResource AccentSoft}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="14,12" Margin="16,0"
                        IsVisible="{Binding HasSuggestions}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="OutlinedIcons" Glyph="auto_awesome" Color="{StaticResource Accent}" Size="32" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding SuggestionsTitle}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Accent}" />
                                <Label Text="From your recent workouts on it" Style="{StaticResource Caption}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Review" Style="{StaticResource SmallButton}" BackgroundColor="{StaticResource Accent}" TextColor="White"
                                    Command="{Binding ImproveWithAiCommand}" />
                            <Button Grid.Column="1" Text="Not now" Style="{StaticResource SmallButton}" Command="{Binding DismissSuggestionsCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Day strip -->
                <ScrollView x:Name="DayStrip" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="4" Padding="16,0">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlanDayChip">
                                    <!-- Tap to show the day; hold and drag along the strip to move it. -->
                                    <controls:ReorderItem Orientation="Horizontal" MoveCommand="{Binding MoveCommand}">
                                        <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="12,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontFamily="OpenSansSemibold" FontSize="15"
                                                   MaximumWidthRequest="110" LineBreakMode="TailTruncation" />
                                        </Border>
                                    </controls:ReorderItem>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                Padding="12,8" Margin="4,0,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddDayCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="+" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" FontSize="15" />
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Selected day -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="20,0">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <!-- A grid, not a stack: a long name shortens instead of pushing the ··· under the diagram. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding DayName}" Style="{StaticResource Title}" FontSize="28" VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />
                            <ImageButton Grid.Column="1" Source="{StaticResource IconMore}" WidthRequest="44" HeightRequest="36" Padding="10,6"
                                         BackgroundColor="{StaticResource Surface2}" CornerRadius="18" VerticalOptions="Center"
                                         Command="{Binding DayOptionsCommand}" />
                        </Grid>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding DayLabel}" Style="{StaticResource Caption}" FontSize="15" VerticalOptions="Center" />
                            <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource SuccessSoft}" IsVisible="{Binding IsDayDone}"
                                    Padding="8,2" VerticalOptions="Center">
                                <Label Text="Finished" TextColor="{StaticResource Success}" FontSize="11" FontFamily="OpenSansSemibold" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding DayMeta}" Style="{StaticResource Caption}" FontSize="15" TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                    <!-- Tap for the full muscle breakdown. -->
                    <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                            Padding="6" IsVisible="{Binding IsWorkoutDay}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMusclesCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <GraphicsView Drawable="{Binding DayMap}" WidthRequest="116" HeightRequest="116" InputTransparent="True" />
                            <Image Source="{StaticResource IconChevronRight}" WidthRequest="12" HeightRequest="12" HorizontalOptions="End"
                                   VerticalOptions="End" Opacity="0.7" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Exercises: tap one to change it here, hold and drag it up or down to move it -->
                <Border Style="{StaticResource Card}" Margin="16,0" Padding="14" IsVisible="{Binding IsWorkoutDay}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DayExercises}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlanDayExercise">
                                    <!-- The row itself follows the finger; the others slide aside. A solid background so it covers them. -->
                                    <controls:ReorderItem MoveCommand="{Binding MoveCommand}">
                                    <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="0,4">
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                </Grid.GestureRecognizers>
                                                <Border WidthRequest="88" HeightRequest="66" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                                        BackgroundColor="{Binding Thumb.Soft}" VerticalOptions="Start">
                                                    <Grid>
                                                        <Label Text="{Binding Thumb.Initial}" TextColor="{Binding Thumb.Color}" FontFamily="OpenSansSemibold"
                                                               FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                                        <Image Source="{Binding Thumb.Image}" IsVisible="{Binding Thumb.HasImage}" Aspect="AspectFill" />
                                                    </Grid>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                                    <VerticalStackLayout>
                                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding Equipment}" Style="{StaticResource Caption}" />
                                                    </VerticalStackLayout>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="0,7">
                                                            <Label Text="{Binding Sets}" FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" />
                                                        </Border>
                                                        <Border Grid.Column="1" BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="0,7">
                                                            <Label Text="{Binding Reps}" FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" />
                                                        </Border>
                                                    </Grid>
                                                </VerticalStackLayout>
                                                <!-- A grip, so it's clear the row can be dragged -->
                                                <Label Grid.Column="2" Text="⋮⋮" TextColor="{StaticResource TextTertiary}" FontSize="16" VerticalOptions="Center" />
                                            </Grid>

                                            <!-- Opened: change it right here -->
                                            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsExpanded}">
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                                    <Border Style="{StaticResource InnerCard}" Padding="10,8">
                                                        <VerticalStackLayout Spacing="6">
                                                            <Label Text="SETS" Style="{StaticResource Overline}" FontSize="10" />
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <Button Text="−" Style="{StaticResource StepButton}" Command="{Binding SetsDownCommand}" />
                                                                <Label Grid.Column="1" Text="{Binding SetsText}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                                                <Button Grid.Column="2" Text="+" Style="{StaticResource StepButton}" Command="{Binding SetsUpCommand}" />
                                                            </Grid>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="10,8" IsVisible="{Binding ShowRir}">
                                                        <VerticalStackLayout Spacing="6">
                                                            <Label Text="TARGET RIR" Style="{StaticResource Overline}" FontSize="10" />
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <Button Text="−" Style="{StaticResource StepButton}" Command="{Binding RirDownCommand}" />
                                                                <Label Grid.Column="1" Text="{Binding RirText}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                                                <Button Grid.Column="2" Text="+" Style="{StaticResource StepButton}" Command="{Binding RirUpCommand}" />
                                                            </Grid>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Row="1" Style="{StaticResource InnerCard}" Padding="10,8">
                                                        <VerticalStackLayout Spacing="6">
                                                            <Label Text="REP RANGE" Style="{StaticResource Overline}" FontSize="10" />
                                                            <Label Text="{Binding RepsText}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" />
                                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                                                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                                                    <Button Text="−" Style="{StaticResource StepButton}" WidthRequest="28" MinimumWidthRequest="28" Command="{Binding RepsDownCommand}" />
                                                                    <Button Text="+" Style="{StaticResource StepButton}" WidthRequest="28" MinimumWidthRequest="28" Command="{Binding RepsUpCommand}" />
                                                                </HorizontalStackLayout>
                                                                <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                                                                    <Button Text="−" Style="{StaticResource StepButton}" WidthRequest="28" MinimumWidthRequest="28" Command="{Binding RangeDownCommand}" />
                                                                    <Button Text="+" Style="{StaticResource StepButton}" WidthRequest="28" MinimumWidthRequest="28" Command="{Binding RangeUpCommand}" />
                                                                </HorizontalStackLayout>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="*,*">
                                                                <Label Text="min" Style="{StaticResource Caption}" FontSize="11" HorizontalOptions="Center" />
                                                                <Label Grid.Column="1" Text="max" Style="{StaticResource Caption}" FontSize="11" HorizontalOptions="Center" />
                                                            </Grid>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InnerCard}" Padding="10,8">
                                                        <VerticalStackLayout Spacing="6">
                                                            <Label Text="REST" Style="{StaticResource Overline}" FontSize="10" />
                                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                                                <Button Text="−" Style="{StaticResource StepButton}" Command="{Binding RestDownCommand}" />
                                                                <Label Grid.Column="1" Text="{Binding RestText}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                                                <Button Grid.Column="2" Text="+" Style="{StaticResource StepButton}" Command="{Binding RestUpCommand}" />
                                                            </Grid>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                    <Button Text="Exercise info" Style="{StaticResource SmallButton}" Command="{Binding OpenCommand}" IsEnabled="{Binding HasInfo}" />
                                                    <Button Grid.Column="1" Text="Remove" Style="{StaticResource SmallButton}" TextColor="{StaticResource Danger}"
                                                            Command="{Binding RemoveCommand}" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                    </controls:ReorderItem>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="No exercises yet." Style="{StaticResource Caption}" HorizontalOptions="Center" IsVisible="{Binding IsEmptyDay}" />
                        <Button Text="+ Add exercise" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Accent}" Command="{Binding AddExerciseCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Rest -->
                <Border Style="{StaticResource Card}" Margin="16,0" Padding="20,28" IsVisible="{Binding IsRestDay}">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Rest day" Style="{StaticResource H3}" HorizontalOptions="Center" />
                        <Label Text="Drag it in the day strip to move it, or remove it from the ··· menu." Style="{StaticResource Caption}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- No Start here: this page is for editing the plan. Workouts start from the Workout tab. -->
    </Grid>
</views:BasePage>
