<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.SessionDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:SessionDetailViewModel"
    Title="Workout"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="16">

            <!-- Celebration header after finishing -->
            <Border IsVisible="{Binding IsFinished}" Background="{StaticResource AccentGradient}" Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Image Source="{StaticResource IconTrophy}" WidthRequest="44" HeightRequest="44" />
                    <Label Text="Workout complete!" FontFamily="OpenSansSemibold" FontSize="22" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Your progress has been saved and your next session is updated." FontSize="13" TextColor="#DDE6FF" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Name}" Style="{StaticResource Title}" FontSize="26" />
                <Label Text="{Binding DateText}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Duration}" Style="{StaticResource StatValue}" />
                        <Label Text="Duration" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Volume}" Style="{StaticResource StatValue}" />
                        <Label Text="Volume" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Sets}" Style="{StaticResource StatValue}" />
                        <Label Text="Working sets" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="{Binding Records}" Style="{StaticResource StatValue}" TextColor="{StaticResource Warning}" />
                        <Label Text="Personal records" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border IsVisible="{Binding HasRecords}" Style="{StaticResource Card}" BackgroundColor="{StaticResource WarningSoft}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="{StaticResource IconTrophy}" WidthRequest="20" HeightRequest="20" />
                        <Label Text="New personal records" Style="{StaticResource H3}" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecordItems}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LineItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Value}" TextColor="{StaticResource Warning}" FontSize="13" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Exercises" Style="{StaticResource H3}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkoutPreviewItem">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" />
                                <Label Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="12" />
                                <Label Text="{Binding Exercises}" FontSize="14" LineHeight="1.3" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button IsVisible="{Binding IsFinished}" Text="Done" Style="{StaticResource PrimaryButton}" Command="{Binding DoneCommand}" />
            <Button IsVisible="{Binding IsFinished, Converter={StaticResource Not}}" Text="Delete workout" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
