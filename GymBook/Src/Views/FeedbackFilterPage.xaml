<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.FeedbackFilterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:FeedbackFilterViewModel"
    Shell.NavBarIsVisible="False"
    Backdrop="#B3000000">

    <!-- The feedback list's filters and order, from the button by its search box. Each change applies at once. -->
    <views:SheetPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="6,6,0,0" />
        </Style>
        <DataTemplate x:Key="Chip" x:DataType="vm:ChipItem">
            <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 999" StrokeThickness="0" Padding="14,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="13" FontFamily="OpenSansSemibold" />
            </Border>
        </DataTemplate>
    </views:SheetPage.Resources>

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped" />
        </Grid.GestureRecognizers>
        <Border VerticalOptions="End" BackgroundColor="{StaticResource Bg}" StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0" Padding="0" Margin="0,40,0,0">
            <!-- Swallows taps, so only the dimmed area above closes the sheet. -->
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="16,22,16,24">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <Label Text="Filter and sort" Style="{StaticResource H2}" FontSize="20" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Reset" Style="{StaticResource SmallButton}" Command="{Binding ResetCommand}" VerticalOptions="Center" />
                        <ImageButton Grid.Column="2" Source="{StaticResource IconClose}" WidthRequest="36" HeightRequest="36" Padding="8"
                                     CornerRadius="18" BackgroundColor="{StaticResource Surface2}" VerticalOptions="Center" Clicked="OnDoneClicked" />
                    </Grid>

                    <!-- Status: a dropdown of the board's columns, any number ticked (none: all) -->
                    <Label Text="Status" Style="{StaticResource SectionTitle}" IsVisible="{Binding HasStatuses}" />
                    <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasStatuses}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleStatusesCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding StatusSummary}" VerticalOptions="Center" />
                                <Image Grid.Column="1" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="OutlinedIcons" Glyph="{Binding DropdownGlyph}" Color="{StaticResource TextSecondary}" Size="32" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding IsStatusOpen}" BindableLayout.ItemsSource="{Binding Statuses}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatusOption">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="10,0,16,0">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                            </Grid.GestureRecognizers>
                                            <CheckBox IsChecked="{Binding IsChecked}" Color="{StaticResource Accent}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Feature requests: only the user's own -->
                    <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding IsFeatures}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Only mine" />
                                <Label Text="Feature requests you suggested" Style="{StaticResource Caption}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding Mine}" />
                        </Grid>
                    </Border>

                    <!-- The order, either way round -->
                    <Label Text="Sort by" Style="{StaticResource SectionTitle}" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Sorts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChipItem">
                                <ContentView Padding="0,0,8,8">
                                    <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 999" StrokeThickness="0" Padding="14,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="13" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Directions}" BindableLayout.ItemTemplate="{StaticResource Chip}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</views:SheetPage>
