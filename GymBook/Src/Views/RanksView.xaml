<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GymBook.Views.RanksView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:RanksViewModel">

    <!-- Ranks, the Ranks tab of Progress: tiers in each category (strength by muscle group, and consistency), the leaderboards and friends. -->
    <ContentView.Resources>
        <!-- A chip of the board's filters (scope, lift) -->
        <DataTemplate x:Key="Chip" x:DataType="vm:ChipItem">
            <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 999" StrokeThickness="0" Padding="14,7">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" /></Border.GestureRecognizers>
                <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="13" FontFamily="OpenSansSemibold" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BoardRow" x:DataType="vm:LeaderboardRow">
            <Grid ColumnDefinitions="36,40,*,Auto" ColumnSpacing="10" Padding="12,10" BackgroundColor="{Binding Background}">
                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenCommand}" /></Grid.GestureRecognizers>
                <Label Text="{Binding Position}" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                <!-- Gym Book Pro members: a ring in Pro's gradient round the picture, as on their profile -->
                <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Ellipse Fill="{StaticResource ProGradient}" IsVisible="{Binding IsPro}" />
                    <Ellipse Fill="{StaticResource Surface}" Margin="2" IsVisible="{Binding IsPro}" />
                    <Border Margin="4" StrokeShape="RoundRectangle 16" StrokeThickness="0" Background="{StaticResource AccentGradient}">
                        <Grid>
                            <Label Text="{Binding Initial}" TextColor="White" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding HasAvatar, Converter={StaticResource Not}}" />
                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" IsVisible="{Binding HasAvatar}" />
                        </Grid>
                    </Border>
                </Grid>
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                    <Label Text="{Binding Username, StringFormat='@{0}'}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Tier}" TextColor="{Binding TierColor}" FontSize="12" FontFamily="OpenSansSemibold" />
                </VerticalStackLayout>
                <Label Grid.Column="3" Text="{Binding Value}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </ContentView.Resources>

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" Margin="0,24" />

        <!-- Ranks need the account -->
        <VerticalStackLayout Padding="16,24" Spacing="14" IsVisible="{Binding NeedsSignIn}">
            <Label Text="Compete on strength" Style="{StaticResource H2}" HorizontalTextAlignment="Center" />
            <Label Text="Sign in to see how your strength and consistency rank against everyone else's, and race your friends up the tiers."
                   Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            <Button Text="Sign in" Style="{StaticResource PrimaryButton}" Command="{Binding SignInCommand}" />
        </VerticalStackLayout>

        <VerticalStackLayout Padding="16,24" Spacing="12" IsVisible="{Binding LoadFailed}">
            <Label Text="Couldn't load the ranks" Style="{StaticResource H3}" HorizontalTextAlignment="Center" />
            <Label Text="Ranks are worked out on the server, so they need a connection." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            <Button Text="Try again" Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}" />
        </VerticalStackLayout>

        <!-- Not ranked yet -->
        <VerticalStackLayout Padding="16,24" Spacing="14" IsVisible="{Binding CanJoin}">
            <Label Text="Join the leaderboards" Style="{StaticResource H2}" HorizontalTextAlignment="Center" />
            <Label Text="Earn a tier from Bronze to Elite for chest, back, shoulders, legs, posterior chain, arms and consistency, worked out from all your logged workouts and body weight, and see where you stand globally and among friends."
                   Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            <Button Text="Join" Style="{StaticResource PrimaryButton}" Command="{Binding JoinCommand}" />
            <Button Text="How ranks work" Style="{StaticResource SecondaryButton}" Command="{Binding HowItWorksCommand}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding InRanks}">
            <VerticalStackLayout Spacing="14">

                <!-- Overall -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="OVERALL" Style="{StaticResource Overline}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding OverallTier}" TextColor="{Binding OverallColor}" FontFamily="OpenSansSemibold" FontSize="30" />
                            <Label Grid.Column="1" Text="{Binding OverallScore}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="{Binding OverallProgress}" ProgressColor="{Binding OverallColor}" />
                        <Label Text="{Binding PositionText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- The categories -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Lifts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RankLiftItem">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="{Binding Tier}" TextColor="{Binding TierColor}" FontFamily="OpenSansSemibold" FontSize="14" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding TierColor}" IsVisible="{Binding Ranked}" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Leaderboard -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Margin="4,6,4,0">
                    <Label Text="LEADERBOARD" Style="{StaticResource Overline}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Friends" TextColor="{StaticResource Accent}" FontSize="14" VerticalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowFriendsCommand}" /></Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="2" Text="Add friend" TextColor="{StaticResource Accent}" FontSize="14" VerticalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding AddFriendCommand}" /></Label.GestureRecognizers>
                    </Label>
                </Grid>
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ScopeChips}" BindableLayout.ItemTemplate="{StaticResource Chip}" />
                <!-- Keeps a sideways drag from swiping the tabs -->
                <controls:HorizontalDragArea>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding LiftChips}" BindableLayout.ItemTemplate="{StaticResource Chip}" />
                    </ScrollView>
                </controls:HorizontalDragArea>

                <Border Style="{StaticResource Card}" Padding="0,4">
                    <Grid>
                        <ActivityIndicator IsRunning="{Binding IsBoardLoading}" IsVisible="{Binding IsBoardLoading}" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" Margin="0,12" />
                        <Label Text="{Binding BoardEmptyText}" Style="{StaticResource Caption}" Margin="16,14" IsVisible="{Binding IsBoardEmpty}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Board}" BindableLayout.ItemTemplate="{StaticResource BoardRow}" />
                    </Grid>
                </Border>
                <!-- The user's own place when it's below the top of the board -->
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasMyRow}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyRows}" BindableLayout.ItemTemplate="{StaticResource BoardRow}" />
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                    <Button Text="How ranks work" Style="{StaticResource SecondaryButton}" Command="{Binding HowItWorksCommand}" />
                    <Button Grid.Column="1" Text="Leave ranks" Style="{StaticResource SecondaryButton}" Command="{Binding LeaveCommand}" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentView>
