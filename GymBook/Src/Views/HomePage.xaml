<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:HomeViewModel">

        <VerticalStackLayout Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding DateText}" Style="{StaticResource Caption}" />
                <Label Text="{Binding Greeting}" Style="{StaticResource Title}" />
            </VerticalStackLayout>

            <!-- Back after a break: weights are scaled down automatically. -->
            <Border IsVisible="{Binding HasWelcomeBack}" Style="{StaticResource Card}" BackgroundColor="{StaticResource AccentSoft}" Padding="16,14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Welcome back" Style="{StaticResource H3}" TextColor="{StaticResource Accent}" />
                    <Label Text="{Binding WelcomeBack}" FontSize="13" TextColor="#BFD2FF" />
                </VerticalStackLayout>
            </Border>

            <!-- Week strip -->
            <Border Style="{StaticResource Card}" Padding="12,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCalendarCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="4,0">
                        <Label Text="This week" Style="{StaticResource H3}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Image Source="ic_flame.png" WidthRequest="16" HeightRequest="16" />
                            <Label Text="{Binding Streak}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    </Grid>
                    <FlexLayout BindableLayout.ItemsSource="{Binding WeekDays}" JustifyContent="SpaceAround">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayItem">
                                <VerticalStackLayout Spacing="6" WidthRequest="38">
                                    <Label Text="{Binding Letter}" Style="{StaticResource Caption}" HorizontalOptions="Center" FontSize="12" />
                                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{Binding Background}" Stroke="{Binding Border}" StrokeThickness="1.5">
                                        <Label Text="{Binding Day}" TextColor="{Binding DayColor}" FontFamily="OpenSansSemibold" FontSize="14"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Grid ColumnDefinitions="*,*,*" Padding="4,6,4,0">
                        <VerticalStackLayout>
                            <Label Text="{Binding WeekWorkouts}" Style="{StaticResource StatValue}" FontSize="18" />
                            <Label Text="Workouts" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding WeekSets}" Style="{StaticResource StatValue}" FontSize="18" />
                            <Label Text="Sets" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="{Binding WeekVolume}" Style="{StaticResource StatValue}" FontSize="18" />
                            <Label Text="Volume" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Next workout: tap to preview the day; Start starts it straight away. -->
            <Border IsVisible="{Binding HasPlan}" Style="{StaticResource Card}" Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenNextCommand}" />
                </Border.GestureRecognizers>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource AccentSoft}" Offset="0" />
                        <GradientStop Color="{StaticResource Surface}" Offset="0.85" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout>
                        <Label Text="{Binding NextLabel}" Style="{StaticResource Overline}" TextColor="{StaticResource Accent}" />
                        <Label Text="{Binding NextWorkoutName}" Style="{StaticResource H2}" FontSize="22" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding NextWorkoutMuscles}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <!-- Exercise tiles -->
                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding NextThumbs}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciseThumb">
                                    <Border WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                            BackgroundColor="{Binding Soft}">
                                        <Grid>
                                            <Label Text="{Binding Initial}" TextColor="{Binding Color}" FontFamily="OpenSansSemibold" FontSize="13"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image Source="{Binding Image}" IsVisible="{Binding HasImage}" Aspect="AspectFill" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label Text="{Binding NextMore}" Style="{StaticResource Caption}" FontFamily="OpenSansSemibold" VerticalOptions="Center" Margin="4,0,0,0" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding NextWorkoutMeta}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="▶  Start" Style="{StaticResource PrimaryButton}" HeightRequest="44" Padding="26,0"
                                Command="{Binding StartNextCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- This week's plan -->
            <VerticalStackLayout IsVisible="{Binding HasPlan}" Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Label Text="{Binding PlanName}" Style="{StaticResource H2}" TextColor="{StaticResource Accent}"
                           VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <!-- Tap to view another unlocked week. -->
                    <Label Grid.Column="1" Text="{Binding PlanWeek, StringFormat='{0} ▾'}" Style="{StaticResource H3}" TextColor="{StaticResource Accent}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChooseWeekCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <ImageButton Grid.Column="2" Source="ic_more.png" WidthRequest="36" HeightRequest="30" Padding="6,3"
                                 BackgroundColor="{StaticResource Surface2}" CornerRadius="15" VerticalOptions="Center"
                                 Command="{Binding PlanOptionsCommand}" />
                </Grid>

                <Border Style="{StaticResource Card}" Padding="16,6">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlanDays}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlanDayItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,10" BackgroundColor="Transparent">
                                    <Border WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" StrokeThickness="1.5"
                                            Stroke="{Binding BadgeColor}" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Label Text="{Binding Badge}" TextColor="{Binding BadgeColor}" FontFamily="OpenSansSemibold" FontSize="13"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <!-- Tap the day to view it, then start it or mark it finished; days can be done in any order. -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" BackgroundColor="Transparent">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding Name}" TextColor="{Binding NameColor}" FontFamily="OpenSansSemibold" FontSize="17"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Status}" IsVisible="{Binding IsNext}" Style="{StaticResource Caption}" FontSize="12"
                                               TextColor="{StaticResource Accent}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" IsVisible="{Binding HasThumbnails}" BackgroundColor="{StaticResource Surface2}"
                                            StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="4" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="3">
                                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Thumbnails}" Spacing="3">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 9" StrokeThickness="0"
                                                                BackgroundColor="{StaticResource Surface3}">
                                                            <Image Source="{Binding .}" Aspect="AspectFill" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding More}" IsVisible="{Binding HasMore}" Style="{StaticResource Caption}"
                                                   FontFamily="OpenSansSemibold" VerticalOptions="Center" Margin="3,0,4,0" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- No plan -->
            <Border IsVisible="{Binding HasPlan, Converter={StaticResource Not}}" Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="No active plan" Style="{StaticResource H2}" />
                    <Label Text="Answer a few questions and GymBook builds a personalised plan with automatic progression." Style="{StaticResource Caption}" />
                    <Button Text="Create my plan" Style="{StaticResource PrimaryButton}" Command="{Binding CreatePlanCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Start an empty workout" Style="{StaticResource SecondaryButton}" Command="{Binding StartEmptyCommand}" />

            <!-- Recovery -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Muscle recovery" Style="{StaticResource H3}" />
                    <GraphicsView Drawable="{Binding MuscleMap}" HeightRequest="260" />
                    <Grid ColumnDefinitions="*,*" Padding="30,0">
                        <Label Text="Front" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Grid.Column="1" Text="Back" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </Grid>
                    <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FF4D5E" VerticalOptions="Center" />
                            <Label Text="Fatigued" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FFB020" VerticalOptions="Center" />
                            <Label Text="Recovering" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#2ED47A" VerticalOptions="Center" />
                            <Label Text="Fresh" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <!-- Preview: drag back to see past recovery, forward to see when muscles will be fresh. -->
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding RecoveryWhen}" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Now" Style="{StaticResource SmallButton}" IsVisible="{Binding IsRecoveryPreview}"
                                    Command="{Binding RecoveryNowCommand}" />
                        </Grid>
                        <!-- Maximum before Minimum: the minimum can only go negative once the maximum allows the range. -->
                        <Slider Maximum="96" Minimum="-168" Value="{Binding RecoveryHours}"
                                MinimumTrackColor="{StaticResource Accent}" MaximumTrackColor="{StaticResource Surface3}" ThumbColor="{StaticResource Accent}" />
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="7 days ago" Style="{StaticResource Caption}" FontSize="11" />
                            <Label Grid.Column="1" Text="In 4 days" Style="{StaticResource Caption}" FontSize="11" HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                    <Label Text="{Binding RecoverySummary}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    <Button Text="Details" Style="{StaticResource GhostButton}" Command="{Binding OpenRecoveryCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
</views:TabView>
