<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:HomeViewModel">

        <VerticalStackLayout Spacing="16">

            <!-- Header: the date with the connection at the end, then the greeting with a little scene for the time of day -->
            <VerticalStackLayout Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Surface2}" Padding="8,3" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="5">
                            <Ellipse Fill="{Binding ConnectionColor}" WidthRequest="7" HeightRequest="7" VerticalOptions="Center" />
                            <Label Text="{Binding ConnectionText}" TextColor="{StaticResource TextSecondary}" FontSize="11"
                                   FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <!-- Wraps onto a second line rather than being cut short next to the scene. -->
                    <Label Text="{Binding Greeting}" Style="{StaticResource Title}" VerticalOptions="Center" LineBreakMode="WordWrap" MaxLines="2" />
                    <controls:TimeOfDayView Grid.Column="1" Part="{Binding DayPart}" IsRunning="{Binding IsShowing}" WidthRequest="56" HeightRequest="56" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Back after a break: weights are scaled down automatically. -->
            <Border IsVisible="{Binding HasWelcomeBack}" Style="{StaticResource Card}" BackgroundColor="{StaticResource AccentSoft}" Padding="16,14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Welcome back" Style="{StaticResource H3}" TextColor="{StaticResource Accent}" />
                    <Label Text="{Binding WelcomeBack}" FontSize="13" TextColor="#BFD2FF" />
                </VerticalStackLayout>
            </Border>

            <!-- Week strip -->
            <Border Style="{StaticResource Card}" Padding="12,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCalendarCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="4,0">
                        <Label Text="This week" Style="{StaticResource H3}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Image Source="{StaticResource IconFlame}" WidthRequest="16" HeightRequest="16" />
                            <Label Text="{Binding Streak}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Image Grid.Column="2" Source="{StaticResource IconChevronRight}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    </Grid>
                    <FlexLayout BindableLayout.ItemsSource="{Binding WeekDays}" JustifyContent="SpaceAround">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayItem">
                                <VerticalStackLayout Spacing="6" WidthRequest="38">
                                    <Label Text="{Binding Letter}" Style="{StaticResource Caption}" HorizontalOptions="Center" FontSize="12" />
                                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{Binding Background}" Stroke="{Binding Border}" StrokeThickness="1.5">
                                        <Label Text="{Binding Day}" TextColor="{Binding DayColor}" FontFamily="OpenSansSemibold" FontSize="14"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <!-- Three equal columns across the whole card, each stat centred in its own. -->
                    <Grid ColumnDefinitions="*,*,*" Padding="4,6,4,0" HorizontalOptions="Fill">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <controls:StatIconView Icon="Workouts" IsRunning="{Binding IsShowing}" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" />
                            <Label Text="{Binding WeekWorkouts}" Style="{StaticResource StatValue}" FontSize="18" HorizontalOptions="Center" />
                            <Label Text="Workouts" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <controls:StatIconView Icon="Sets" IsRunning="{Binding IsShowing}" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" />
                            <Label Text="{Binding WeekSets}" Style="{StaticResource StatValue}" FontSize="18" HorizontalOptions="Center" />
                            <Label Text="Sets" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <controls:StatIconView Icon="Volume" IsRunning="{Binding IsShowing}" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" />
                            <Label Text="{Binding WeekVolume}" Style="{StaticResource StatValue}" FontSize="18" HorizontalOptions="Center" />
                            <Label Text="Volume" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Next workout: tap to preview the day; Start starts it straight away. -->
            <!-- No padding on the card itself: the glow fills it edge to edge, and the content has the padding instead. -->
            <!-- While a workout is running it shows that one instead, and both tapping it and Resume open it. -->
            <Border IsVisible="{Binding ShowNextCard}" Style="{StaticResource Card}" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenNextCommand}" />
                </Border.GestureRecognizers>
                <Grid>
                <!-- Light drifting behind the card in the readiness colour: faint when tired, rich when fresh. It fills the whole
                     card; the card's rounded shape clips it. -->
                <controls:ReadinessGlowView Shape="Card" Readiness="{Binding NextGlow}" Tint="{Binding NextTint}" IsRunning="{Binding IsShowing}" />
                <VerticalStackLayout Spacing="12" Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="{Binding NextLabel}" Style="{StaticResource Overline}" TextColor="{Binding NextTint}" />
                            <Label Text="{Binding NextWorkoutName}" Style="{StaticResource H2}" FontSize="22" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding NextWorkoutMuscles}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <!-- How recovered its muscles are -->
                        <controls:ReadinessRingView Grid.Column="1" Readiness="{Binding NextReadiness}" Tint="{Binding NextTint}" IsRunning="{Binding IsShowing}"
                                                    WidthRequest="54" HeightRequest="54" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding NextReadyText}" TextColor="{Binding NextTint}" FontSize="12" FontFamily="OpenSansSemibold" Margin="0,-6,0,0" />

                    <!-- Exercise tiles -->
                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding NextThumbs}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciseThumb">
                                    <Border WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                            BackgroundColor="{Binding Soft}">
                                        <Grid>
                                            <Label Text="{Binding Initial}" TextColor="{Binding Color}" FontFamily="OpenSansSemibold" FontSize="13"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image Source="{Binding Image, Converter={StaticResource Thumb}}" IsVisible="{Binding HasImage}" Aspect="AspectFill" Margin="-1" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label Text="{Binding NextMore}" Style="{StaticResource Caption}" FontFamily="OpenSansSemibold" VerticalOptions="Center" Margin="4,0,0,0" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <Label Text="{Binding NextWorkoutMeta}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="Center" />
                        <!-- Skips this workout for its week; Up next moves on. Not while a workout is running. -->
                        <!-- A quiet partner to Start: same height and shape, see-through so the glow shows, with a skip icon. -->
                        <Button Grid.Column="1" Text="Skip" HeightRequest="44" Padding="14,0" CornerRadius="14" FontSize="14"
                                BackgroundColor="#14FFFFFF" BorderColor="#2EFFFFFF" BorderWidth="1" TextColor="{StaticResource TextSecondary}"
                                ContentLayout="Left,4" VerticalOptions="Center"
                                IsVisible="{Binding IsWorkoutRunning, Converter={StaticResource Not}}" Command="{Binding SkipNextCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="OutlinedIcons" Glyph="skip_next" Color="{StaticResource TextSecondary}" Size="18" />
                            </Button.ImageSource>
                        </Button>
                        <!-- The fresher you are, the more it invites a tap: grey and still when tired, vivid with a pulsing glow when ready. -->
                        <Grid Grid.Column="2">
                            <controls:ReadinessGlowView Shape="Button" Readiness="{Binding NextGlow}" Tint="{Binding StartColor}" IsRunning="{Binding IsShowing}"
                                                        Margin="-10" />
                            <Button Text="{Binding StartText}" Style="{StaticResource PrimaryButton}" HeightRequest="44" Padding="26,0"
                                    BackgroundColor="{Binding StartColor}" TextColor="{Binding StartTextColor}" Command="{Binding StartNextCommand}" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- This week's plan -->
            <VerticalStackLayout IsVisible="{Binding HasPlan}" Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Label Text="{Binding PlanName}" Style="{StaticResource H2}" TextColor="{StaticResource Accent}"
                           VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <!-- Tap to view another unlocked week. -->
                    <Label Grid.Column="1" Text="{Binding PlanWeek, StringFormat='{0} ▾'}" Style="{StaticResource H3}" TextColor="{StaticResource Accent}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChooseWeekCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <ImageButton Grid.Column="2" Source="{StaticResource IconMore}" WidthRequest="36" HeightRequest="30" Padding="6,3"
                                 BackgroundColor="{StaticResource Surface2}" CornerRadius="15" VerticalOptions="Center"
                                 Command="{Binding PlanOptionsCommand}" />
                </Grid>

                <!-- Less padding on the card than elsewhere: each row has its own, so the in-progress row's tile has room
                     around it inside the card (nothing is drawn outside a row, which would be cut off). -->
                <Border Style="{StaticResource Card}" Padding="8,6">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlanDays}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlanDayItem">
                                <Grid BackgroundColor="Transparent">
                                <!-- The workout in progress: green light drifting across its row, in a rounded tile the size of the row -->
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="1"
                                        Stroke="#332ED47A" BackgroundColor="#0F2ED47A" IsVisible="{Binding IsRunning}">
                                    <controls:ReadinessGlowView Shape="Card" Readiness="1" Tint="#2ED47A" IsRunning="{Binding IsRunning}" />
                                </Border>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5" Padding="0,3,8,3">
                                    <!-- ...and its badge beats, with a glow pulsing out around it: room for the glow all round -->
                                    <Grid WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                                        <controls:ReadinessGlowView Shape="Button" Readiness="1" Tint="#2ED47A"
                                                                    IsVisible="{Binding IsRunning}" IsRunning="{Binding IsRunning}" />
                                        <Border WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" StrokeThickness="1.5" controls:Pulse.While="{Binding IsRunning}"
                                                Stroke="{Binding BadgeColor}" BackgroundColor="Transparent">
                                            <Label Text="{Binding Badge}" TextColor="{Binding BadgeColor}" FontFamily="OpenSansSemibold" FontSize="13"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                    <!-- Tap the day to view it, then start it or mark it finished; days can be done in any order. -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" BackgroundColor="Transparent">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding Name}" TextColor="{Binding NameColor}" FontFamily="OpenSansSemibold" FontSize="17"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" Style="{StaticResource Caption}" FontSize="12"
                                               TextColor="{Binding StatusColor}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" IsVisible="{Binding HasThumbnails}" BackgroundColor="{StaticResource Surface2}"
                                            StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="4" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="3">
                                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Thumbnails}" Spacing="3">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ExerciseThumb">
                                                        <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 9" StrokeThickness="0"
                                                                BackgroundColor="{Binding Soft}">
                                                            <Grid>
                                                                <Label Text="{Binding Initial}" TextColor="{Binding Color}" FontFamily="OpenSansSemibold"
                                                                       FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                                                                <Image Source="{Binding Image, Converter={StaticResource Thumb}}" IsVisible="{Binding HasImage}"
                                                                       Aspect="AspectFill" Margin="-1" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding More}" IsVisible="{Binding HasMore}" Style="{StaticResource Caption}"
                                                   FontFamily="OpenSansSemibold" VerticalOptions="Center" Margin="3,0,4,0" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- No plan -->
            <Border IsVisible="{Binding HasPlan, Converter={StaticResource Not}}" Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="No active plan" Style="{StaticResource H2}" />
                    <Label Text="Answer a few questions and Gym Book builds a personalised plan with automatic progression." Style="{StaticResource Caption}" />
                    <Button Text="Create my plan" Style="{StaticResource PrimaryButton}" Command="{Binding CreatePlanCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Start an empty workout" Style="{StaticResource SecondaryButton}" Command="{Binding StartEmptyCommand}" />

            <!-- Recovery -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Muscle recovery" Style="{StaticResource H3}" />
                    <GraphicsView Drawable="{Binding MuscleMap}" HeightRequest="260" />
                    <Grid ColumnDefinitions="*,*" Padding="30,0">
                        <Label Text="Front" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Grid.Column="1" Text="Back" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </Grid>
                    <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FF4D5E" VerticalOptions="Center" />
                            <Label Text="Fatigued" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FFB020" VerticalOptions="Center" />
                            <Label Text="Recovering" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#2ED47A" VerticalOptions="Center" />
                            <Label Text="Fresh" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <!-- Preview: drag ahead to see when muscles will be fresh. From now on only: the past is in the calendar. -->
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding RecoveryWhen}" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Now" Style="{StaticResource SmallButton}" IsVisible="{Binding IsRecoveryPreview}"
                                    Command="{Binding RecoveryNowCommand}" />
                        </Grid>
                        <Slider Maximum="96" Minimum="0" Value="{Binding RecoveryHours}"
                                MinimumTrackColor="{StaticResource Accent}" MaximumTrackColor="{StaticResource Surface3}" ThumbColor="{StaticResource Accent}" />
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="Now" Style="{StaticResource Caption}" FontSize="11" />
                            <Label Grid.Column="1" Text="In 4 days" Style="{StaticResource Caption}" FontSize="11" HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                    <Label Text="{Binding RecoverySummary}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    <Button Text="Details" Style="{StaticResource GhostButton}" Command="{Binding OpenRecoveryCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
</views:TabView>
