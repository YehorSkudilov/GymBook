<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.RecoveryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:RecoveryViewModel"
    Title="Muscle recovery"
    Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="MuscleRow" x:DataType="vm:MuscleRecoveryItem">
            <VerticalStackLayout Padding="0,10" Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Ellipse Fill="{Binding Color}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                        <Label Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="Center" />
                        <Label Text="{Binding Percent}" TextColor="{Binding Color}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
                <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding Color}" HeightRequest="6" />
                <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,4,16,28" Spacing="16">

            <!-- Map and preview -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <GraphicsView Drawable="{Binding Map}" HeightRequest="360" />
                    <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FF4D5E" VerticalOptions="Center" />
                            <Label Text="Fatigued" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#FFB020" VerticalOptions="Center" />
                            <Label Text="Recovering" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#2ED47A" VerticalOptions="Center" />
                            <Label Text="Fresh" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding When}" FontFamily="OpenSansSemibold" FontSize="14" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Now" Style="{StaticResource SmallButton}" IsVisible="{Binding IsPreview}" Command="{Binding NowCommand}" />
                        </Grid>
                        <!-- Maximum before Minimum: the minimum can only go negative once the maximum allows the range. -->
                        <Slider Maximum="96" Minimum="-168" Value="{Binding Hours}"
                                MinimumTrackColor="{StaticResource Accent}" MaximumTrackColor="{StaticResource Surface3}" ThumbColor="{StaticResource Accent}" />
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="7 days ago" Style="{StaticResource Caption}" FontSize="11" />
                            <Label Grid.Column="1" Text="In 4 days" Style="{StaticResource Caption}" FontSize="11" HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                    <Label Text="{Binding Summary}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Muscles, most tired first -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Major muscles" Style="{StaticResource H3}" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MajorMuscles}" BindableLayout.ItemTemplate="{StaticResource MuscleRow}" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="Supporting muscles" Style="{StaticResource H3}" />
                <Label Text="Smaller muscles that assist the big lifts: arms, core, traps, calves and neck." Style="{StaticResource Caption}" FontSize="12" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SupportingMuscles}" BindableLayout.ItemTemplate="{StaticResource MuscleRow}" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
