<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.NutritionGoalsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:NutritionGoalsViewModel"
    Title="Nutrition goals"
    Shell.TabBarIsVisible="False">

    <!-- Daily goals and the surplus or deficit to aim for, with goals suggested from the burn the health apps measured.
         Nothing is kept until Save. -->
    <ContentPage.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 999" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,30" Spacing="10">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding BurnText}" Style="{StaticResource Caption}" />
                    <Button Text="Suggest goals for me" Style="{StaticResource SecondaryButton}" Command="{Binding SuggestCommand}" />
                    <Label Text="{Binding SuggestionText}" Style="{StaticResource Caption}" FontSize="12" TextColor="{StaticResource Success}"
                           IsVisible="{Binding HasSuggestion}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="DAILY GOALS" Style="{StaticResource Overline}" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                <Label Text="CALORIES (KCAL)" Style="{StaticResource Overline}" />
                <Label Grid.Column="1" Text="PROTEIN (G)" Style="{StaticResource Overline}" />
                <Border Grid.Row="1" Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                    <Entry Text="{Binding CalorieGoal}" Keyboard="Numeric" Placeholder="No goal" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                    <Entry Text="{Binding ProteinGoal}" Keyboard="Numeric" Placeholder="No goal" />
                </Border>
                <Label Grid.Row="2" Text="CARBS (G)" Style="{StaticResource Overline}" Margin="0,6,0,0" />
                <Label Grid.Row="2" Grid.Column="1" Text="FAT (G)" Style="{StaticResource Overline}" Margin="0,6,0,0" />
                <Border Grid.Row="3" Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                    <Entry Text="{Binding CarbsGoal}" Keyboard="Numeric" Placeholder="No goal" />
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                    <Entry Text="{Binding FatGoal}" Keyboard="Numeric" Placeholder="No goal" />
                </Border>
            </Grid>
            <Label Text="{Binding MacroCheck}" Style="{StaticResource Caption}" FontSize="12" />

            <Label Text="DAILY SURPLUS OR DEFICIT TO AIM FOR" Style="{StaticResource Overline}" Margin="0,8,0,0" />
            <FlexLayout BindableLayout.ItemsSource="{Binding BalanceChips}" Wrap="Wrap">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChipItem">
                        <Border Style="{StaticResource Chip}" BackgroundColor="{Binding Background}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="13" FontFamily="OpenSansSemibold" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasBalanceAmount}">
                <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                    <Entry Text="{Binding BalanceAmount}" Keyboard="Numeric" Placeholder="500" />
                </Border>
                <Label Grid.Column="1" Text="kcal a day" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
            <Label Text="About 500 kcal a day is half a kilo (a pound) a week." Style="{StaticResource Caption}" FontSize="12"
                   TextColor="{StaticResource TextTertiary}" IsVisible="{Binding HasBalanceAmount}" />

            <Button Text="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,14,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
