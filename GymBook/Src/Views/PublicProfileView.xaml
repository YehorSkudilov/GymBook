<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GymBook.Views.PublicProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:PublicProfileViewModel">

    <!-- The public profile, first on the Profile tab (signed in only; ProfilePage covers signed out): the username the
         app calls the user by and others see, the picture and bio, and the friend code. -->
    <ContentView.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="ColumnDefinitions" Value="*,Auto" />
            <Setter Property="ColumnSpacing" Value="8" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="Divider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Color" Value="{StaticResource Surface2}" />
        </Style>
        <Style x:Key="Chevron" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource IconChevronRight}" />
            <Setter Property="WidthRequest" Value="16" />
            <Setter Property="HeightRequest" Value="16" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <!-- The top of the profile card: ProfilePage puts it in the card, with the account's rows under it -->
    <VerticalStackLayout>
        <ActivityIndicator IsRunning="{Binding ShowLoading}" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" Margin="0,16" IsVisible="{Binding ShowLoading}" />

        <VerticalStackLayout Spacing="10" Padding="16" IsVisible="{Binding ShowLoadFailed}">
            <Label Text="Couldn't load your profile" Style="{StaticResource H3}" />
            <Label Text="Your username and public profile live on the server, so they need a connection." Style="{StaticResource Caption}" />
            <Button Text="Try again" Style="{StaticResource SecondaryButton}" Command="{Binding RetryCommand}" />
        </VerticalStackLayout>

        <!-- The picture (tap it to change it), the username with the edit pencil and a share button (the friend code, for
             friends to add you with), and the email and bio under it -->
        <VerticalStackLayout IsVisible="{Binding ShowProfile}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="16,16,10,14">
                <Grid WidthRequest="72" HeightRequest="72" VerticalOptions="Center">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChangePictureCommand}" /></Grid.GestureRecognizers>
                    <!-- Gym Book Pro members: a ring in Pro's gradient round the picture, with a gap of the card's colour -->
                    <Ellipse Fill="{StaticResource ProGradient}" IsVisible="{Binding IsPro}" />
                    <Ellipse Fill="{StaticResource Surface}" Margin="3" IsVisible="{Binding IsPro}" />
                    <Border Margin="5" StrokeShape="RoundRectangle 31" StrokeThickness="0" Background="{StaticResource AccentGradient}">
                        <Grid>
                            <Label Text="{Binding Initial}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="26"
                                   HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasAvatar, Converter={StaticResource Not}}" />
                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" IsVisible="{Binding HasAvatar}" />
                        </Grid>
                    </Border>
                </Grid>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <!-- The username, then one pencil (a menu of what to change: username, bio, picture, email), the trophy (joining
                         or leaving the leaderboards: gold when on them, grey when not) and the share button -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                        <Label Text="{Binding Username, StringFormat='@{0}'}" Style="{StaticResource H3}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        <skeleton:CButton Grid.Column="1" Icon="edit" IconFontFamily="OutlinedIcons" IconColor="{StaticResource TextSecondary}"
                                          IconWidthRequest="18" IconHeightRequest="18" WidthRequest="34" HeightRequest="34"
                                          CButtonBackgroundColor="Transparent" CButtonStroke="Transparent" VerticalOptions="Center"
                                          SemanticProperties.Description="Edit profile" Command="{Binding EditProfileCommand}" />
                        <skeleton:CButton Grid.Column="2" Icon="emoji_events" IconFontFamily="OutlinedIcons" IconColor="{Binding RanksIconColor}"
                                          IconWidthRequest="20" IconHeightRequest="20" WidthRequest="34" HeightRequest="34"
                                          CButtonBackgroundColor="Transparent" CButtonStroke="Transparent" VerticalOptions="Center"
                                          SemanticProperties.Description="Join or leave the leaderboards" Command="{Binding ToggleRanksCommand}" />
                        <skeleton:CButton Grid.Column="3" Icon="share" IconFontFamily="OutlinedIcons" IconColor="{StaticResource TextSecondary}"
                                          IconWidthRequest="20" IconHeightRequest="20" WidthRequest="34" HeightRequest="34"
                                          CButtonBackgroundColor="Transparent" CButtonStroke="Transparent" VerticalOptions="Center"
                                          SemanticProperties.Description="Share your friend code" Command="{Binding ShareFriendCodeCommand}" />
                    </Grid>
                    <!-- The account's email (not public) and the bio -->
                    <Label Text="{Binding Email}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                    <skeleton:CLabel Text="{Binding BioText}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
