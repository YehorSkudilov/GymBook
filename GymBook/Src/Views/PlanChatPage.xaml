<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.PlanChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:PlanChatViewModel"
    Shell.PresentationMode="ModalNotAnimated"
    Shell.NavBarIsVisible="False"
    Backdrop="#B3000000">

    <!-- A sheet with a chat about the plan: messages, one-tap suggestions, and a box to type in. -->
    <Border Margin="0,28,0,0" BackgroundColor="{StaticResource Bg}" StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" Padding="20,14,8,6">
                <VerticalStackLayout VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8">
                        <Image WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="OutlinedIcons" Glyph="auto_awesome" Color="{StaticResource Accent}" Size="32" />
                            </Image.Source>
                        </Image>
                        <Label Text="AI coach" FontFamily="OpenSansSemibold" FontSize="18" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Title}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Done" Style="{StaticResource GhostButton}" FontSize="17" VerticalOptions="Center"
                        Command="{Binding CloseCommand}" />
            </Grid>

            <!-- Messages -->
            <CollectionView x:Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}" Margin="16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageItem">
                        <Grid>
                            <Border IsVisible="{Binding IsBubble}" HorizontalOptions="{Binding Alignment}" MaximumWidthRequest="320"
                                    BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="14,10">
                                <Label Text="{Binding Text}" TextColor="{Binding TextColor}" FontSize="15" LineHeight="1.25" />
                            </Border>
                            <Label IsVisible="{Binding IsNote}" Text="{Binding Text}" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   Style="{StaticResource Caption}" FontSize="13" Margin="0,2" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>

            <!-- One-tap starters -->
            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding ShowSuggestions}">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="8" Padding="16,6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SuggestionItem">
                            <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="14,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Command}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Text}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Compose -->
            <VerticalStackLayout Grid.Row="3" Padding="16,6,16,16" Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Style="{StaticResource InputBox}" Padding="12,2">
                        <Editor Text="{Binding Draft}" Placeholder="Ask for a change…" AutoSize="TextChanges" MaximumHeightRequest="120" MaxLength="2000" />
                    </Border>
                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" StrokeThickness="0"
                            BackgroundColor="{StaticResource Accent}" VerticalOptions="End" IsEnabled="{Binding CanSend}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image WidthRequest="22" HeightRequest="22" IsVisible="{Binding IsSending, Converter={StaticResource Not}}">
                                <Image.Source>
                                    <FontImageSource FontFamily="OutlinedIcons" Glyph="send" Color="White" Size="32" />
                                </Image.Source>
                            </Image>
                            <ActivityIndicator IsRunning="{Binding IsSending}" IsVisible="{Binding IsSending}" Color="White" WidthRequest="22" HeightRequest="22" />
                        </Grid>
                    </Border>
                </Grid>
                <Label Text="{Binding QuotaText}" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</views:SheetPage>
