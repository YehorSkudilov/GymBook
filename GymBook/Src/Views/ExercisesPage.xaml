<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Views.ExercisesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:Name="Root"
    x:DataType="vm:ExercisesViewModel"
    ScrollsItself="True">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Exercises" Style="{StaticResource Title}" />
            <ImageButton Grid.Column="1" Source="{StaticResource IconPlus}" WidthRequest="40" HeightRequest="40" Padding="8"
                         BackgroundColor="{StaticResource Surface2}" CornerRadius="20" Command="{Binding CreateCustomCommand}" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,14,0,10">
            <Border Style="{StaticResource InputBox}" HeightRequest="46" Padding="12,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Image Source="{StaticResource IconSearch}" WidthRequest="18" HeightRequest="18" />
                    <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Search name, muscle or equipment" ClearButtonVisibility="WhileEditing" />
                </Grid>
            </Border>
            <!-- All the filters; the badge counts the ones on beyond the chips -->
            <Grid Grid.Column="1" WidthRequest="46" HeightRequest="46">
                <ImageButton Source="{StaticResource IconFilter}" Padding="12" CornerRadius="14" BackgroundColor="{StaticResource Surface2}"
                             Command="{Binding OpenFiltersCommand}" SemanticProperties.Description="Filters" />
                <Border IsVisible="{Binding HasFilterBadge}" BackgroundColor="{StaticResource Accent}" StrokeShape="RoundRectangle 9" StrokeThickness="0"
                        HeightRequest="18" MinimumWidthRequest="18" Padding="5,0" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-4,-4,0"
                        InputTransparent="True">
                    <Label Text="{Binding FilterBadge}" FontSize="11" TextColor="White" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- The chip bar pads itself for the picker page; bleed it to the screen edges here. -->
        <views:ChipBar Grid.Row="2" Margin="-20,0" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" Margin="0,8,0,0">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <Label Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Clear filters" Style="{StaticResource GhostButton}" FontSize="13" Padding="4,0" HeightRequest="28"
                            Command="{Binding ClearFiltersCommand}" IsVisible="{Binding CanClearFilters}" />
                </Grid>
            </CollectionView.Header>
            <!-- Lets the last rows scroll clear of the nav bar and the workout pill. -->
            <CollectionView.Footer>
                <BoxView x:DataType="views:TabView" Color="Transparent" Margin="0,0,0,20"
                         HeightRequest="{Binding BottomInset, Source={x:Reference Root}}" />
            </CollectionView.Footer>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,40" Spacing="4">
                    <Label Text="No exercises found" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <Button Text="Clear filters" Style="{StaticResource GhostButton}" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding CanClearFilters}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExerciseItem">
                    <views:ExerciseRow />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:TabView>
