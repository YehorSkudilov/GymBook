<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.LevelPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:LevelViewModel"
    Shell.PresentationMode="ModalNotAnimated"
    Shell.NavBarIsVisible="False"
    Backdrop="#B3000000">

    <!-- Level and league, the leagues, famous lifts to chase, recent XP, and how XP works. -->
    <Border Margin="0,28,0,0" BackgroundColor="{StaticResource Bg}" StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0" Padding="0">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="10">
                        <Image WidthRequest="26" HeightRequest="26" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="OutlinedIcons" Glyph="workspace_premium" Color="{StaticResource Accent}" Size="32" />
                            </Image.Source>
                        </Image>
                        <Label Text="{Binding LevelText}" Style="{StaticResource H2}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="Close" Style="{StaticResource GhostButton}" Command="{Binding CloseCommand}" />
                </Grid>

                <!-- Where you are -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding LeagueText}" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Accent}" />
                            <Label Grid.Column="1" Text="{Binding XpText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar controls:SmoothProgress.Value="{Binding Progress}" HeightRequest="6" />
                        <Label Text="{Binding ProgressText}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Famous lifts: where your best estimated 1RM stands against competition bests -->
                <Label Text="FAMOUS LIFTS" Style="{StaticResource Overline}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Lifts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FamousLiftItem">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding Best}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Passed}" IsVisible="{Binding HasPassed}" TextColor="{StaticResource Success}" FontSize="13" />
                                    <Label Text="{Binding Next}" IsVisible="{Binding HasNext}" FontSize="13" />
                                    <Label Text="{Binding SourceText}" IsVisible="{Binding HasSource}" TextColor="{StaticResource Accent}" FontSize="12">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenSourceCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Competition bests only: raw powerlifting meets (OpenPowerlifting), the 1972 Olympics' press and strongman's log press. Your side is an estimate from your sets."
                       Style="{StaticResource Caption}" FontSize="12" />

                <!-- Leagues -->
                <Label Text="LEAGUES" Style="{StaticResource Overline}" />
                <Border Style="{StaticResource Card}" Padding="6">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Leagues}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LeagueItem">
                                <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" TextColor="{Binding TextColor}" FontFamily="OpenSansSemibold" FontSize="14" />
                                        <Label Grid.Column="1" Text="{Binding Levels}" TextColor="{Binding TextColor}" FontSize="13" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Recent XP -->
                <Label Text="RECENT XP" Style="{StaticResource Overline}" IsVisible="{Binding HasRecent}" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasRecent}">
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Recent}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:XpItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Date}" Style="{StaticResource Caption}" FontSize="12" WidthRequest="78" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Text}" FontSize="13" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Amount}" TextColor="{Binding AmountColor}" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- How it works -->
                <Label Text="HOW XP WORKS" Style="{StaticResource Overline}" />
                <Label Text="{Binding HowItWorks}" Style="{StaticResource Caption}" LineHeight="1.3" />
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</views:SheetPage>
