<?xml version="1.0" encoding="utf-8" ?>
<!-- The badges at the far right of each tab's title: the watch's heart rate (when there is one), tonight's bedtime (tap for
     it in full and its settings) and whether the app's online. -->
<ContentView
    x:Class="GymBook.Views.StatusBadges"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:StatusBadgesViewModel"
    VerticalOptions="Center">
    <HorizontalStackLayout Spacing="6">
        <controls:HeartRatePill />
        <Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource Surface2}" Padding="8,3" VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenBedtimeCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="4">
                <Image WidthRequest="13" HeightRequest="13" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource FontFamily="OutlinedIcons" Glyph="bedtime" Color="{Binding BedtimeColor}" Size="100" />
                    </Image.Source>
                </Image>
                <Label Text="{Binding BedtimeTime}" TextColor="{StaticResource TextSecondary}" FontSize="11"
                       FontFamily="OpenSansSemibold" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
        <controls:ConnectionPill />
    </HorizontalStackLayout>
</ContentView>
