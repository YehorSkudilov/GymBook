<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GymBook.Views.SessionCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:SessionItem">
    <Border Style="{StaticResource Card}" Padding="16,14">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" />
                <Label Text="{Binding DateText}" Style="{StaticResource Caption}" />
                <Label Text="{Binding Meta}" Style="{StaticResource Caption}" TextColor="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                <Label Text="{Binding Muscles}" Style="{StaticResource Caption}" FontSize="12" TextColor="{StaticResource TextTertiary}" />
            </VerticalStackLayout>
            <Image Grid.Column="1" Source="ic_chevron_right.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
