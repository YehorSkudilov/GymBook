<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.PlanWorkoutsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:PlanWorkoutsViewModel"
    Title="{Binding Title}"
    Shell.TabBarIsVisible="False">

    <!-- A plan's finished workouts (or those linked to none), to select and delete. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="10,8,10,10" Spacing="10">
            <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Select all" Style="{StaticResource SecondaryButton}" FontSize="14" Padding="14,6" HeightRequest="38"
                        Command="{Binding SelectAllCommand}" />
                <Button Text="Select dates" Style="{StaticResource SecondaryButton}" FontSize="14" Padding="14,6" HeightRequest="38"
                        Command="{Binding SelectDatesCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="10,0,10,16">
                <Label Text="No workouts here." Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,40"
                       IsVisible="{Binding IsEmpty}" />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}">
                    <controls:DragSelectList StartCommand="{Binding DragStartCommand}" ExtendCommand="{Binding DragToCommand}" CheckColumnWidth="56">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableWorkout">
                                    <Grid ColumnDefinitions="56,*,Auto" Padding="0,10,4,10" BackgroundColor="{Binding RowBackground}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Border WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 6" StrokeThickness="2"
                                                Stroke="{Binding CheckStroke}" BackgroundColor="{Binding CheckBackground}" Padding="2"
                                                HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image Source="{StaticResource IconCheck}" IsVisible="{Binding IsSelected}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <!-- The workout itself -->
                                        <ImageButton Grid.Column="2" Source="{StaticResource IconChevronRight}" WidthRequest="40" HeightRequest="40" Padding="10"
                                                     BackgroundColor="Transparent" VerticalOptions="Center" Command="{Binding OpenCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </controls:DragSelectList>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="{Binding DeleteText}" Style="{StaticResource PrimaryButton}" BackgroundColor="{StaticResource Danger}"
                Margin="10,8,10,16" IsVisible="{Binding HasSelection}" Command="{Binding DeleteCommand}" />
    </Grid>
</views:BasePage>
