<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:StatsViewModel">

    <!-- Each time the tab comes into view (IsShowing): the numbers count up and the charts draw themselves in. The
         cards themselves are just there, no fading in. The little icons animate while it's on screen. -->
    <ContentView.Resources>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="HeaderIcon" TargetType="controls:StatIconView">
            <Setter Property="WidthRequest" Value="26" />
            <Setter Property="HeightRequest" Value="26" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <!-- A figure in the Activity and Body cards -->
        <Style x:Key="Figure" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="17" />
        </Style>
    </ContentView.Resources>

        <VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Progress" Style="{StaticResource Title}" />
                <Button Grid.Column="1" Text="History" Style="{StaticResource SmallButton}" Command="{Binding OpenHistoryCommand}" VerticalOptions="Center" />
            </Grid>

            <!-- Day | Trends | Ranks: a full-width switch, like Nutrition's Day | Trends -->
            <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 999" StrokeThickness="0" Padding="3" HorizontalOptions="Fill">
                <FlexLayout BindableLayout.ItemsSource="{Binding SectionTabs}" Direction="Row">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipItem">
                            <Border FlexLayout.Grow="1" FlexLayout.Basis="0" BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 999" StrokeThickness="0" Padding="0,10">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" /></Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Image WidthRequest="18" HeightRequest="18" VerticalOptions="Center" IsVisible="{Binding HasIcon}">
                                        <Image.Source><FontImageSource FontFamily="OutlinedIcons" Glyph="{Binding Icon}" Color="{Binding TextColor}" Size="100" /></Image.Source>
                                    </Image>
                                    <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="15" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Border>

            <!-- Ranks: shown by this view (bound to the page), filled by the inner one (bound to the ranks) -->
            <ContentView IsVisible="{Binding IsRanksTab}">
                <views:RanksView BindingContext="{Binding Ranks}" />
            </ContentView>

            <!-- Day: one day's training, the day picked like Nutrition's (‹ ›, or tap for a calendar with a dot on each
                 day with a workout): its totals, its workouts (tap for the finished-workout sheet), the muscles worked and
                 any records set -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsDayTab}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button Text="‹" Style="{StaticResource StepButton}" Command="{Binding PreviousDayCommand}" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 999" StrokeThickness="0"
                            Padding="18,10" HorizontalOptions="Fill" Margin="24,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickDayCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding DayTitle}" Style="{StaticResource H3}" HorizontalOptions="Center" />
                            <Label Text="{Binding DaySubtitle}" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Grid.Column="2" Text="›" Style="{StaticResource StepButton}" Command="{Binding NextDayCommand}" IsEnabled="{Binding CanGoNextDay}"
                            Opacity="{Binding DayNextOpacity}" VerticalOptions="Center" />
                </Grid>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoDayWorkouts}">
                    <Label Text="{Binding DayEmptyText}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Spacing="14" IsVisible="{Binding HasDayWorkouts}">
                    <Border Style="{StaticResource Card}">
                        <FlexLayout BindableLayout.ItemsSource="{Binding DayTotals}" Wrap="Wrap" JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatItem">
                                    <VerticalStackLayout FlexLayout.Basis="33.3%" Padding="0,4">
                                        <Label Text="{Binding Value}" Style="{StaticResource Figure}" />
                                        <Label Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DaySessions}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionItem">
                                <views:SessionCard />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Muscles worked" Style="{StaticResource H3}" />
                            <GraphicsView Drawable="{Binding DayMuscleMap}" HeightRequest="200" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DayMuscles}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MuscleBarItem">
                                        <Grid ColumnDefinitions="90,*,64" ColumnSpacing="10">
                                            <Label Text="{Binding Name}" FontSize="13" VerticalOptions="Center" />
                                            <ProgressBar Grid.Column="1" Progress="{Binding Progress}" ProgressColor="{Binding Color}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasDayRecords}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Records set" Style="{StaticResource H3}" Margin="0,0,0,6" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DayRecords}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LineItem">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14" />
                                                <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Value}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Warning}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Each lift's best set against the last time (the day's strength) -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasDayLifts}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Lifts" Style="{StaticResource H3}" />
                            <Label Text="Best set and estimated one-rep max, against the last time before." Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,6" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DayLifts}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LineItem">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,6">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14" />
                                                <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Value}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Success}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- The day's work by movement -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasDaySplit}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Training split" Style="{StaticResource H3}" />
                            <Grid ColumnDefinitions="140,*" ColumnSpacing="16">
                                <GraphicsView Drawable="{Binding DaySplitChart}" HeightRequest="140" />
                                <VerticalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding DaySplit}" Spacing="10" VerticalOptions="Center">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SplitItem">
                                            <VerticalStackLayout Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Ellipse Fill="{Binding Color}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14" VerticalOptions="Center" />
                                                    <Label Grid.Column="2" Text="{Binding Percent}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="Center" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding Share}" ProgressColor="{Binding Color}" HeightRequest="4" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Recovery going into the day (right now, for today), with the night before -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DayRecoveryTitle}" Style="{StaticResource H3}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding DayRecoveryValue}" TextColor="{Binding DayRecoveryColor}" Style="{StaticResource Figure}" VerticalOptions="Center" />
                        </Grid>
                        <GraphicsView Drawable="{Binding DayRecoveryMap}" HeightRequest="220" />
                        <views:RecoveryOverviewView Overview="{Binding DayRecoveryOverview}" />
                        <views:SleepNoteView Text="{Binding DayRecoverySleep}" />
                    </VerticalStackLayout>
                </Border>

                <!-- The night woken up from on the day -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Sleep" Style="{StaticResource H3}" />
                        <Label Text="{Binding DaySleepValue}" Style="{StaticResource StatValue}" />
                        <Label Text="{Binding DaySleepCaption}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- The day's activity, from health data -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout>
                            <Label Text="Activity" Style="{StaticResource H3}" />
                            <Label Text="{Binding DayActivityCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <FlexLayout BindableLayout.ItemsSource="{Binding DayActivity}" Wrap="Wrap" JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatItem">
                                    <VerticalStackLayout FlexLayout.Basis="50%" Padding="0,4">
                                        <Label Text="{Binding Value}" Style="{StaticResource Figure}" />
                                        <Label Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- The body as last measured by the day -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout>
                            <Label Text="Body" Style="{StaticResource H3}" />
                            <Label Text="{Binding DayBodyCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <FlexLayout BindableLayout.ItemsSource="{Binding DayBody}" Wrap="Wrap" JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatItem">
                                    <VerticalStackLayout FlexLayout.Basis="33.3%" Padding="0,4">
                                        <Label Text="{Binding Value}" Style="{StaticResource Figure}" FontSize="15" />
                                        <Label Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsStatsTab}">
            <!-- The range every card below covers, picked like Nutrition's Trends: 7 days, 30, 90, a year, or one's own -->
            <FlexLayout BindableLayout.ItemsSource="{Binding RangeChips}" Direction="Row">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChipItem">
                        <Border FlexLayout.Grow="1" FlexLayout.Basis="0" Margin="3,0" BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 999" StrokeThickness="0" Padding="0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="13" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- The range's totals, with an animated icon each -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Style="{StaticResource StatTile}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label controls:CountUp.Text="{Binding TotalWorkouts}" controls:CountUp.Replay="{Binding IsShowing}" Style="{StaticResource StatValue}" />
                            <Label Text="Workouts" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <controls:StatIconView Grid.Column="1" Icon="Workouts" IsRunning="{Binding IsShowing}" WidthRequest="34" HeightRequest="34" VerticalOptions="Start" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label controls:CountUp.Text="{Binding PerWeek}" controls:CountUp.Replay="{Binding IsShowing}" Style="{StaticResource StatValue}" />
                            <Label Text="Per week" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <controls:StatIconView Grid.Column="1" Icon="Calendar" IsRunning="{Binding IsShowing}" WidthRequest="34" HeightRequest="34" VerticalOptions="Start" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource StatTile}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label controls:CountUp.Text="{Binding TotalVolume}" controls:CountUp.Replay="{Binding IsShowing}" Style="{StaticResource StatValue}" />
                            <Label Text="Volume" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <controls:StatIconView Grid.Column="1" Icon="Sets" IsRunning="{Binding IsShowing}" WidthRequest="34" HeightRequest="34" VerticalOptions="Start" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatTile}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label controls:CountUp.Text="{Binding Streak}" controls:CountUp.Replay="{Binding IsShowing}" Style="{StaticResource StatValue}" />
                            <Label Text="Week streak" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <controls:StatIconView Grid.Column="1" Icon="Streak" IsRunning="{Binding IsShowing}" WidthRequest="34" HeightRequest="34" VerticalOptions="Start" />
                    </Grid>
                </Border>
            </Grid>

            <!-- How often: every day of the range (at least four weeks of the grid) -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Calendar" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Consistency" Style="{StaticResource H3}" />
                            <Label Text="{Binding ConsistencyText}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <GraphicsView Drawable="{Binding ConsistencyChart}" HeightRequest="150" controls:ChartHeight.Fit="True" controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <!-- Strength: overall trend across the main lifts -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Trend" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Strength trend" Style="{StaticResource H3}" />
                            <Label Text="{Binding StrengthTrendText}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <GraphicsView Drawable="{Binding StrengthTrendChart}" HeightRequest="170" IsVisible="{Binding HasStrengthTrend}"
                                  controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <!-- Strength: one lift at a time -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasLifts}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Workouts" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Lift progression" Style="{StaticResource H3}" />
                            <Label Text="Estimated one-rep max each time you trained it." Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Keeps a sideways drag from the swiping tabs, so the chips scroll -->
                    <controls:HorizontalDragArea Margin="-16,0">
                        <ScrollView x:Name="LiftStrip" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding LiftChips}" Spacing="8" Padding="16,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChipItem">
                                        <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 999" StrokeThickness="0" Padding="14,7">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="13" FontFamily="OpenSansSemibold" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </controls:HorizontalDragArea>
                    <Label Text="{Binding LiftSummary}" Style="{StaticResource Caption}" FontSize="12" />
                    <GraphicsView Drawable="{Binding LiftChart}" HeightRequest="170" controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <!-- Strength: biggest gains in the range -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasGains}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Target" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Biggest gains" Style="{StaticResource H3}" />
                            <Label Text="{Binding GainsCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Gains}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LineItem">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Value}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Success}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Volume" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding VolumeTitle}" Style="{StaticResource H3}" />
                            <Label Text="Weight × reps across all working sets" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <GraphicsView Drawable="{Binding VolumeChart}" HeightRequest="170" controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Target" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <Label Grid.Column="1" Text="{Binding WorkoutsTitle}" Style="{StaticResource H3}" VerticalOptions="Center" />
                    </Grid>
                    <GraphicsView Drawable="{Binding WorkoutsChart}" HeightRequest="150" controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <!-- How long workouts take -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasDuration}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Clock" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Workout length" Style="{StaticResource H3}" />
                            <Label Text="{Binding DurationText}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <GraphicsView Drawable="{Binding DurationChart}" HeightRequest="150" controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <!-- How the work is split across the body -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasSplit}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Pie" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Training split" Style="{StaticResource H3}" />
                            <Label Text="{Binding SplitCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="16">
                        <GraphicsView Drawable="{Binding SplitChart}" HeightRequest="140" controls:ChartReveal.When="{Binding IsShowing}" />
                        <VerticalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding Split}" Spacing="10" VerticalOptions="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SplitItem">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Ellipse Fill="{Binding Color}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Percent}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="Center" />
                                        </Grid>
                                        <ProgressBar controls:SmoothProgress.Value="{Binding Share}" ProgressColor="{Binding Color}" HeightRequest="4" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Sets" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Sets per muscle a week" Style="{StaticResource H3}" />
                            <Label Text="{Binding MuscleSetsCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <GraphicsView Drawable="{Binding MuscleMap}" HeightRequest="200" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MuscleSets}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MuscleBarItem">
                                <Grid ColumnDefinitions="90,*,64" ColumnSpacing="10">
                                    <Label Text="{Binding Name}" FontSize="13" VerticalOptions="Center" />
                                    <!-- Fills in from empty -->
                                    <ProgressBar Grid.Column="1" controls:SmoothProgress.Value="{Binding Progress}" ProgressColor="{Binding Color}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <controls:StatIconView Icon="Scale" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Body weight" Style="{StaticResource H3}" />
                            <Label Text="{Binding BodyWeightChange}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Log" Style="{StaticResource SmallButton}" Command="{Binding LogWeightCommand}" VerticalOptions="Start" />
                    </Grid>
                    <Label controls:CountUp.Text="{Binding BodyWeightText}" controls:CountUp.Replay="{Binding IsShowing}" Style="{StaticResource StatValue}" />
                    <GraphicsView Drawable="{Binding BodyWeightChart}" HeightRequest="160" controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Trophy" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Personal records" Style="{StaticResource H3}" />
                            <Label Text="{Binding RecordsCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{Binding NoRecordsText}" Style="{StaticResource Caption}" IsVisible="{Binding HasRecords, Converter={StaticResource Not}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Records}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LineItem">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Value}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Warning}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Recovery going into each day of the range -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Trend" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Recovery" Style="{StaticResource H3}" />
                            <Label Text="{Binding RecoveryCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <FlexLayout BindableLayout.ItemsSource="{Binding RecoveryStats}" Wrap="Wrap" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatItem">
                                <VerticalStackLayout FlexLayout.Basis="33.3%" Padding="0,4">
                                    <Label Text="{Binding Value}" Style="{StaticResource Figure}" />
                                    <Label Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <GraphicsView Drawable="{Binding RecoveryChart}" HeightRequest="160" controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <!-- Sleep each night of the range, from health data -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Clock" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Sleep" Style="{StaticResource H3}" />
                            <Label Text="{Binding SleepCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <FlexLayout BindableLayout.ItemsSource="{Binding SleepStats}" Wrap="Wrap" JustifyContent="Start" IsVisible="{Binding HasSleep}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatItem">
                                <VerticalStackLayout FlexLayout.Basis="50%" Padding="0,4">
                                    <Label Text="{Binding Value}" Style="{StaticResource Figure}" />
                                    <Label Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <GraphicsView Drawable="{Binding SleepChart}" HeightRequest="160" IsVisible="{Binding HasSleep}" controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>

            <!-- Today's activity, from health data -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasActivity}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:StatIconView Icon="Streak" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Activity" Style="{StaticResource H3}" />
                            <Label Text="{Binding ActivityCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <FlexLayout BindableLayout.ItemsSource="{Binding Activity}" Wrap="Wrap" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatItem">
                                <VerticalStackLayout FlexLayout.Basis="50%" Padding="0,4">
                                    <Label Text="{Binding Value}" Style="{StaticResource Figure}" />
                                    <Label Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
    
            <!-- Body composition: the latest of each measurement from the health apps, N/A for the rest -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <controls:StatIconView Icon="Scale" IsRunning="{Binding IsShowing}" Style="{StaticResource HeaderIcon}" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Body" Style="{StaticResource H3}" />
                            <Label Text="{Binding BodyCaption}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                    <FlexLayout BindableLayout.ItemsSource="{Binding Body}" Wrap="Wrap" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatItem">
                                <VerticalStackLayout FlexLayout.Basis="33.3%" Padding="0,4">
                                    <Label Text="{Binding Value}" Style="{StaticResource Figure}" FontSize="15" />
                                    <Label Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Label Text="Body fat" Style="{StaticResource Overline}" Margin="0,4,0,0" IsVisible="{Binding HasBodyFatChart}" />
                    <GraphicsView Drawable="{Binding BodyFatChart}" HeightRequest="140" IsVisible="{Binding HasBodyFatChart}"
                                  controls:ChartReveal.When="{Binding IsShowing}" />
                </VerticalStackLayout>
            </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
</views:TabView>
