<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GymBook.Views.ExerciseRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:ExerciseItem">
    <VerticalStackLayout>
    <!--  Where a search's similar exercises start, after its matches  -->
    <Label
        Margin="0,14,0,4"
        IsVisible="{Binding HasSection}"
        Style="{StaticResource Overline}"
        Text="{Binding SectionTitle}" />
    <Grid
        Padding="0,6"
        BackgroundColor="Transparent"
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="12">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding TapCommand}" />
        </Grid.GestureRecognizers>
        <Border
            BackgroundColor="{Binding MuscleSoft}"
            HeightRequest="46"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="0"
            WidthRequest="46">
            <Grid>
                <!--  The initials show while the picture loads, and stay when there is none or the device is offline.  -->
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="{Binding Initial}"
                    TextColor="{Binding MuscleColor}"
                    VerticalOptions="Center" />
                <Image
                    Margin="-1"
                    Aspect="AspectFill"
                    IsVisible="{Binding HasThumbnail}"
                    Source="{Binding Thumbnail, Converter={StaticResource Thumb}}" />
            </Grid>
        </Border>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
            <Label
                FontFamily="OpenSansSemibold"
                FontSize="15"
                LineBreakMode="TailTruncation"
                Text="{Binding Name}" />
            <Label
                FontSize="12"
                Style="{StaticResource Caption}"
                Text="{Binding Subtitle}" />
        </VerticalStackLayout>
        <ContentView
            x:Name="Accessory"
            Grid.Column="2"
            VerticalOptions="Center" />
    </Grid>
    </VerticalStackLayout>
</ContentView>
