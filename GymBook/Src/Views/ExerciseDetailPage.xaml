<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.ExerciseDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:ExerciseDetailViewModel"
    Title="Exercise"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="10,8,10,32" Spacing="14">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Name}" Style="{StaticResource Title}" FontSize="26" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                <Label Text="{Binding Tags}" IsVisible="{Binding HasTags}" Style="{StaticResource Caption}" FontSize="12"
                       TextColor="{StaticResource TextTertiary}" />
            </VerticalStackLayout>

            <!-- The demonstration: the looping animation (always first, and the only one offline) or the video, trimmed
                 to just the movement -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasMedia}">
                <controls:ModeToggle IsVisible="{Binding HasMediaChoice}" IsOwn="{Binding ShowVideo}" OwnEnabled="{Binding CanShowVideo}"
                                     DefaultsText="Animation" OwnText="Video" />
                <Border Style="{StaticResource Card}" Padding="0" HeightRequest="420" BackgroundColor="#151821">
                    <Grid>
                        <Image Source="{Binding Animation}" IsVisible="{Binding ShowsAnimation}" IsAnimationPlaying="True" Aspect="AspectFit" />
                        <controls:YouTubePlayer Url="{Binding VideoUrl}" IsVisible="{Binding ShowsVideo}" LoadFailed="OnVideoLoadFailed" />
                        <Label Text="The video needs a connection." IsVisible="{Binding VideoOffline}" Style="{StaticResource Caption}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Button Text="{Binding WatchText}" Style="{StaticResource SecondaryButton}" Command="{Binding WatchVideoCommand}"
                    IsVisible="{Binding IsCustom, Converter={StaticResource Not}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <GraphicsView Drawable="{Binding MuscleMap}" HeightRequest="220" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="PRIMARY" Style="{StaticResource Overline}" FontSize="10" />
                            <Label Text="{Binding PrimaryMuscle}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Accent}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" IsVisible="{Binding HasSecondary}">
                            <Label Text="SECONDARY" Style="{StaticResource Overline}" FontSize="10" />
                            <Label Text="{Binding SecondaryMuscles}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="TYPE" Style="{StaticResource Overline}" FontSize="10" />
                            <Label Text="{Binding Mechanic}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="How to perform" Style="{StaticResource H3}" />
                    <Label Text="{Binding Instructions}" FontSize="14" LineHeight="1.35"
                           TextColor="{StaticResource TextSecondary}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LineItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" StrokeThickness="0"
                                            BackgroundColor="{StaticResource AccentSoft}" VerticalOptions="Start">
                                        <Label Text="{Binding Title}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource Accent}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Detail}" FontSize="14" LineHeight="1.3"
                                           TextColor="{StaticResource TextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Form cues and the common mistakes -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasFormTips}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Form tips" Style="{StaticResource H3}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FormTips}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Ellipse Fill="{StaticResource Accent}" WidthRequest="6" HeightRequest="6" VerticalOptions="Start" Margin="0,7,0,0" />
                                    <Label Grid.Column="1" Text="{Binding .}" FontSize="14" LineHeight="1.3" TextColor="{StaticResource TextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- How to train it for the goal -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding GoalTitle}" Style="{StaticResource H3}" />
                        <Label Text="{Binding GoalTarget}" Style="{StaticResource Caption}" FontSize="13" />
                    </VerticalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding GoalTips}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Ellipse Fill="{StaticResource Accent}" WidthRequest="6" HeightRequest="6" VerticalOptions="Start" Margin="0,7,0,0" />
                                    <Label Grid.Column="1" Text="{Binding .}" FontSize="14" LineHeight="1.3" TextColor="{StaticResource TextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Border IsVisible="{Binding HasStartingWeight}" BackgroundColor="{StaticResource AccentSoft}" StrokeShape="RoundRectangle 10" Padding="10,8">
                        <Label Text="{Binding StartingWeight}" FontSize="13" TextColor="#BFD2FF" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="{Binding BestE1Rm}" Style="{StaticResource StatValue}" FontSize="17" />
                        <Label Text="Est. 1RM" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="{Binding BestSet}" Style="{StaticResource StatValue}" FontSize="17" />
                        <Label Text="Best set" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="{Binding TimesPerformed}" Style="{StaticResource StatValue}" FontSize="17" />
                        <Label Text="Sessions" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasHistory}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Estimated 1RM" Style="{StaticResource H3}" />
                    <GraphicsView Drawable="{Binding Chart}" HeightRequest="180" />
                </VerticalStackLayout>
            </Border>

            <Label Text="History" Style="{StaticResource H3}" IsVisible="{Binding HasHistory}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LineItem">
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14" />
                                    <Label Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Caption}" FontSize="12" />
                                </Grid>
                                <Label Text="{Binding Detail}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Log this exercise in a workout to see your progress here." Style="{StaticResource Caption}"
                   HorizontalTextAlignment="Center" IsVisible="{Binding HasHistory, Converter={StaticResource Not}}" />

            <Button Text="Delete custom exercise" Style="{StaticResource DangerButton}" IsVisible="{Binding IsCustom}" Command="{Binding DeleteCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
