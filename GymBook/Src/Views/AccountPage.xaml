<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:AccountViewModel"
    Shell.NavBarIsVisible="False"
    Backdrop="#B3000000">

    <!-- A sheet over whatever is showing, like the other sheets -->
    <Border Margin="0,28,0,0" BackgroundColor="{StaticResource Bg}" StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0" Padding="0">
    <Grid RowDefinitions="Auto,*" Padding="20,16,20,20">
        <Button Text="✕" FontSize="18" Style="{StaticResource StepButton}" WidthRequest="40" HeightRequest="40"
                BackgroundColor="{StaticResource Surface2}" HorizontalOptions="Start" Command="{Binding CloseCommand}" />

        <ScrollView Grid.Row="1" Margin="0,20,0,0">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding Title}" Style="{StaticResource Title}" FontSize="28" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="15" />

                <!-- Google first: one tap, nothing to type or remember -->
                <VerticalStackLayout Spacing="12" Margin="0,14,0,0" IsVisible="{Binding ShowGoogle}">
                    <Button Text="Continue with Google" Style="{StaticResource SecondaryButton}" HeightRequest="52"
                            Command="{Binding GoogleCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                        <BoxView HeightRequest="1" Color="{StaticResource Stroke}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="or" Style="{StaticResource Caption}" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource Stroke}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <Label Text="EMAIL" Style="{StaticResource Overline}" Margin="0,8,0,0" />
                <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                    <Entry x:Name="EmailEntry" Text="{Binding Email}" Placeholder="you@example.com" Keyboard="Email" MaxLength="256"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Next" Completed="OnEmailCompleted" />
                </Border>

                <!-- Reset: the emailed code -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowCode}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="CODE" Style="{StaticResource Overline}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Resend code" Style="{StaticResource GhostButton}" FontSize="13" Padding="4,0" HeightRequest="28"
                                Command="{Binding ResendCodeCommand}" />
                    </Grid>
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <Entry x:Name="CodeEntry" Text="{Binding Code}" Placeholder="123456" Keyboard="Numeric" MaxLength="16"
                               ReturnType="Next" Completed="OnCodeCompleted" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowPassword}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="{Binding PasswordLabel}" Style="{StaticResource Overline}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Forgot password?" Style="{StaticResource GhostButton}" FontSize="13" Padding="4,0" HeightRequest="28"
                                Command="{Binding ForgotPasswordCommand}" IsVisible="{Binding IsSignIn}" />
                    </Grid>
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <skeleton:CPasswordEntry x:Name="PasswordEntry" Text="{Binding Password}" Completed="OnPasswordCompleted" ReturnType="{Binding PasswordReturnType}"
                                                 TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextTertiary}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Register and reset: typed twice, since a typo would lock the user out -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowConfirm}">
                    <Label Text="CONFIRM PASSWORD" Style="{StaticResource Overline}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <skeleton:CPasswordEntry x:Name="ConfirmEntry" Text="{Binding ConfirmPassword}" Completed="OnConfirmCompleted" ReturnType="Go"
                                                 TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextTertiary}" />
                    </Border>
                    <Label Text="{Binding PasswordHint}" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>

                <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="14" Margin="0,4,0,0" />

                <Grid Margin="0,8,0,0">
                    <Button Text="{Binding SubmitText}" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" HeightRequest="24" />
                </Grid>
                <Button Text="{Binding ToggleText}" Style="{StaticResource GhostButton}" Command="{Binding ToggleCommand}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
    </Border>
</views:SheetPage>
