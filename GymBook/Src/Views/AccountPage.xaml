<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:AccountViewModel"
    Shell.NavBarIsVisible="False"
    Backdrop="#B3000000">

    <!-- A sheet over whatever is showing, like the other sheets; on a desktop window the card fills the window (AccountCard). -->
    <Border Margin="{OnIdiom Default='0,28,0,0', Desktop=0}" Padding="{OnIdiom Default='10,16,10,20', Desktop=0}"
            BackgroundColor="{OnIdiom Default={StaticResource Bg}, Desktop=Transparent}" StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0">
        <views:AccountCard />
    </Border>
</views:SheetPage>
