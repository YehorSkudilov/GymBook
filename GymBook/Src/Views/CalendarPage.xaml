<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:CalendarViewModel"
    Title="Calendar"
    Shell.TabBarIsVisible="False">

    <!-- The title, with Today at the far end of the bar: back to this month, with today selected. -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,10,0">
            <Label Text="Calendar" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" FontSize="20"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Button Grid.Column="1" Text="Today" Style="{StaticResource SmallButton}" TextColor="{StaticResource Accent}"
                    VerticalOptions="Center" Command="{Binding GoToTodayCommand}" />
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="10,8,10,32" Spacing="16">

            <!-- Month -->
            <Border Style="{StaticResource Card}" Padding="12,14">
                <Border.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Right" Command="{Binding PreviousMonthCommand}" />
                    <SwipeGestureRecognizer Direction="Left" Command="{Binding NextMonthCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <ImageButton Source="{StaticResource IconChevronRight}" Rotation="180" WidthRequest="36" HeightRequest="36" Padding="9"
                                     BackgroundColor="{StaticResource Surface2}" CornerRadius="18"
                                     Command="{Binding PreviousMonthCommand}" />
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                            <!-- The month: tap to pick a year, then a month of it -->
                            <Label Text="{Binding MonthTitle, StringFormat='{0} ▾'}" Style="{StaticResource H3}" HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickMonthCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding MonthSummary}" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <ImageButton Grid.Column="2" Source="{StaticResource IconChevronRight}" WidthRequest="36" HeightRequest="36" Padding="9"
                                     BackgroundColor="{StaticResource Surface2}" CornerRadius="18"
                                     Command="{Binding NextMonthCommand}" IsVisible="{Binding CanGoNext}" />
                    </Grid>

                    <FlexLayout BindableLayout.ItemsSource="{Binding WeekdayLetters}" Wrap="NoWrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label FlexLayout.Basis="14.2857%" Text="{Binding .}" Style="{StaticResource Caption}" FontSize="12"
                                       HorizontalTextAlignment="Center" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <FlexLayout BindableLayout.ItemsSource="{Binding Days}" Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarDayItem">
                                <Grid FlexLayout.Basis="14.2857%" HeightRequest="48">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </Grid.GestureRecognizers>
                                    <!-- A week that reached the target: one band across its row in a see-through version of the workout days' blue, rounded at both ends. -->
                                    <Border IsVisible="{Binding ShowBandStart}" HeightRequest="42" Margin="2,0,0,0" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 21,0,21,0" BackgroundColor="#593F7DFF" VerticalOptions="Center" />
                                    <BoxView IsVisible="{Binding ShowBandMiddle}" HeightRequest="42" Color="#593F7DFF" VerticalOptions="Center" />
                                    <Border IsVisible="{Binding ShowBandEnd}" HeightRequest="42" Margin="0,0,2,0" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 0,21,0,21" BackgroundColor="#593F7DFF" VerticalOptions="Center" />
                                    <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19"
                                            BackgroundColor="{Binding Background}" Stroke="{Binding Border}" StrokeThickness="1.5"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Text}" TextColor="{Binding DayColor}" FontFamily="OpenSansSemibold" FontSize="14"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border IsVisible="{Binding ShowMulti}" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{StaticResource Accent2}" StrokeThickness="0"
                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0">
                                        <Label Text="{Binding Count}" TextColor="White" FontSize="10" FontFamily="OpenSansSemibold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Month stats -->
            <!-- Three equal columns across the card, each stat centred under an animated icon (like the Workout tab's week stats). -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid ColumnDefinitions="*,*,*" HorizontalOptions="Fill">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <controls:StatIconView Icon="Workouts" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" />
                        <Label Text="{Binding AvgPerWeek}" Style="{StaticResource StatValue}" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Avg per week" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <controls:StatIconView Icon="Target" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" />
                        <Label Text="{Binding WeeklyTarget}" Style="{StaticResource StatValue}" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Weekly target" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                        <controls:StatIconView Icon="Volume" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" />
                        <Label Text="{Binding Streak}" Style="{StaticResource StatValue}" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Streak" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Selected day -->
            <VerticalStackLayout IsVisible="{Binding HasSelection}" Spacing="10">
                <!-- The date, with the day's ··· at the far end: discard all its workouts, or the recovery details -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding SelectedTitle}" Style="{StaticResource H3}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="1" Source="{StaticResource IconMore}" WidthRequest="36" HeightRequest="30" Padding="6,3"
                                 BackgroundColor="{StaticResource Surface2}" CornerRadius="15" VerticalOptions="Center"
                                 Command="{Binding DayOptionsCommand}" />
                </Grid>
                <!-- Finished workouts, like the plan days on the Workout tab; tap one for what was done and its stats. -->
                <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding SelectedIsEmpty, Converter={StaticResource Not}}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedSessions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,10" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" StrokeThickness="1.5"
                                            Stroke="{StaticResource Success}" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Label Text="✓" TextColor="{StaticResource Success}" FontFamily="OpenSansSemibold" FontSize="13"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="17" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding PlanText}" TextColor="{Binding PlanColor}" FontSize="12" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" IsVisible="{Binding HasThumbnails}" BackgroundColor="{StaticResource Surface2}"
                                            StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="4" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="3">
                                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Thumbnails}" Spacing="3">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 9" StrokeThickness="0"
                                                                BackgroundColor="{StaticResource Surface3}">
                                                            <Image Source="{Binding ., Converter={StaticResource Thumb}}" Aspect="AspectFill" Margin="-1" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding More}" IsVisible="{Binding HasMore}" Style="{StaticResource Caption}"
                                                   FontFamily="OpenSansSemibold" VerticalOptions="Center" Margin="3,0,4,0" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label IsVisible="{Binding SelectedIsEmpty}" Text="No workout on this day." Style="{StaticResource Caption}" />

                <!-- How recovered each muscle was going into the day -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding RecoveryTitle}" Style="{StaticResource H3}" />
                        <GraphicsView Drawable="{Binding RecoveryMap}" HeightRequest="220" />
                        <Label Text="{Binding RecoverySummary}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                        <!-- Before this day | After this day: two halves of one toggle -->
                        <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="3">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                <Border BackgroundColor="{Binding BeforeBackground}" StrokeShape="RoundRectangle 9" StrokeThickness="0" Padding="0,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BeforeDayCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Before this day" TextColor="{Binding BeforeText}" FontFamily="OpenSansSemibold" FontSize="13"
                                           HorizontalOptions="Center" />
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{Binding AfterBackground}" StrokeShape="RoundRectangle 9" StrokeThickness="0" Padding="0,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AfterDayCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="After this day" TextColor="{Binding AfterText}" FontFamily="OpenSansSemibold" FontSize="13"
                                           HorizontalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Every muscle at that moment, most tired first, as on the recovery details page -->
                <views:RecoveryMusclesView Major="{Binding MajorMuscles}" Supporting="{Binding SupportingMuscles}" />
            </VerticalStackLayout>

            <Label IsVisible="{Binding HasSelection, Converter={StaticResource Not}}" Text="Tap a day to see its workouts."
                   Style="{StaticResource Caption}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
