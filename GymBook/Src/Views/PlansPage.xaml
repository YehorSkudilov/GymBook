<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Views.PlansPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:PlansViewModel">

        <VerticalStackLayout Spacing="16">
            <Label Text="Plans" Style="{StaticResource Title}" />

            <Label Text="ACTIVE PLAN" Style="{StaticResource Overline}" IsVisible="{Binding HasActivePlan}" />
            <!-- The active plan: light drifting across it, this week's progress in a ring, and a chevron to open it.
                 No padding on the card itself so the light reaches its edges; the content has it instead. -->
            <Border IsVisible="{Binding HasActivePlan}" Background="{StaticResource AccentGradient}" Style="{StaticResource Card}" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ActivePlan.OpenCommand}" />
                </Border.GestureRecognizers>
                <Grid>
                <controls:ReadinessGlowView Shape="Card" Readiness="0.8" Tint="White" IsRunning="{Binding IsShowing}" />
                <VerticalStackLayout Spacing="4" Padding="18">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ActivePlan.Name}" FontFamily="OpenSansSemibold" FontSize="20" TextColor="White" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding ActivePlan.Description}" FontSize="13" TextColor="#DDE6FF" />
                        </VerticalStackLayout>
                        <!-- This week so far -->
                        <controls:ReadinessRingView Grid.Column="1" Readiness="{Binding ActivePlan.WeekProgress}" Tint="White" IsRunning="{Binding IsShowing}"
                                                    WidthRequest="50" HeightRequest="50" VerticalOptions="Center" />
                        <Image Grid.Column="2" Source="{StaticResource IconChevronRight}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding ActivePlan.WeekText}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="White" Margin="0,8,0,0" />
                    <Label Text="{Binding ActivePlan.Meta}" FontSize="12" TextColor="#DDE6FF" />
                    <!-- The weekly AI check found ways to improve it: open the plan to review them. -->
                    <Border IsVisible="{Binding ActivePlan.HasSuggestions}" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 12"
                            StrokeThickness="0" Padding="10,4" HorizontalOptions="Start" Margin="0,10,0,0">
                        <HorizontalStackLayout Spacing="6">
                            <Image WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="OutlinedIcons" Glyph="auto_awesome" Color="White" Size="28" />
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding ActivePlan.SuggestionsText}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="OTHER PLANS" Style="{StaticResource Overline}" IsVisible="{Binding HasOtherPlans}" />
            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Build a new plan" Style="{StaticResource H3}" />
                    <Label Text="Let GymBook generate a plan for your goal, schedule and equipment, start from scratch, or import one you already have." Style="{StaticResource Caption}" />
                    <!-- AI plans left for signed-in users -->
                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasAiQuota}">
                        <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="OutlinedIcons" Glyph="auto_awesome" Color="{StaticResource Accent}" Size="32" />
                            </Image.Source>
                        </Image>
                        <Label Text="{Binding AiQuotaText}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Text="Generate plan" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" />
                    <Button Text="Create empty plan" Style="{StaticResource SecondaryButton}" Command="{Binding CreateEmptyCommand}" />
                    <Button Text="Import plan" Style="{StaticResource SecondaryButton}" Command="{Binding ImportCommand}" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OtherPlans}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanItem">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding Description}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="12" TextColor="{StaticResource TextTertiary}" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="{StaticResource IconChevronRight}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
</views:TabView>
