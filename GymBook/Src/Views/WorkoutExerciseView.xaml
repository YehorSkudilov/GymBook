<?xml version="1.0" encoding="utf-8" ?>
<!-- One exercise of the workout on screen, bound to its WorkoutExerciseViewModel: the workout page's exercise pager (a
     CView) holds one of these per exercise and swipes between them, like the app's tabs. Each scrolls on its own. -->
<skeleton:PageBase
    x:Class="GymBook.Views.WorkoutExerciseView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:WorkoutExerciseViewModel"
    Padding="0">

    <!-- A background, so the exercise sliding in covers the one going out -->
    <ScrollView BackgroundColor="{StaticResource Bg}">
        <VerticalStackLayout Padding="10,14,10,110" Spacing="14">

            <!-- Exercise -->
            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="28" FontAttributes="Bold"
                           TextColor="{StaticResource Accent}" VerticalOptions="Center" MaximumWidthRequest="280" />
                    <ImageButton Source="{StaticResource IconMore}" WidthRequest="44" HeightRequest="34" Padding="10,5" VerticalOptions="Center"
                                 BackgroundColor="{StaticResource Surface2}" CornerRadius="17" Command="{Binding MenuCommand}" />
                </HorizontalStackLayout>
                <Label Text="{Binding TargetText}" Style="{StaticResource Caption}" FontSize="15" />
            </VerticalStackLayout>

            <Label IsVisible="{Binding HasRecommendation}" Text="{Binding Recommendation}" FontSize="14" TextColor="#BFD2FF" />
            <!-- How to do the exercise for the goal. -->
            <Label IsVisible="{Binding HasTip}" Text="{Binding Tip}" Style="{StaticResource Caption}" FontSize="13" />
            <!-- After a set outside the rep range. -->
            <Border IsVisible="{Binding HasLiveAdvice}" BackgroundColor="{StaticResource WarningSoft}" StrokeShape="RoundRectangle 10" Padding="10,8">
                <Label Text="{Binding LiveAdvice}" FontSize="13" TextColor="{StaticResource Warning}" />
            </Border>

            <!-- A note on the exercise in this workout: the seat height, how it felt… The pin offers it for the plan when the
                 workout's finished (Update plan), so the next workouts of this day start with it; the line under it says so. -->
            <VerticalStackLayout Spacing="4">
            <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="12,2,4,2">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <Editor Text="{Binding Note}" Placeholder="Add a note" AutoSize="TextChanges" FontSize="15"
                            TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextTertiary}" BackgroundColor="Transparent" />
                    <ImageButton Grid.Column="1" WidthRequest="40" HeightRequest="40" Padding="9" BackgroundColor="Transparent" VerticalOptions="Start"
                                 IsVisible="{Binding CanPin}" Command="{Binding TogglePinCommand}">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="OutlinedIcons" Glyph="push_pin" Color="{Binding PinColor}" Size="22" />
                        </ImageButton.Source>
                    </ImageButton>
                </Grid>
            </Border>
            <Label Text="{Binding PinStatus}" IsVisible="{Binding HasPinStatus}" Style="{StaticResource Caption}" FontSize="12" Margin="4,0" />
            </VerticalStackLayout>

            <!-- Warm-ups fold away behind this; the ones left can be skipped all at once (they stay, marked skipped), and brought back. -->
            <HorizontalStackLayout IsVisible="{Binding HasWarmups}" Spacing="8">
                <Border Style="{StaticResource Pill}" Padding="16,9" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleWarmupsCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding WarmupText}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource TextSecondary}" />
                </Border>
                <Button Text="{Binding SkipWarmupsText}" Style="{StaticResource GhostButton}" VerticalOptions="Center"
                        IsVisible="{Binding HasUndoneWarmups}" Command="{Binding SkipWarmupsCommand}" />
            </HorizontalStackLayout>

            <!-- Set table -->
            <VerticalStackLayout Spacing="4">
                <!-- Tap a heading for that column across the sets still to do: skip or delete them all (#), or give them
                     all one weight, rep count or RIR. The ▾ says there's a menu. -->
                <Grid ColumnDefinitions="48,*,*,Auto,*,56" ColumnSpacing="8" Padding="0,0,0,4">
                    <Label Text="# ▾" Style="{StaticResource Overline}" FontSize="13" HorizontalOptions="Fill" HorizontalTextAlignment="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetsHeaderCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding UnitLabel, StringFormat='{0} ▾'}" Style="{StaticResource Overline}" FontSize="13"
                           HorizontalOptions="Fill" HorizontalTextAlignment="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding WeightHeaderCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="2" Text="REPS ▾" Style="{StaticResource Overline}" FontSize="13" HorizontalOptions="Fill" HorizontalTextAlignment="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RepsHeaderCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="3" Text="RIR ▾" WidthRequest="52" HorizontalTextAlignment="Center" IsVisible="{Binding TrackRir}"
                           Style="{StaticResource Overline}" FontSize="13" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RirHeaderCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="4" Text="E1RM ▾" Style="{StaticResource Overline}" FontSize="13" HorizontalOptions="Fill" HorizontalTextAlignment="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding E1RmHeaderCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetRowViewModel">
                            <!-- Warm-up rows fold away and open with an animation -->
                            <Grid controls:AnimatedVisibility.IsShown="{Binding IsVisible}" ColumnDefinitions="48,*,*,Auto,*,56" ColumnSpacing="8" MinimumHeightRequest="52"
                                  Opacity="{Binding RowOpacity}" controls:Pop.When="{Binding IsCompleted}" controls:Pop.Amount="1.03">
                                <!-- Tapping a row that isn't being logged opens it for editing. -->
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditCommand}" />
                                </Grid.GestureRecognizers>

                                <!-- Set number; tap for delete / warm-up -->
                                <Border BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 14" HeightRequest="46" StrokeThickness="0"
                                        Opacity="{Binding NumberOpacity}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding MenuCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}" TextColor="{Binding LabelColor}" FontFamily="OpenSansSemibold" FontSize="18"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <!-- The current set: edited in place -->
                                <Border Grid.Column="1" Style="{StaticResource InputBox}" HeightRequest="46" StrokeShape="RoundRectangle 14" IsVisible="{Binding IsCurrent}">
                                    <Entry Text="{Binding WeightText}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontFamily="OpenSansSemibold" FontSize="20" Placeholder="0" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource InputBox}" HeightRequest="46" StrokeShape="RoundRectangle 14" IsVisible="{Binding IsCurrent}">
                                    <Entry Text="{Binding RepsText}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontFamily="OpenSansSemibold" FontSize="20" Placeholder="0" />
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource InputBox}" HeightRequest="46" WidthRequest="52" StrokeShape="RoundRectangle 14" IsVisible="{Binding ShowRirInput}">
                                    <Entry Text="{Binding RirText}" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="18" Placeholder="–" />
                                </Border>

                                <!-- Every other set: plain values -->
                                <Label Grid.Column="1" Text="{Binding WeightDisplay}" TextColor="{Binding ValueColor}" FontSize="20" FontFamily="OpenSansSemibold"
                                       HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsNotCurrent}" />
                                <Label Grid.Column="2" Text="{Binding RepsDisplay}" TextColor="{Binding ValueColor}" FontSize="20" FontFamily="OpenSansSemibold"
                                       HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsNotCurrent}" />
                                <Label Grid.Column="3" Text="{Binding RirDisplay}" TextColor="{Binding ValueColor}" FontSize="18" WidthRequest="52"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding ShowRirValue}" />

                                <Label Grid.Column="4" Text="{Binding E1Rm}" TextColor="{StaticResource TextSecondary}" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding ShowE1Rm}" />

                                <!-- Check: big on the current set, a small tick on finished ones -->
                                <Border Grid.Column="5" BackgroundColor="{Binding CheckBackground}" StrokeShape="RoundRectangle 14" HeightRequest="46"
                                        StrokeThickness="0" IsVisible="{Binding IsCurrent}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{Binding CheckIcon}" WidthRequest="24" HeightRequest="24" />
                                </Border>
                                <Image Grid.Column="5" Source="{StaticResource IconCheck}" WidthRequest="18" HeightRequest="18" Opacity="0.8" IsVisible="{Binding ShowDoneTick}"
                                       controls:Pop.When="{Binding IsCompleted}" controls:Pop.Amount="1.6" />
                                <Label Grid.Column="4" Text="N/A" TextColor="{StaticResource TextSecondary}" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding ShowSkipped}" />
                                <!-- Skipped, where its tick would be: left out when the workout is finished; tap the row and its check to do it after all -->
                                <Label Grid.Column="5" Text="Skipped" TextColor="{StaticResource TextSecondary}" FontSize="12" FontFamily="OpenSansSemibold"
                                       HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding ShowSkipped}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Like "+ Add exercise". Skipping an exercise or a set is in their ··· / number menus. -->
                <Button Text="+ Add set" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Accent}" Margin="0,6,0,0"
                        Command="{Binding AddSetCommand}" />
            </VerticalStackLayout>

            <!-- Last time -->
            <Border IsVisible="{Binding HasPrevious}" Style="{StaticResource InnerCard}" StrokeShape="RoundRectangle 20" Padding="18,14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding PreviousTitle}" Style="{StaticResource Caption}" FontSize="15" FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="0.6*,*,*,*">
                        <Label Text="#" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding UnitLabel}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Grid.Column="2" Text="REPS" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Grid.Column="3" Text="E1RM" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreviousRows}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlanDaySetRow">
                                <Grid ColumnDefinitions="0.6*,*,*,*" Opacity="{Binding RowOpacity}">
                                    <Label Text="{Binding Number}" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding First}" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Second}" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Third}" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Help" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" FontSize="18">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding HelpCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</skeleton:PageBase>
