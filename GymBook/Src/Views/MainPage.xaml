<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GymBook.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    xmlns:views="clr-namespace:GymBook.Views"
    Shell.NavBarIsVisible="False">

    <!--  The glass look (GlassTint, GlassTintOpacity) is app-wide, in Resources/Styles/Colors.xaml: the tabs use it too.  -->

    <!--  The first row is the top bar's, over every tab; the last two are the nav bar's (less its margins): 34 + 34 makes it 54 tall.  -->
    <Grid RowDefinitions="Auto,*,34,34">
        <!--  Badges over every tab: the watch's heart rate, tonight's bedtime, online or not.  -->
        <views:TopBarView x:Name="TopBar" />
        <!--  Each tab scrolls and pads itself (see TabView), so tabs keep their own scroll positions.  -->
        <skeleton:CView
            x:Name="TabContent"
            Grid.Row="1"
            Grid.RowSpan="2"
            SwipeNavigationCommand="{Binding Source={x:Reference NavBar}, Path=SelectPageCommand}" />
        <!--  Workout in progress: floats above the nav bar on every tab; tap to resume.  -->
        <skeleton:AcrylicView
            x:Name="ActiveBar"
            Grid.Row="1"
            Margin="0,0,0,10"
            BorderColor="Transparent"
            CornerRadius="17"
            EffectStyle="Custom"
            HorizontalOptions="Center"
            IsVisible="False"
            TintColor="{StaticResource GlassTint}"
            TintOpacity="{StaticResource GlassTintOpacity}"
            VerticalOptions="End">
            <HorizontalStackLayout
                Padding="14,8"
                BackgroundColor="Transparent"
                Spacing="8">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnActiveBarTapped" />
                </HorizontalStackLayout.GestureRecognizers>
                <BoxView
                    x:Name="ActiveDot"
                    CornerRadius="4"
                    HeightRequest="8"
                    VerticalOptions="Center"
                    WidthRequest="8"
                    Color="{StaticResource Success}" />
                <Label
                    x:Name="ActiveName"
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    LineBreakMode="TailTruncation"
                    MaximumWidthRequest="180"
                    TextColor="{StaticResource TextPrimary}"
                    VerticalOptions="Center" />
                <Label
                    x:Name="ActiveTime"
                    FontSize="13"
                    TextColor="{StaticResource TextSecondary}"
                    VerticalOptions="Center" />
                <Image
                    HeightRequest="14"
                    Source="{StaticResource IconChevronRight}"
                    VerticalOptions="Center"
                    WidthRequest="14" />
            </HorizontalStackLayout>
        </skeleton:AcrylicView>

        <skeleton:CNavBar
            x:Name="NavBar"
            Grid.Row="2"
            Grid.RowSpan="2"
            Margin="10,4,10,10"
            BorderColor="Transparent"
            FontFamily="OutlinedIcons"
            IsNavigating="{Binding Source={x:Reference TabContent}, Path=IsNavigating}"
            LabelColor="{StaticResource TextSecondary}"
            SelectedFontFamily="RegularIcons"
            TintColor="{StaticResource GlassTint}"
            TintOpacity="{StaticResource GlassTintOpacity}" />
    </Grid>
</ContentPage>
