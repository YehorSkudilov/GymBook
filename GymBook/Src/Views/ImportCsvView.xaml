<?xml version="1.0" encoding="utf-8" ?>
<!--
    One CSV tab of the import sheet (plans, or workout history): pick the export, see what's in it and what each exercise
    becomes in the app, and change any of those before importing (the button is ImportCsvButton, at the sheet's bottom).
-->
<ContentView
    x:Class="GymBook.Views.ImportCsvView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="vm:ImportCsvViewModel">

    <VerticalStackLayout Spacing="14">
        <Label Text="{Binding Explanation}" Style="{StaticResource Caption}" FontSize="15" />

        <Button Text="Choose the CSV file" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Accent}"
                Command="{Binding PickFileCommand}" IsVisible="{Binding HasFile, Converter={StaticResource Not}}" />

        <!-- The file picked, and what's in it -->
        <Border IsVisible="{Binding HasFile}" Style="{StaticResource Card}" Padding="14,10">
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Image WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="OutlinedIcons" Glyph="table_view" Color="{StaticResource TextSecondary}" Size="32" />
                        </Image.Source>
                    </Image>
                    <Label Grid.Column="1" Text="{Binding FileName}" FontFamily="OpenSansSemibold" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
                    <ImageButton Grid.Column="2" Source="{StaticResource IconClose}" WidthRequest="36" HeightRequest="36" Padding="8"
                                 BackgroundColor="Transparent" Command="{Binding RemoveFileCommand}" />
                </Grid>
                <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </Border>

        <skeleton:CLabel Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" FontSize="14" />

        <!-- What each exercise becomes: tap one to change it -->
        <VerticalStackLayout IsVisible="{Binding HasFile}" Spacing="8">
            <Label Text="EXERCISES" Style="{StaticResource Overline}" />
            <Label Text="{Binding MappingSummary}" Style="{StaticResource Caption}" FontSize="13" />
            <Border Style="{StaticResource Card}" Padding="0,4">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Mappings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MappingItem">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="14,9" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding Source}" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Target, StringFormat='→ {0}'}" Style="{StaticResource Caption}" FontSize="13" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontFamily="OpenSansSemibold" FontSize="12" HorizontalOptions="End" />
                                    <Label Text="{Binding Uses}" Style="{StaticResource Caption}" FontSize="11" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
