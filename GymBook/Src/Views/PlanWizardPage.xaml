<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Views.PlanWizardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    x:DataType="vm:PlanWizardViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="10,16,10,20">

        <!-- Top bar -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Button Text="‹" FontSize="24" Style="{StaticResource StepButton}" WidthRequest="40" HeightRequest="40"
                    BackgroundColor="{StaticResource Surface2}" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
            <ProgressBar Grid.Column="1" Progress="{Binding Progress}" VerticalOptions="Center" HeightRequest="6" />
            <!-- Leave the wizard from any step (not during first-run onboarding), stopping anything the AI is working on -->
            <ImageButton Grid.Column="2" Source="{StaticResource IconClose}" WidthRequest="40" HeightRequest="40" Padding="9"
                         BackgroundColor="{StaticResource Surface2}" CornerRadius="20" Command="{Binding CancelCommand}"
                         IsVisible="{Binding IsOnboarding, Converter={StaticResource Not}}" />
        </Grid>

        <ScrollView Grid.Row="1" Margin="0,20,0,12">
            <VerticalStackLayout Spacing="14">

                <!-- Welcome art -->
                <VerticalStackLayout IsVisible="{Binding IsWelcome}" Spacing="0" Margin="0,30,0,10">
                    <Image Source="logo.png" HeightRequest="140" />
                </VerticalStackLayout>

                <Label Text="{Binding Title}" Style="{StaticResource Title}" FontSize="28" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="15" />

                <!-- Welcome feature list -->
                <VerticalStackLayout IsVisible="{Binding IsWelcome}" Spacing="12" Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Personalised plans" Style="{StaticResource H3}" />
                            <Label Text="Splits, exercises, sets and reps chosen for your goal and schedule." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Automatic progression" Style="{StaticResource H3}" />
                            <Label Text="Every session suggests the right weight and reps from your last performance." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Recovery and progress" Style="{StaticResource H3}" />
                            <Label Text="See which muscles are fresh, track personal records, volume and body weight." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- About you -->
                <VerticalStackLayout IsVisible="{Binding IsAbout}" Spacing="10" Margin="0,10,0,0">
                    <Label Text="NAME" Style="{StaticResource Overline}" />
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <Entry Text="{Binding UserName}" Placeholder="Your first name" />
                    </Border>
                    <Label Text="WEIGHT UNIT" Style="{StaticResource Overline}" Margin="0,8,0,0" />
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding UnitChips}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChipItem">
                                <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 12" Padding="16,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontFamily="OpenSansSemibold" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Label Text="BODY WEIGHT" Style="{StaticResource Overline}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource InputBox}" HeightRequest="52" Padding="12,0">
                        <Entry Text="{Binding BodyWeight}" Keyboard="Numeric" Placeholder="75" />
                    </Border>
                </VerticalStackLayout>

                <!-- Option lists -->
                <VerticalStackLayout IsVisible="{Binding IsOptions}" BindableLayout.ItemsSource="{Binding Options}" Spacing="10" Margin="0,6,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionItem">
                            <Border BackgroundColor="{Binding Background}" Stroke="{Binding StrokeColor}" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 16" Padding="16,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" IsVisible="{Binding HasSubtitle}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Signature programs: the best fits for the answers, ranked, or all of them -->
                <VerticalStackLayout IsVisible="{Binding IsPrograms}" Spacing="12" Margin="0,6,0,0">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ProgramTabs}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChipItem">
                                <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontFamily="OpenSansSemibold" FontSize="14" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Programs}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgramItem">
                                <Border BackgroundColor="{Binding Background}" Stroke="{Binding StrokeColor}" StrokeThickness="2"
                                        StrokeShape="RoundRectangle 16" Padding="16,14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Label Text="{Binding Rank}" IsVisible="{Binding HasRank}" FontFamily="OpenSansSemibold" FontSize="16"
                                                   TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Author}" FontSize="13" TextColor="{StaticResource Accent}" />
                                        <Label Text="{Binding Tags}" Style="{StaticResource Caption}" FontSize="12" />
                                        <Label Text="{Binding Why}" Style="{StaticResource Caption}" FontSize="12" />
                                        <!-- The details, on the picked program -->
                                        <VerticalStackLayout IsVisible="{Binding IsSelected}" Spacing="8" Margin="0,6,0,0">
                                            <Label Text="{Binding Summary}" FontSize="13" LineHeight="1.3" />
                                            <Label Text="{Binding AboutAuthor}" Style="{StaticResource Caption}" FontSize="12" LineHeight="1.3" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Based on publicly known programs. Gym Book isn't affiliated with or endorsed by the people named."
                           Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>

                <!-- While the AI thinks of questions or builds the plan -->
                <VerticalStackLayout IsVisible="{Binding IsGenerating}" Spacing="14" Margin="0,40,0,0" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsGenerating}" Color="{StaticResource Accent}" WidthRequest="44" HeightRequest="44" />
                    <Label Text="{Binding GeneratingText}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- The AI's follow-up questions: tap to answer, or leave blank -->
                <VerticalStackLayout IsVisible="{Binding ShowQuestions}" Spacing="18" Margin="0,6,0,0">
                    <!-- The questions didn't come: say why, and let them try again (Continue builds the plan without) -->
                    <Border IsVisible="{Binding HasQuestionsError}" BackgroundColor="{StaticResource DangerSoft}" StrokeShape="RoundRectangle 16"
                            StrokeThickness="0" Padding="16,12">
                        <VerticalStackLayout Spacing="8">
                            <skeleton:CLabel Text="{Binding QuestionsError}" TextColor="{StaticResource Danger}" FontSize="14" />
                            <Button Text="Try again" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Padding="0,4"
                                    Command="{Binding RetryQuestionsCommand}" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Questions}" Spacing="18">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiQuestionItem">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Text}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding Hint}" Style="{StaticResource Caption}" FontSize="12" IsVisible="{Binding HasHint}" />
                                    <FlexLayout BindableLayout.ItemsSource="{Binding Options}" Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChipItem">
                                                <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                                        Padding="14,10" Margin="0,0,8,8">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontFamily="OpenSansSemibold" FontSize="14" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Anything else the AI should know?" FontFamily="OpenSansSemibold" FontSize="16" />
                        <!-- A few rows to start with, growing as they type (HeightRequest -1 clears InputBox's fixed height) -->
                        <Border Style="{StaticResource InputBox}" Padding="12,6" MinimumHeightRequest="130" HeightRequest="-1">
                            <Editor Text="{Binding ExtraNote}" Placeholder="e.g. a bad left shoulder, training for a marathon, love deadlifts"
                                    AutoSize="TextChanges" MinimumHeightRequest="118" MaxLength="500" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Result -->
                <VerticalStackLayout IsVisible="{Binding ShowPlan}" Spacing="12" Margin="0,6,0,0">
                    <!-- Where the plan came from, and a way to get another -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasPlanNote}">
                        <Label Text="{Binding PlanNote}" Style="{StaticResource Caption}" FontSize="13" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Regenerate" Style="{StaticResource GhostButton}" VerticalOptions="Center"
                                IsVisible="{Binding CanRegenerate}" Command="{Binding RegenerateCommand}" />
                    </Grid>
                    <!-- Tell the AI what to change before saving -->
                    <Button Text="Change it with AI" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Accent}"
                            IsVisible="{Binding CanChat}" Command="{Binding ChatCommand}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="OutlinedIcons" Glyph="auto_awesome" Color="{StaticResource Accent}" Size="20" />
                        </Button.ImageSource>
                    </Button>
                    <Border Background="{StaticResource AccentGradient}" Style="{StaticResource Card}" Padding="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding PlanName}" FontFamily="OpenSansSemibold" FontSize="20" TextColor="White" />
                            <Label Text="{Binding PlanDescription}" FontSize="13" TextColor="#DDE6FF" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Who a signature program is from -->
                    <Border Style="{StaticResource Card}" Padding="16,14" IsVisible="{Binding HasProgramAuthor}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="INSPIRED BY" Style="{StaticResource Overline}" />
                            <Label Text="{Binding ProgramAuthor}" FontFamily="OpenSansSemibold" FontSize="16" />
                            <Label Text="{Binding ProgramBio}" Style="{StaticResource Caption}" FontSize="13" LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlanWorkouts}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkoutPreviewItem">
                                <Border Style="{StaticResource Card}" Padding="16,14">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" />
                                            <Label Grid.Column="1" Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="12" />
                                        </Grid>
                                        <Label Text="{Binding Exercises}" FontSize="13" LineHeight="1.35" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <Button Text="{Binding NextText}" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}"
                    IsEnabled="{Binding IsGenerating, Converter={StaticResource Not}}" />
            <Button Text="I already have an account" Style="{StaticResource GhostButton}" Command="{Binding SignInCommand}"
                    HorizontalOptions="Center" IsVisible="{Binding ShowSignIn}" />
        </VerticalStackLayout>
    </Grid>
</views:BasePage>
