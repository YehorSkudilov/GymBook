<?xml version="1.0" encoding="utf-8" ?>
<views:SheetPage
    x:Class="GymBook.Views.ExerciseFilterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    x:DataType="views:ExerciseFilterPage"
    Backdrop="#B3000000">

    <!-- A sheet over the exercise list it filters, like the other sheets -->
    <Border Margin="0,28,0,0" BackgroundColor="{StaticResource Bg}" StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0" Padding="0">
    <Grid RowDefinitions="Auto,*,Auto" Padding="0,16,0,20">
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,0" ColumnSpacing="8">
            <Button Text="Clear all" Style="{StaticResource GhostButton}" TextColor="{StaticResource TextSecondary}" Clicked="OnClear" />
            <Label Grid.Column="1" Text="Filters" Style="{StaticResource H3}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Done" Style="{StaticResource GhostButton}" Clicked="OnDone" />
        </Grid>

        <ScrollView Grid.Row="1" Margin="0,12,0,0">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="18" Padding="20,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterGroup">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding Title}" Style="{StaticResource Overline}" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding Options}" Wrap="Wrap" Direction="Row" AlignItems="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilterOption">
                                        <Border BackgroundColor="{Binding Background}" StrokeShape="RoundRectangle 999" StrokeThickness="0"
                                                Padding="14,7" Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnOptionTapped" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="13" FontFamily="OpenSansSemibold" />
                                                <Label Text="{Binding Count}" IsVisible="{Binding HasCount}" TextColor="{Binding TextColor}" Opacity="0.6" FontSize="12" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="{Binding ShowText}" Style="{StaticResource PrimaryButton}" Margin="20,12,20,0" Clicked="OnDone" />
    </Grid>
    </Border>
</views:SheetPage>
