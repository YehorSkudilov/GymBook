<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    x:DataType="vm:ProfileViewModel">

    <ContentView.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="ColumnDefinitions" Value="*,Auto,Auto" />
            <Setter Property="ColumnSpacing" Value="8" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="RowValue" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="Chevron" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource IconChevronRight}" />
            <Setter Property="WidthRequest" Value="16" />
            <Setter Property="HeightRequest" Value="16" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <!-- A part of Defaults (Rest, Training): an icon, its name and what it applies to, above its card -->
        <Style x:Key="SubsectionHeader" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="Auto,*" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="Margin" Value="4,10,0,-4" />
        </Style>
        <Style x:Key="SubsectionIcon" TargetType="Border">
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="StrokeShape" Value="RoundRectangle 11" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="SubsectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="Divider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Color" Value="{StaticResource Surface2}" />
        </Style>
    </ContentView.Resources>

        <VerticalStackLayout Spacing="14">
            <!-- The title, with the badges (bedtime, online) at its far right -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="Profile" Style="{StaticResource Title}" VerticalOptions="Center" />
                <views:StatusBadges Grid.Column="1" />
            </Grid>

            <!-- First: the public profile, with the username the app calls you by (it needs the account) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsSignedIn, Converter={StaticResource Not}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SignInCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 28" Background="{StaticResource AccentGradient}">
                        <Label Text="?" TextColor="White" FontFamily="OpenSansSemibold" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Sign in" Style="{StaticResource H3}" />
                        <Label Text="For your username, a picture and a place on the strength leaderboards" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>
            <!-- The profile, with the account under it: the password, signing out and
                 deleting the account. The email is in the profile, under the name. -->
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsSignedIn}">
                <VerticalStackLayout>
                    <views:PublicProfileView BindingContext="{Binding Public}" />
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChangePasswordCommand}" /></Grid.GestureRecognizers>
                        <Label Text="{Binding PasswordRowText}" VerticalOptions="Center" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SignOutCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Sign out" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="Syncing…" Style="{StaticResource RowValue}" IsVisible="{Binding IsSyncingToSignOut}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding DeleteAccountCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Delete account" TextColor="{StaticResource Danger}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Gym Book Pro, right under the profile. Not a member: the invitation, on Pro's gradient, with what it unlocks -->
            <Border Background="{StaticResource ProGradient}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="16,14,16,12"
                    IsVisible="{Binding ShowProPromo}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenProCommand}" /></Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="#33FFFFFF" VerticalOptions="Center">
                            <Image WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.Source><FontImageSource FontFamily="OutlinedIcons" Glyph="auto_awesome" Color="White" Size="100" /></Image.Source>
                            </Image>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="GYM BOOK PRO" TextColor="#D9FFFFFF" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.5" />
                            <Label Text="Train smarter with AI" TextColor="White" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="18" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="✓   Plans built for your goal, schedule and equipment" TextColor="White" FontSize="13" />
                        <Label Text="✓   Import any plan from a link, photo or PDF" TextColor="White" FontSize="13" />
                        <Label Text="✓   An AI coach that changes your plan as you chat" TextColor="White" FontSize="13" />
                    </VerticalStackLayout>
                    <skeleton:CButton Text="Start your free trial" TextColor="{StaticResource Accent}" FontSize="14" FontAttributes="Bold"
                                      CButtonBackgroundColor="White" CButtonStroke="White" CornerRadius="20" HeightRequest="40"
                                      Command="{Binding OpenProCommand}" />
                    <Label Text="Cancel anytime" TextColor="#CCFFFFFF" FontSize="11" HorizontalTextAlignment="Center" Margin="0,-4,0,0" />
                </VerticalStackLayout>
            </Border>
            <!-- A member: their plan, to manage it -->
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsPro}">
                <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenProCommand}" /></Grid.GestureRecognizers>
                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" Background="{StaticResource ProGradient}" VerticalOptions="Center">
                        <Image WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source><FontImageSource FontFamily="OutlinedIcons" Glyph="auto_awesome" Color="White" Size="100" /></Image.Source>
                        </Image>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Gym Book Pro" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding ProText}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsSignedIn, Converter={StaticResource Not}}">
                <Grid Style="{StaticResource Row}">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SignInCommand}" /></Grid.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Sign in to back up and sync" TextColor="{StaticResource Accent}" />
                        <Label Text="Keep your workouts safe and use Gym Book on all your devices" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>

            <!-- You yourself: what starting weights, progression and the suggested sets and rest go by. No goal, training
                 days, session length or equipment here: those are each plan's own, asked for when one is built (and
                 remembered for the next). -->
            <Label Text="ABOUT YOU" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <!-- Starting weights, plans, calorie goals and the strength ranks go by it -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditSexCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Gender" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding SexText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditBodyWeightCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Body weight" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding BodyWeightText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <!-- Age, body fat and training history refine starting weights for new exercises. -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditAgeCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Age" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding AgeText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditBodyFatCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Body fat" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding BodyFatText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditTrainingSinceCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Training for" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TrainingSinceText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditExperienceCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Experience" />
                            <Label Text="Sets how fast weights go up, and the suggested sets and rest" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding ExperienceText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Data: first syncing with the account (signed in), then health data, from Samsung Health itself or other apps through
                 Health Connect (one row; the rest in its popup; what's read shows on the Nutrition tab), then exporting, bringing workouts back, deleting -->
            <Label Text="DATA" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <!-- Sync, one row: how the last sync went and what's waiting, with Sync now. Tapped elsewhere, Sync details:
                         every change not synced yet and why. -->
                    <Grid Style="{StaticResource Row}" IsVisible="{Binding IsSignedIn}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSyncDetailsCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Sync" />
                            <Label Text="{Binding SyncSummary}" Style="{StaticResource Caption}" FontSize="12">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SyncNeedsAttention}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Sync now" Style="{StaticResource GhostButton}" TextColor="{StaticResource Accent}"
                                FontSize="14" Padding="10,6" VerticalOptions="Center" Command="{Binding SyncNowCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource Not}}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding IsSignedIn}" />
                    <!-- The health app, one row: what it reads and how it's going, with Sync now (or Connect). Tapped elsewhere,
                         once connected, a popup with the rest (where it reads from, sending back, what it can read, disconnecting:
                         HealthSettingsPage); not yet connected, it connects. -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Health.OpenCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding Health.Title}" />
                            <Label Text="{Binding Health.Status}" Style="{StaticResource Caption}" FontSize="12" />
                            <ProgressBar Progress="{Binding Health.HistoryProgress}" ProgressColor="{StaticResource Accent}" HeightRequest="4"
                                         Margin="0,6,0,0" IsVisible="{Binding Health.ShowHistoryProgress}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{Binding Health.ActionText}" Style="{StaticResource GhostButton}" TextColor="{StaticResource Accent}"
                                FontSize="14" Padding="10,6" VerticalOptions="Center" Command="{Binding Health.ActionCommand}"
                                IsVisible="{Binding Health.IsAvailable}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" IsVisible="{Binding Health.IsConnected}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ExportCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Export data" />
                            <Label Text="Workouts and plans as CSV you can import again; food, body and activity as CSV; or everything as JSON"
                                   Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <!-- Workouts deleted, or discarded while in progress, to bring back -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenDeletedCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Recently deleted workouts" />
                            <Label Text="Bring back workouts you deleted or discarded" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ResetCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Delete data" TextColor="{StaticResource Danger}" />
                            <Label Text="Health data read in, workout history, plans, or everything" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- The app's own settings: the weight unit, then the defaults plans start from (rest every plan follows
                 unless it has its own, in its ··· menu, and how a new plan runs its weeks). -->
            <Label Text="APP SETTINGS" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditUnitCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Weight unit" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding UnitText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <!-- The exercise library, which was a tab -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenExercisesCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Exercise library" />
                            <Label Text="Browse every exercise, with videos and how-tos, and make your own" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <!-- Every AI feature at once: off, nothing goes to the AI and what offers it hides -->
                    <Grid Style="{StaticResource Row}" Padding="16,6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="AI features" />
                            <Label Text="AI plans, importing with AI, the AI coach and weekly plan suggestions. Off: nothing is sent to the AI."
                                   Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding AiEnabled}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <!-- Bedtime's settings, as from the Workout tab's bedtime card -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenBedtimeCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Bedtime" />
                            <Label Text="Reminders, sleep goal and wake-up time" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding BedtimeText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="Defaults for your plans: each plan uses these unless you give it its own, in its ··· menu under Plan settings."
                   Style="{StaticResource Caption}" FontSize="12" Margin="4,0,0,0" />

            <Grid Style="{StaticResource SubsectionHeader}">
                <Border Style="{StaticResource SubsectionIcon}">
                    <Image WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="OutlinedIcons" Glyph="timer" Color="{StaticResource Accent}" Size="32" />
                        </Image.Source>
                    </Image>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Rest" Style="{StaticResource SubsectionTitle}" />
                    <Label Text="Between sets, in plans using the defaults" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditCompoundRestCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Rest: compound" />
                            <Label Text="Squats, presses, rows and other multi-joint lifts" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding CompoundRestText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditIsolationRestCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Rest: isolation" />
                            <Label Text="Curls, raises, extensions and other single-joint moves" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding IsolationRestText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditWarmupRestCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Rest: warm-up sets" />
                            <Label Text="After each warm-up set, before the next" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding WarmupRestText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid Style="{StaticResource SubsectionHeader}">
                <Border Style="{StaticResource SubsectionIcon}">
                    <Image WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="OutlinedIcons" Glyph="trending_up" Color="{StaticResource Accent}" Size="32" />
                        </Image.Source>
                    </Image>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Training" Style="{StaticResource SubsectionTitle}" />
                    <Label Text="Reps in reserve and how plans using the defaults run their weeks" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}" Padding="16,6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Track RIR" />
                            <Label Text="Log reps in reserve for smarter progression" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding TrackRir}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}" Padding="16,6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Deload weeks" />
                            <Label Text="A lighter week after every 4: about half the sets" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding DefaultDeloads}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}" Padding="16,6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Periodization" />
                            <Label Text="Each 4-week block builds, hardest in week 4" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding DefaultPeriodization}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="INFO" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <!-- Feature requests (everyone's, to vote for) and bug reports (the user's own), kept on GitHub by the API:
                         both on the Feedback page, in its tabs -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenFeedbackCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Feedback" />
                            <Label Text="Suggest features, vote on ideas, or report a bug" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Privacy policy" VerticalOptions="Center" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Version}" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" Margin="0,8,0,0" />
        </VerticalStackLayout>
</views:TabView>
