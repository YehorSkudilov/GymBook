<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GymBook.Controls"
    xmlns:views="clr-namespace:GymBook.Views"
    xmlns:vm="clr-namespace:GymBook.ViewModels"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    x:DataType="vm:ProfileViewModel">

    <ContentView.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="ColumnDefinitions" Value="*,Auto,Auto" />
            <Setter Property="ColumnSpacing" Value="8" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="RowValue" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="Chevron" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource IconChevronRight}" />
            <Setter Property="WidthRequest" Value="16" />
            <Setter Property="HeightRequest" Value="16" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <!-- A part of Defaults (Rest, Warm-ups, Training): an icon, its name and what it applies to, above its card -->
        <Style x:Key="SubsectionHeader" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="Auto,*" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="Margin" Value="4,10,0,-4" />
        </Style>
        <Style x:Key="SubsectionIcon" TargetType="Border">
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="StrokeShape" Value="RoundRectangle 11" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="SubsectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="Divider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Color" Value="{StaticResource Surface2}" />
        </Style>
    </ContentView.Resources>

        <VerticalStackLayout Spacing="14">
            <!-- The title, with the connection at the end like on Home -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Profile" Style="{StaticResource Title}" />
                <controls:ConnectionPill Grid.Column="1" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditNameCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 28" Background="{StaticResource AccentGradient}">
                        <Label Text="{Binding Initial}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding Name}" Style="{StaticResource H3}" />
                        <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>

            <Label Text="ACCOUNT" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsSignedIn, Converter={StaticResource Not}}">
                <Grid Style="{StaticResource Row}">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SignInCommand}" /></Grid.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Sign in to back up and sync" TextColor="{StaticResource Accent}" />
                        <Label Text="Keep your workouts safe and use Gym Book on all your devices" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsSignedIn}">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SyncNowCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding AccountEmail}" LineBreakMode="TailTruncation" />
                            <!-- Selectable so a sync error can be copied into a bug report. -->
                            <skeleton:CLabel Text="{Binding SyncStatus}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="Sync now" TextColor="{StaticResource Accent}" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                    <!-- Only when something hasn't synced yet or the last sync failed. -->
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding HasSyncDetails}" />
                    <Grid Style="{StaticResource Row}" IsVisible="{Binding HasSyncDetails}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSyncDetailsCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="View details" />
                            <Label Text="{Binding SyncDetailsSummary}" Style="{StaticResource Caption}" FontSize="12" TextColor="{StaticResource Warning}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChangeEmailCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Change email" VerticalOptions="Center" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChangePasswordCommand}" /></Grid.GestureRecognizers>
                        <Label Text="{Binding PasswordRowText}" VerticalOptions="Center" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SignOutCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Sign out" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding DeleteAccountCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Delete account" TextColor="{StaticResource Danger}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- You yourself: what starting weights, progression and the suggested sets and rest go by. No goal, training
                 days, session length or equipment here: those are each plan's own, asked for when one is built (and
                 remembered for the next). -->
            <Label Text="ABOUT YOU" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditUnitCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Weight unit" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding UnitText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditBodyWeightCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Body weight" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding BodyWeightText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <!-- Age, body fat and training history refine starting weights for new exercises. -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditAgeCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Age" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding AgeText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditBodyFatCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Body fat" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding BodyFatText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditTrainingSinceCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Training for" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TrainingSinceText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditExperienceCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Experience" />
                            <Label Text="Sets how fast weights go up, and the suggested sets and rest" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding ExperienceText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- What plans start from: rest and warm-ups every plan follows unless it has its own (its ··· menu), and how a
                 new plan runs its weeks. -->
            <Label Text="DEFAULTS" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Label Text="Plans use these unless you give one its own, in its ··· menu under Plan settings."
                   Style="{StaticResource Caption}" FontSize="12" Margin="4,-6,0,0" />

            <Grid Style="{StaticResource SubsectionHeader}">
                <Border Style="{StaticResource SubsectionIcon}">
                    <Image WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="OutlinedIcons" Glyph="timer" Color="{StaticResource Accent}" Size="32" />
                        </Image.Source>
                    </Image>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Rest" Style="{StaticResource SubsectionTitle}" />
                    <Label Text="Between sets, in plans using the defaults" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditCompoundRestCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Rest: compound" />
                            <Label Text="Squats, presses, rows and other multi-joint lifts" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding CompoundRestText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditIsolationRestCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Rest: isolation" />
                            <Label Text="Curls, raises, extensions and other single-joint moves" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding IsolationRestText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <!-- Part of the warm-up settings, but it's a rest time, so it's with these -->
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding WarmupSettings.EditRestCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Rest: warm-up sets" />
                            <Label Text="After each warm-up set, before the next" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding WarmupSettings.RestText}" Style="{StaticResource RowValue}" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid Style="{StaticResource SubsectionHeader}">
                <Border Style="{StaticResource SubsectionIcon}">
                    <Image WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="OutlinedIcons" Glyph="local_fire_department" Color="{StaticResource Accent}" Size="32" />
                        </Image.Source>
                    </Image>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Warm-ups" Style="{StaticResource SubsectionTitle}" />
                    <Label Text="In plans using the defaults. Percentages are of your first working set" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Grid>
            <views:WarmupSettingsView BindingContext="{Binding WarmupSettings}" />

            <Grid Style="{StaticResource SubsectionHeader}">
                <Border Style="{StaticResource SubsectionIcon}">
                    <Image WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="OutlinedIcons" Glyph="trending_up" Color="{StaticResource Accent}" Size="32" />
                        </Image.Source>
                    </Image>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Training" Style="{StaticResource SubsectionTitle}" />
                    <Label Text="Reps in reserve and how plans using the defaults run their weeks" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}" Padding="16,6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Track RIR" />
                            <Label Text="Log reps in reserve for smarter progression" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding TrackRir}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}" Padding="16,6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Deload weeks" />
                            <Label Text="A lighter week after every 4: about half the sets" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding DefaultDeloads}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}" Padding="16,6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Periodization" />
                            <Label Text="Each 4-week block builds, hardest in week 4" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding DefaultPeriodization}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Health data from Samsung Health itself or through Health Connect (other apps): connecting, which, food from them.
                 What's read shows on the Nutrition tab. -->
            <Label Text="HEALTH DATA" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Health.ActionCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding Health.Title}" />
                            <Label Text="{Binding Health.Status}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Health.ActionText}" TextColor="{StaticResource Accent}" FontSize="14" VerticalOptions="Center"
                               IsVisible="{Binding Health.IsAvailable}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding Health.IsConnected}" />
                    <Grid Style="{StaticResource Row}" IsVisible="{Binding Health.IsConnected}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Health.ChooseAppsCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Read from" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Health.AppsText}" Style="{StaticResource RowValue}" MaximumWidthRequest="190" LineBreakMode="TailTruncation" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <!-- The other way: Gym Book's workouts, food and weights to the health app (HealthWriteBack) -->
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding Health.ShowSendBack}" />
                    <Grid Style="{StaticResource Row}" Padding="16,6" IsVisible="{Binding Health.ShowSendBack}">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding Health.SendBackTitle}" />
                            <Label Text="{Binding Health.SendBackStatus}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding Health.SendBack}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding Health.IsConnected}" />
                    <Grid Style="{StaticResource Row}" IsVisible="{Binding Health.IsConnected}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Health.OpenPermissionsCommand}" /></Grid.GestureRecognizers>
                        <Label Text="What Gym Book can read" VerticalOptions="Center" />
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding Health.IsConnected}" />
                    <Grid Style="{StaticResource Row}" IsVisible="{Binding Health.IsConnected}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Health.DisconnectCommand}" /></Grid.GestureRecognizers>
                        <Label Text="Disconnect" TextColor="{StaticResource Danger}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- The exercise library, which was a tab -->
            <Label Text="EXERCISES" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid Style="{StaticResource Row}">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenExercisesCommand}" /></Grid.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Exercise library" />
                        <Label Text="Browse every exercise, with videos and how-tos, and make your own" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>

            <Label Text="DATA" Style="{StaticResource Overline}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ExportCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Export data" />
                            <Label Text="Workouts and plans as CSV you can import again; food, body and activity as CSV; or everything as JSON"
                                   Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ResetCommand}" /></Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Delete data" TextColor="{StaticResource Danger}" />
                            <Label Text="Health data read in, workout history, plans, or everything" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid Style="{StaticResource Row}">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" /></Grid.GestureRecognizers>
                    <Label Text="Privacy policy" VerticalOptions="Center" />
                    <Image Grid.Column="2" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>

            <Label Text="{Binding Version}" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" Margin="0,8,0,0" />
        </VerticalStackLayout>
</views:TabView>
