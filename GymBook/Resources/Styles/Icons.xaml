<?xml version="1.0" encoding="UTF-8" ?>
<!--
    App icons, drawn from AppSkeleton's Material Icons font (registered by fonts.AddCIcons()) rather than image files:
    each Glyph is the icon's ligature name from MaterialIconsOutlined-Regular.codepoints. Use them as
    Source="{StaticResource IconMore}" on an Image or ImageButton; the Image's size sets how big it draws.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <FontImageSource x:Key="IconMore" FontFamily="OutlinedIcons" Glyph="more_horiz" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconChevronRight" FontFamily="OutlinedIcons" Glyph="chevron_right" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconChevronDown" FontFamily="OutlinedIcons" Glyph="expand_more" Color="{StaticResource TextPrimary}" Size="32" />
    <FontImageSource x:Key="IconCheck" FontFamily="OutlinedIcons" Glyph="check" Color="White" Size="32" />
    <FontImageSource x:Key="IconCheckRed" FontFamily="OutlinedIcons" Glyph="check" Color="{StaticResource Danger}" Size="32" />
    <FontImageSource x:Key="IconCheckMuted" FontFamily="OutlinedIcons" Glyph="check" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconCheckGreen" FontFamily="OutlinedIcons" Glyph="check" Color="{StaticResource Success}" Size="32" />
    <FontImageSource x:Key="IconClose" FontFamily="OutlinedIcons" Glyph="close" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconBarcode" FontFamily="OutlinedIcons" Glyph="barcode_scanner" Color="{StaticResource TextPrimary}" Size="32" />
    <FontImageSource x:Key="IconSearch" FontFamily="OutlinedIcons" Glyph="search" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconFilter" FontFamily="OutlinedIcons" Glyph="tune" Color="{StaticResource TextPrimary}" Size="32" />
    <FontImageSource x:Key="IconPlus" FontFamily="OutlinedIcons" Glyph="add" Color="{StaticResource Accent}" Size="32" />
    <FontImageSource x:Key="IconTimer" FontFamily="OutlinedIcons" Glyph="timer" Color="{StaticResource TextPrimary}" Size="32" />
    <FontImageSource x:Key="IconFlame" FontFamily="OutlinedIcons" Glyph="local_fire_department" Color="#FF7A45" Size="32" />
    <FontImageSource x:Key="IconTrophy" FontFamily="OutlinedIcons" Glyph="emoji_events" Color="{StaticResource Warning}" Size="48" />
    <FontImageSource x:Key="IconTrash" FontFamily="OutlinedIcons" Glyph="delete" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconArrowUp" FontFamily="OutlinedIcons" Glyph="arrow_upward" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconArrowDown" FontFamily="OutlinedIcons" Glyph="arrow_downward" Color="{StaticResource TextSecondary}" Size="32" />

</ResourceDictionary>
