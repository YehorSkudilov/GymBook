<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GymBook.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Views"
    Title="GymBook"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Workout" Icon="tab_home.png" Route="home" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Plans" Icon="tab_plans.png" Route="plans" ContentTemplate="{DataTemplate views:PlansPage}" />
        <ShellContent Title="Exercises" Icon="tab_exercises.png" Route="exercises" ContentTemplate="{DataTemplate views:ExercisesPage}" />
        <ShellContent Title="Progress" Icon="tab_stats.png" Route="stats" ContentTemplate="{DataTemplate views:StatsPage}" />
        <ShellContent Title="Profile" Icon="tab_profile.png" Route="profile" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>
