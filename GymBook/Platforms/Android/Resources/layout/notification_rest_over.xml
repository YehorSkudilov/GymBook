<?xml version="1.0" encoding="utf-8"?>
<!-- The workout notification once a rest has run out (WorkoutNotifier): the workout's name, "Rest over · next: …", and the
     time over counting on below zero in red. Inside the system's own header (DecoratedCustomViewStyle), so the icon, app
     name and sets done stay as in the other states. No bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rest_over_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/rest_over_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/rest_over_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="#FF4D4D"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
