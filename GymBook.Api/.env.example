# All settings of the GymBook API. Copy to .env (git-ignored) next to this file: docker-compose.yml passes it to the
# container, and the API loads it itself when run with dotnet run / the IDE. On the server the Publish API workflow
# writes .env from the repository's GitHub variables and secrets. "__" separates sections (Jwt__Issuer = Jwt:Issuer).

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Database. docker-compose.yml creates it from the POSTGRES_* values and points the container at it; the
# connection string below is for an API run outside Docker (docker compose up -d db, then dotnet run).
POSTGRES_USER=gymbook
POSTGRES_PASSWORD=gymbook_dev
POSTGRES_DB=gymbook
ConnectionStrings__Default=Host=localhost;Port=5432;Database=gymbook;Username=gymbook;Password=gymbook_dev
# Apply pending migrations at startup (always on in Development)
Database__MigrateOnStartup=false

# JWT. The signing key must be at least 32 characters.
Jwt__Issuer=gymbook-api
Jwt__Audience=gymbook-app
Jwt__SigningKey=
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# Swagger UI basic auth
SwaggerAuth__Username=admin
SwaggerAuth__Password=

# ChatGPT for AI-generated plans; an empty key turns them off. Clear ReasoningEffort for models that aren't
# reasoning models (e.g. gpt-4o).
OpenAI__ApiKey=
OpenAI__Model=gpt-5-mini
OpenAI__ReasoningEffort=low
OpenAI__TimeoutSeconds=90

# Email for password reset and email change codes. Empty Host turns them off (in Development the emails are
# written to the log instead). For Gmail use an app password, not the account password.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=GymBook

# Google sign-in: the Web application OAuth client ID from Google Cloud Console (the same value as the app's
# GOOGLE_WEB_CLIENT_ID). Empty turns it off.
Google__ClientId=

# Rate limits
RateLimiting__AuthPerMinute=10
# AI plans (generated or imported) each user may make: Limit per Window. Window is minutes, hours, days or weeks: 90m, 12h, 1d, 30d, 1w.
RateLimiting__PlanGenerationsLimit=10
RateLimiting__PlanGenerationsWindow=1h
# Messages to the AI plan chat each user may send, per window.
RateLimiting__PlanChatLimit=30
RateLimiting__PlanChatWindow=1d

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-* headers are trusted (besides loopback)
ReverseProxy__KnownNetworks=

# Host ports (consumed by docker-compose.yml): the API container, and the loopback-only database
API_PORT=8080
DB_PORT=5432
