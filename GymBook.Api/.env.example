# All settings of the GymBook API. Copy to .env (git-ignored) next to this file: docker-compose.yml passes it to the
# container, and the API loads it itself when run with dotnet run / the IDE. On the server the Publish API workflow
# writes .env from the repository's GitHub variables and secrets. "__" separates sections (Jwt__Issuer = Jwt:Issuer).

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Database. docker-compose.yml creates it from the POSTGRES_* values and points the container at it; the
# connection string below is for an API run outside Docker (docker compose up -d db, then dotnet run).
POSTGRES_USER=gymbook
POSTGRES_PASSWORD=gymbook_dev
POSTGRES_DB=gymbook
ConnectionStrings__Default=Host=localhost;Port=5432;Database=gymbook;Username=gymbook;Password=gymbook_dev
# Apply pending migrations at startup (always on in Development)
Database__MigrateOnStartup=false

# JWT. The signing key must be at least 32 characters.
Jwt__Issuer=gymbook-api
Jwt__Audience=gymbook-app
Jwt__SigningKey=
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# Swagger UI basic auth
SwaggerAuth__Username=admin
SwaggerAuth__Password=

# ChatGPT for AI-generated plans; an empty key turns them off. Clear ReasoningEffort for models that aren't
# reasoning models (e.g. gpt-4o).
OpenAI__ApiKey=
OpenAI__Model=gpt-5-mini
OpenAI__ReasoningEffort=low
OpenAI__TimeoutSeconds=90

# Food search databases that need a key (see Foods/FoodDatabases.cs); empty leaves each out. USDA: a free key from
# https://api.data.gov/signup. FatSecret: a free Platform API account at https://platform.fatsecret.com, with this
# server's IP address on its allowed list.
Usda__ApiKey=
FatSecret__ClientId=
FatSecret__ClientSecret=

# Email for password reset and email change codes. Empty Host turns them off (in Development the emails are
# written to the log instead). For Gmail use an app password, not the account password.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=GymBook

# Google sign-in: the Web application OAuth client ID from Google Cloud Console (the same value as the app's
# GOOGLE_WEB_CLIENT_ID). Empty turns it off.
Google__ClientId=

# The iOS OAuth client ID (the app's GOOGLE_IOS_CLIENT_ID): the iOS app's ID tokens are addressed to it. Optional.
Google__IosClientId=

# Gym Book Pro subscriptions (the AI features need one). Each store is checked only once its settings are filled in.
# Google Play: the app's package name, and a service account's JSON key (as it is or base64) with "View financial
# data" and "Manage orders and subscriptions" in Play Console › Users and permissions.
GooglePlay__PackageName=com.yehorskudilov.gymbook
GooglePlay__ServiceAccountJson=
# Real-time developer notifications (Play Console › Monetization setup): a Pub/Sub topic with a push subscription to
# https://<api>/api/store-notifications/google?token=<this>. Any long random string; empty turns them off.
GooglePlay__NotificationToken=
# App Store: an In-App Purchase key from App Store Connect › Users and Access › Integrations; the .p8 contents as
# base64 (or as they are, with \n for line breaks).
AppStore__BundleId=com.yehorskudilov.gymbook
AppStore__IssuerId=
AppStore__KeyId=
AppStore__PrivateKey=
# App Store Server Notifications V2 (App Store Connect › App Information), production and sandbox URL:
# https://<api>/api/store-notifications/apple?token=<this>. Any long random string; empty turns them off.
AppStore__NotificationToken=
# Microsoft Store: the Entra (Azure AD) app associated with the app in Partner Center › Product collections and purchases.
MicrosoftStore__TenantId=
MicrosoftStore__ClientId=
MicrosoftStore__ClientSecret=

# Admin app (GymBook.Admin): accounts made SuperAdmin at startup, comma-separated. Sign up in the app first; a
# SuperAdmin hands out the other roles from the admin app.
Admin__BootstrapEmails=

# Rate limits
RateLimiting__AuthPerMinute=10

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-* headers are trusted (besides loopback)
ReverseProxy__KnownNetworks=

# Host ports (consumed by docker-compose.yml): the API container, and the loopback-only database
API_PORT=8080
DB_PORT=5432
