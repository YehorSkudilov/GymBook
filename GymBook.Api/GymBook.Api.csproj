<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>gymbook-api-6f1c2d4e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GymBook.Shared\GymBook.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's exercise library, compiled in as it is, so shared plans show exercise names (see Social/PlanShares.cs). -->
    <Compile Include="..\GymBook\Src\Services\Exercises\*.cs" Link="Exercises\%(Filename)%(Extension)" />
    <Compile Include="..\GymBook\Src\Models\ExerciseDetails.cs" Link="Exercises\ExerciseDetails.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logo in the emails (see Auth/EmailSender.cs), rendered from the app's splash logo. -->
    <EmbeddedResource Include="Auth\EmailLogo.png" LogicalName="EmailLogo.png" />
  </ItemGroup>

</Project>
