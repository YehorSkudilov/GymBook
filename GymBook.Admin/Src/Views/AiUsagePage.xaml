<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Admin.Views.AiUsagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Admin.Views"
    xmlns:vm="clr-namespace:GymBook.Admin.ViewModels"
    xmlns:controls="clr-namespace:GymBook.Admin.Controls"
    x:DataType="vm:AiUsageViewModel"
    Title="AI usage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="12,8,12,28" Spacing="16">
                <Border Style="{StaticResource InputBox}" WidthRequest="140" HorizontalOptions="Start">
                    <Picker ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding Range}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" />
                </Border>
                <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" />

                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Tiles}" BindableLayout.ItemTemplate="{StaticResource StatTile}" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Per day" Style="{StaticResource H3}" />
                        <controls:BarChart Values="{Binding PlansByDay}" StackedValues="{Binding ChatsByDay}" HeightRequest="140" />
                        <HorizontalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="3" Color="{StaticResource Accent}" VerticalOptions="Center" />
                                <Label Text="AI plans" Style="{StaticResource Caption}" FontSize="12" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="3" Color="{StaticResource Accent2}" VerticalOptions="Center" />
                                <Label Text="Chat messages" Style="{StaticResource Caption}" FontSize="12" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding DaysRange}" Style="{StaticResource Caption}" FontSize="12" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout>
                        <Label Text="Top users" Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopUsers}" BindableLayout.ItemTemplate="{StaticResource RankedRow}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</views:BasePage>
