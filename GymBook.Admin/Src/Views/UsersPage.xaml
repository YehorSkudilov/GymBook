<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Admin.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Admin.Views"
    xmlns:vm="clr-namespace:GymBook.Admin.ViewModels"
    x:DataType="vm:UsersViewModel"
    ScrollsItself="True">

    <!-- The list scrolls by itself (it can hold 300 users), with the title, search and filters as its header. -->
    <CollectionView ItemsSource="{Binding Users}" ItemTemplate="{StaticResource UserRow}">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="12" Padding="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="Users" Style="{StaticResource Title}" />
                    <ImageButton Grid.Column="1" Style="{StaticResource IconButton}" Source="{StaticResource IconRefresh}" Command="{Binding RefreshCommand}" />
                </Grid>

                <Border Style="{StaticResource InputBox}" Padding="10,0" HeightRequest="44">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image Source="{StaticResource IconSearch}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding Query}" Placeholder="Search by email or name" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding RefreshCommand}" />
                    </Grid>
                </Border>

                <FlexLayout Wrap="Wrap" Margin="0,0,0,-8" BindableLayout.ItemsSource="{Binding Chips}" BindableLayout.ItemTemplate="{StaticResource Chip}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HeightRequest="18" WidthRequest="18" />
                </Grid>
                <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.Footer>
            <BoxView HeightRequest="{x:Static views:TabView.BottomInset}" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</views:TabView>
