<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="GymBook.Admin.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Admin.Views"
    xmlns:vm="clr-namespace:GymBook.Admin.ViewModels"
    xmlns:controls="clr-namespace:GymBook.Admin.Controls"
    x:DataType="vm:DashboardViewModel"
    Title="Dashboard">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
        <ToolbarItem Text="Sign out" Command="{Binding SignOutCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="12,8,12,28" Spacing="16">
                <Label Text="{Binding SignedInAs}" Style="{StaticResource Caption}" />
                <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" />

                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Tiles}" BindableLayout.ItemTemplate="{StaticResource StatTile}" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Sign-ups per day" Style="{StaticResource H3}" />
                        <controls:BarChart Values="{Binding Signups}" />
                        <Label Text="{Binding SignupsRange}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Workouts per day" Style="{StaticResource H3}" />
                        <controls:BarChart Values="{Binding Workouts}" />
                        <Label Text="{Binding WorkoutsRange}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout>
                        <Label Text="Most active this week" Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MostActive}" BindableLayout.ItemTemplate="{StaticResource RankedRow}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasData}">
                    <Label Text="Newest users" Style="{StaticResource H3}" Margin="4,0,0,8" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentUsers}" BindableLayout.ItemTemplate="{StaticResource UserRow}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</views:BasePage>
