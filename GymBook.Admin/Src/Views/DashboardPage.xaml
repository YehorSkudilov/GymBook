<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="GymBook.Admin.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBook.Admin.Views"
    xmlns:vm="clr-namespace:GymBook.Admin.ViewModels"
    xmlns:controls="clr-namespace:GymBook.Admin.Controls"
    x:DataType="vm:DashboardViewModel">

    <VerticalStackLayout Spacing="14">
        <!-- The title, with refresh at the end -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <VerticalStackLayout>
                <Label Text="Dashboard" Style="{StaticResource Title}" />
                <Label Text="{Binding Greeting}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <ImageButton Grid.Column="1" Style="{StaticResource IconButton}" Source="{StaticResource IconRefresh}" Command="{Binding RefreshCommand}" />
        </Grid>

        <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" IsVisible="{Binding HasError}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HeightRequest="24" />

        <VerticalStackLayout Spacing="14" IsVisible="{Binding HasData}">
            <Label Text="Users" Style="{StaticResource SectionLabel}" />
            <FlexLayout Wrap="Wrap" Margin="0,0,-10,-10" BindableLayout.ItemsSource="{Binding UserTiles}" BindableLayout.ItemTemplate="{StaticResource StatTile}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sign-ups per day" Style="{StaticResource H3}" />
                    <controls:BarChart Values="{Binding Signups}" />
                    <Label Text="{Binding SignupsRange}" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Newest users" Style="{StaticResource SectionLabel}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentUsers}" BindableLayout.ItemTemplate="{StaticResource UserRow}" />
            <Button Text="See all users" Style="{StaticResource SecondaryButton}" Command="{Binding ShowAllUsersCommand}" />

            <Label Text="Training" Style="{StaticResource SectionLabel}" />
            <FlexLayout Wrap="Wrap" Margin="0,0,-10,-10" BindableLayout.ItemsSource="{Binding TrainingTiles}" BindableLayout.ItemTemplate="{StaticResource StatTile}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Workouts per day" Style="{StaticResource H3}" />
                    <controls:BarChart Values="{Binding Workouts}" />
                    <Label Text="{Binding WorkoutsRange}" Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Most active this week" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}" Padding="0,6">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MostActive}" BindableLayout.ItemTemplate="{StaticResource RankedRow}" />
            </Border>

            <Label Text="{Binding Updated}" Style="{StaticResource Caption}" FontSize="12" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</views:TabView>
