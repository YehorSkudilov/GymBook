<Project Sdk="Microsoft.NET.Sdk">

	<!-- The admin app: Gym Book's users, stats and AI usage, for Admin/SuperAdmin accounts. Run it from Visual Studio;
	     it isn't published to any store. It talks to the same API as the GymBook app, through /api/admin. -->
	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>GymBook.Admin</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Gym Book Admin</ApplicationTitle>
		<ApplicationId>com.yehorskudilov.gymbook.admin</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<Version>$(ApplicationDisplayVersion)</Version>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.45" Color="#0B0D12" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="1" />
	</ItemGroup>

	<ItemGroup>
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B0D12" BaseSize="400,400" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GymBook.Shared\GymBook.Shared.csproj" />
	</ItemGroup>

	<!-- The API, the same one the GymBook app uses: -p:ApiBaseUrl=https://..., an API_BASE_URL environment variable,
	     API_BASE_URL in GymBook.Admin/.env, or else in GymBook/.env (so one .env serves both apps). -->
	<PropertyGroup>
		<ApiBaseUrl Condition="'$(ApiBaseUrl)' == ''">$(API_BASE_URL)</ApiBaseUrl>
		<_EnvFile>$(MSBuildProjectDirectory)\.env</_EnvFile>
		<_EnvFile Condition="!Exists('$(_EnvFile)')">$(MSBuildProjectDirectory)\..\GymBook\.env</_EnvFile>
		<_EnvFileContent Condition="Exists('$(_EnvFile)')">$([System.IO.File]::ReadAllText('$(_EnvFile)'))</_EnvFileContent>
		<ApiBaseUrl Condition="'$(ApiBaseUrl)' == '' and '$(_EnvFileContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_EnvFileContent)', '(?m)^API_BASE_URL=(.*?)\r?$').Groups[1].Value)</ApiBaseUrl>
	</PropertyGroup>

	<Target Name="ValidateApiBaseUrl" BeforeTargets="BeforeBuild;CoreCompile">
		<Error Condition="'$(ApiBaseUrl)' == ''" Text="ApiBaseUrl is not set. Set it via -p:ApiBaseUrl=https://..., an API_BASE_URL environment variable, or GymBook.Admin/.env / GymBook/.env." />
	</Target>

	<ItemGroup>
		<AssemblyMetadata Include="ApiBaseUrl" Value="$(ApiBaseUrl)" />
	</ItemGroup>

</Project>
