# Copy to .env.local for `npm run dev`, or .env for docker compose. On the server the Publish Admin workflow writes it.

# Host-side port the reverse proxy forwards to (docker compose only)
ADMIN_PORT=8082

# The GymBook API, called from this server (never from the browser)
API_BASE_URL=http://localhost:5007

# Encrypts the session cookie: at least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Only when running the production build over plain http (e.g. docker compose on your own machine)
# SESSION_COOKIE_INSECURE=true
