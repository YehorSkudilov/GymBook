<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Icons from AppSkeleton's Material Icons font (registered by fonts.AddCIcons()), as in the GymBook app: each Glyph is
    the icon's ligature name. Use them as Source="{StaticResource IconChevronRight}"; the Image's size sets how big it draws.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <FontImageSource x:Key="IconChevronRight" FontFamily="OutlinedIcons" Glyph="chevron_right" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconRefresh" FontFamily="OutlinedIcons" Glyph="refresh" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconSearch" FontFamily="OutlinedIcons" Glyph="search" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconCopy" FontFamily="OutlinedIcons" Glyph="content_copy" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconMail" FontFamily="OutlinedIcons" Glyph="mail" Color="{StaticResource TextSecondary}" Size="32" />
    <FontImageSource x:Key="IconLogout" FontFamily="OutlinedIcons" Glyph="logout" Color="{StaticResource Danger}" Size="32" />

</ResourceDictionary>
