# Copy to .env for docker compose. On the server the Publish Web workflow writes it.

# Host-side port the reverse proxy forwards to
WEB_PORT=8081

# The site's public address (used for link previews)
NEXT_PUBLIC_SITE_URL=https://gymbook.example.com

# Store links; leave one empty to show that platform as "Coming soon"
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.yehorskudilov.gymbook
NEXT_PUBLIC_MS_STORE_URL=
