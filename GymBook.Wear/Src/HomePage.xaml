<?xml version="1.0" encoding="utf-8" ?>
<!--
    The watch's home, after the phone's Workout tab: the Up next card (or the workout in progress), the plan's week with
    its days, then quick workout, account and sync. One centred column for round screens; scroll or turn the crown.
-->
<ContentPage
    x:Class="GymBook.Wear.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GymBook.Wear"
    x:DataType="local:HomeViewModel">

    <ContentPage.Resources>
        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="42" />
        </Style>
        <Style x:Key="Overline" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="CharacterSpacing" Value="1.2" />
        </Style>
    </ContentPage.Resources>

    <Grid>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20,22,20,64" Spacing="8">
            <Label Text="Gym Book" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Accent}" />
            <!-- Sync: a spinner while it runs, then a dot in its colour (green up to date, amber offline, red needs attention) -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" IsVisible="{Binding IsSignedIn}">
                <ActivityIndicator IsRunning="{Binding IsSyncing}" IsVisible="{Binding IsSyncing}" Color="{StaticResource Accent}"
                                   WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                <BoxView IsVisible="{Binding IsSyncing, Converter={StaticResource Not}}" Color="{Binding SyncColor}"
                         WidthRequest="7" HeightRequest="7" CornerRadius="3.5" VerticalOptions="Center" />
                <Label Text="{Binding SyncStatus}" Style="{StaticResource Small}" FontSize="10" VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SyncNowCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <!-- Up next, or the workout in progress: tap it, or its button -->
            <Border IsVisible="{Binding HasCard}" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 22" StrokeThickness="0" Padding="14,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCardCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding CardLabel}" Style="{StaticResource Overline}" TextColor="{Binding CardColor}" />
                    <Label Text="{Binding CardName}" FontFamily="OpenSansSemibold" FontSize="17" MaxLines="2" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding CardMuscles}" Style="{StaticResource Small}" FontSize="11" MaxLines="1" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding CardStatus}" TextColor="{Binding CardColor}" FontSize="11" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding CardMeta}" Style="{StaticResource Small}" FontSize="10" />
                    <Button Text="{Binding CardButton}" Command="{Binding OpenCardCommand}" BackgroundColor="{Binding CardColor}" HeightRequest="40" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- The plan's week: tap "Week N" for another week, a day to start it -->
            <VerticalStackLayout IsVisible="{Binding HasPlan}" Spacing="6" Margin="0,4,0,0">
                <!-- The plan's name, and its ⋯ menu (change plan, pick a week), like the phone's -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Label Text="{Binding PlanName}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Accent}" MaxLines="1"
                           LineBreakMode="TailTruncation" HorizontalOptions="Start" HorizontalTextAlignment="Start" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="⋯" Command="{Binding PlanOptionsCommand}" BackgroundColor="{StaticResource Surface}"
                            TextColor="{StaticResource TextPrimary}" FontSize="14" WidthRequest="36" HeightRequest="28" CornerRadius="14" Padding="0" />
                </Grid>
                <Button Text="{Binding WeekText}" Command="{Binding ChooseWeekCommand}" BackgroundColor="Transparent"
                        TextColor="{StaticResource Accent}" FontSize="13" HeightRequest="32" Padding="0" />
                <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="8,6">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:WatchDayItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="2,5" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 13" StrokeThickness="1.5"
                                            Stroke="{Binding BadgeColor}" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Label Text="{Binding Badge}" TextColor="{Binding BadgeColor}" FontFamily="OpenSansSemibold" FontSize="11"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" TextColor="{Binding NameColor}" FontFamily="OpenSansSemibold" FontSize="13"
                                               HorizontalOptions="Start" HorizontalTextAlignment="Start" MaxLines="1" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="10" IsVisible="{Binding HasStatus}"
                                               HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label Text="No active plan. Choose one, or make one in Gym Book on your phone." Style="{StaticResource Small}" IsVisible="{Binding HasNoPlan}" />
            <!-- Only without an active plan; otherwise switching is in the plan's ⋯ -->
            <Button Text="Choose a plan" Command="{Binding ChangePlanCommand}" Style="{StaticResource Secondary}" IsVisible="{Binding CanChoosePlan}" />

            <!-- A workout without a plan: exercises are added as it goes -->
            <Button Text="Quick workout" Command="{Binding QuickWorkoutCommand}" Style="{StaticResource Secondary}" IsVisible="{Binding CanQuickStart}" />

            <!-- Signed out: the phone mode still works; the plan needs the account -->
            <VerticalStackLayout IsVisible="{Binding IsSignedIn, Converter={StaticResource Not}}" Spacing="6" Margin="0,6,0,0">
                <Label Text="Sign in to use your plan and sync your workouts. Workouts on your phone show here either way." Style="{StaticResource Small}" />
                <Button Text="Sign in with phone" Command="{Binding SignInWithPhoneCommand}" />
                <Button Text="Use email" Command="{Binding SignInWithEmailCommand}" Style="{StaticResource Secondary}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HeightRequest="20" />
            <Label Text="{Binding Message}" Style="{StaticResource Small}" TextColor="{StaticResource Danger}" />

            <!-- Settings: units, rest timer, heart rate, buzzes, the account and syncing -->
            <Button Text="⚙  Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource Secondary}" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>

    <!-- A workout in progress, minimized: a pill floating at the bottom, like the phone's; tap to go back to it -->
    <Border IsVisible="{Binding HasPill}" BackgroundColor="#272C39" StrokeShape="RoundRectangle 17" StrokeThickness="1" Stroke="#3DFFFFFF"
            HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,14" Padding="12,6">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenRunningCommand}" />
        </Border.GestureRecognizers>
        <HorizontalStackLayout Spacing="6">
            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Success}" VerticalOptions="Center" />
            <Label Text="{Binding PillName}" FontFamily="OpenSansSemibold" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation"
                   MaximumWidthRequest="110" VerticalOptions="Center" />
            <Label Text="{Binding PillTime}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
    </Grid>
</ContentPage>
