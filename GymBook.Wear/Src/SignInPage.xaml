<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GymBook.Wear.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GymBook.Wear"
    x:DataType="local:SignInViewModel">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="26,24,26,34" Spacing="8">
            <Label Text="Sign in" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Accent}" />
            <Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email" TextColor="{StaticResource TextPrimary}"
                   PlaceholderColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" FontSize="14" />
            <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" TextColor="{StaticResource TextPrimary}"
                   PlaceholderColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" FontSize="14"
                   ReturnCommand="{Binding SignInCommand}" />
            <Button Text="Sign in" Command="{Binding SignInCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HeightRequest="20" />
            <Label Text="{Binding Message}" Style="{StaticResource Small}" TextColor="{StaticResource Danger}" />
            <Label Text="Signed up with Google? Use Sign in with phone instead." Style="{StaticResource Small}" FontSize="11" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
