<?xml version="1.0" encoding="utf-8" ?>
<!--
    The whole watch app. Laid out for small round screens: one centred column, generous side padding so nothing is
    cut off by the round edge, and one big button. Exactly one of the four states shows at a time.
-->
<ContentPage
    x:Class="GymBook.Wear.CompanionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GymBook.Wear"
    x:DataType="local:CompanionViewModel">

    <ContentPage.Resources>
        <!-- The − and + beside the weight and reps, as on the watch's own workout page -->
        <Style x:Key="Step" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="WidthRequest" Value="40" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <Grid Padding="26,22,26,26" MinimumHeightRequest="220">

            <!-- No workout on the phone -->
            <VerticalStackLayout IsVisible="{Binding IsWaiting}" Spacing="10" VerticalOptions="Center">
                <Label Text="Gym Book" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Accent}" />
                <Label Text="{Binding Status}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- The set to do: weight and reps adjust before ticking it (sent with the tick); ⋯ finishes or discards -->
            <VerticalStackLayout IsVisible="{Binding IsLifting}" Spacing="4" VerticalOptions="Center">
                <Grid ColumnDefinitions="*,Auto,Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="1" Text="{Binding Elapsed}" Style="{StaticResource Small}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding HeartRate}" Style="{StaticResource Small}" TextColor="{StaticResource Danger}" IsVisible="{Binding IsInteractive}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="3" Text="⋯" Command="{Binding OptionsCommand}" Style="{StaticResource Step}" WidthRequest="32" HeightRequest="32" CornerRadius="16"
                            FontSize="14" HorizontalOptions="End" IsVisible="{Binding IsInteractive}" />
                </Grid>
                <Label Text="{Binding ExerciseName}" FontFamily="OpenSansSemibold" FontSize="15" MaxLines="2" LineBreakMode="TailTruncation" />
                <Label Text="{Binding SetLabel}" Style="{StaticResource Small}" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" IsVisible="{Binding HasWeight}">
                    <Button Text="−" Style="{StaticResource Step}" Command="{Binding ChangeWeightCommand}" CommandParameter="-1" IsVisible="{Binding IsInteractive}" />
                    <Label Grid.Column="1" Text="{Binding WeightText}" FontFamily="OpenSansSemibold" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Button Grid.Column="2" Text="+" Style="{StaticResource Step}" Command="{Binding ChangeWeightCommand}" CommandParameter="1" IsVisible="{Binding IsInteractive}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                    <Button Text="−" Style="{StaticResource Step}" Command="{Binding ChangeRepsCommand}" CommandParameter="-1" IsVisible="{Binding IsInteractive}" />
                    <Label Grid.Column="1" Text="{Binding RepsText}" FontFamily="OpenSansSemibold" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Button Grid.Column="2" Text="+" Style="{StaticResource Step}" Command="{Binding ChangeRepsCommand}" CommandParameter="1" IsVisible="{Binding IsInteractive}" />
                </Grid>
                <Button Text="{Binding DoneText}" Command="{Binding CompleteCommand}" IsEnabled="{Binding CanComplete}" IsVisible="{Binding IsInteractive}" />
                <Label Text="{Binding Message}" Style="{StaticResource Small}" TextColor="{StaticResource Danger}" />
                <Label Text="{Binding Next}" Style="{StaticResource Small}" />
                <Label Text="{Binding Progress}" Style="{StaticResource Small}" FontSize="11" />
            </VerticalStackLayout>

            <!-- Resting after a set -->
            <VerticalStackLayout IsVisible="{Binding IsResting}" Spacing="4" VerticalOptions="Center">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="Rest" Style="{StaticResource Small}" />
                    <Label Text="{Binding HeartRate}" Style="{StaticResource Small}" TextColor="{StaticResource Danger}" />
                </HorizontalStackLayout>
                <Label Text="{Binding RestText}" FontFamily="OpenSansSemibold" FontSize="40" IsVisible="{Binding IsInteractive}" />
                <Label Text="{Binding RestUntil}" FontFamily="OpenSansSemibold" FontSize="22" IsVisible="{Binding IsAmbient}" />
                <ProgressBar Progress="{Binding RestProgress}" ProgressColor="{StaticResource Accent}" Margin="10,0,10,6" IsVisible="{Binding IsInteractive}" />
                <Label Text="{Binding ExerciseName, StringFormat='Up next: {0}'}" Style="{StaticResource Small}" MaxLines="2" LineBreakMode="TailTruncation" />
                <Label Text="{Binding SetLabel}" Style="{StaticResource Small}" />
                <Label Text="{Binding Message}" Style="{StaticResource Small}" TextColor="{StaticResource Danger}" />
                <Button Text="Skip rest" Command="{Binding SkipRestCommand}" BackgroundColor="{StaticResource Surface}" Margin="0,6,0,0" IsVisible="{Binding IsInteractive}" />
            </VerticalStackLayout>

            <!-- Every set done -->
            <VerticalStackLayout IsVisible="{Binding IsFinished}" Spacing="8" VerticalOptions="Center">
                <Label Text="✓" FontSize="34" TextColor="{StaticResource Success}" />
                <Label Text="All sets done" FontFamily="OpenSansSemibold" FontSize="16" />
                <Label Text="{Binding Elapsed}" Style="{StaticResource Small}" />
                <Button Text="Finish workout" Command="{Binding FinishCommand}" IsVisible="{Binding IsInteractive}" Margin="0,4,0,0" />
                <Label Text="{Binding Message}" Style="{StaticResource Small}" TextColor="{StaticResource Danger}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
