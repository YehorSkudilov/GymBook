<Project Sdk="Microsoft.NET.Sdk">

	<!-- The Wear OS app: a companion to the phone app during a workout. MAUI doesn't support Wear OS officially, but a
	     watch is an Android device, so this is an Android-only MAUI app with a UI made for small round screens. It has
	     the phone app's package name and must be signed with the same key: the Wearable Data Layer requires both. -->
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>GymBook.Wear</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Gym Book</ApplicationTitle>
		<ApplicationId>com.yehorskudilov.gymbook</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<Version>$(ApplicationDisplayVersion)</Version>

		<!-- Wear OS 3, the oldest version on watches still in use. -->
		<SupportedOSPlatformVersion>30.0</SupportedOSPlatformVersion>

		<!-- .NET builds only 64-bit by default, but Samsung's Galaxy Watches (4 to 8) run 32-bit ARM apps
		     (armeabi-v7a) despite their 64-bit chips: without android-arm, Play marks them unsupported.
		     arm64 for other watches, x64 for the emulator. -->
		<RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<!-- Wear OS masks the icon to a circle two thirds of its canvas: at 0.5 the book fills that circle, its corners
		     just inside it (0.32 left it small in a wide black ring). -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.5" Color="#0B0D12" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000000" BaseSize="200,200" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- Live sync with the API's SyncHub (the phone app's LiveSync.cs, linked below). -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
		<!-- The link to the phone app (Src/PhoneLink.cs). -->
		<PackageReference Include="Xamarin.GooglePlayServices.Wearable" Version="120.0.1.2" />
		<!-- Ambient mode: the workout stays on screen, dimmed, when the watch would otherwise go to its watch face. -->
		<PackageReference Include="Xamarin.AndroidX.Wear" Version="1.4.0.2" />
		<!-- The Ongoing Activity: Gym Book's icon on the watch face during a workout, tap to go back to it. -->
		<PackageReference Include="Xamarin.AndroidX.Wear.Ongoing" Version="1.1.0.3" />
		<!-- The Tile (Platforms/Android/WorkoutTileService.cs): its layout, and the futures a TileService answers with. -->
		<PackageReference Include="Xamarin.AndroidX.Wear.Tiles" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Wear.ProtoLayout" Version="1.4.2" />
		<PackageReference Include="Xamarin.AndroidX.Wear.ProtoLayout.Expression" Version="1.4.2" />
		<PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" Version="1.3.0.4" />
		<PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.32" />
	</ItemGroup>

	<!-- Play services brings newer AndroidX libraries than MAUI asks for, but not their -ktx/companion packages, so both
	     versions of some classes end up in the app ("Type ... is defined multiple times"). Lift the companions to match. -->
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GymBook.Shared\GymBook.Shared.csproj" />
		<!-- The phone app's on-device database: workouts started on the watch are stored there first, offline. -->
		<ProjectReference Include="..\GymBook.LocalData\GymBook.LocalData.csproj" />
	</ItemGroup>

	<!-- The phone app's own data, workout and sync code, compiled in as is (none of it is phone UI), so the watch stores,
	     progresses and syncs workouts exactly like the phone. Edit these in GymBook/, they're only linked here. -->
	<ItemGroup>
		<Compile Include="..\GymBook\Src\Services\DataStore.cs" Link="Shared\DataStore.cs" />
		<Compile Include="..\GymBook\Src\Services\Units.cs" Link="Shared\Units.cs" />
		<!-- The exercise library, all its files -->
		<Compile Include="..\GymBook\Src\Services\Exercises\*.cs" Link="Shared\Exercises\%(Filename)%(Extension)" />
		<Compile Include="..\GymBook\Src\Models\ExerciseDetails.cs" Link="Shared\ExerciseDetails.cs" />
		<Compile Include="..\GymBook\Src\Services\ProgressionEngine.cs" Link="Shared\ProgressionEngine.cs" />
		<Compile Include="..\GymBook\Src\Services\WorkoutService.cs" Link="Shared\WorkoutService.cs" />
		<Compile Include="..\GymBook\Src\Services\WarmupSettings.cs" Link="Shared\WarmupSettings.cs" />
		<Compile Include="..\GymBook\Src\Services\TrainingGoals.cs" Link="Shared\TrainingGoals.cs" />
		<Compile Include="..\GymBook\Src\Services\PlanCycle.cs" Link="Shared\PlanCycle.cs" />
		<Compile Include="..\GymBook\Src\Services\PlanGenerator.cs" Link="Shared\PlanGenerator.cs" />
		<Compile Include="..\GymBook\Src\Services\PlanProgress.cs" Link="Shared\PlanProgress.cs" />
		<Compile Include="..\GymBook\Src\Services\PlanRest.cs" Link="Shared\PlanRest.cs" />
		<Compile Include="..\GymBook\Src\Services\PlanSchedule.cs" Link="Shared\PlanSchedule.cs" />
		<Compile Include="..\GymBook\Src\Services\PlanTraining.cs" Link="Shared\PlanTraining.cs" />
		<Compile Include="..\GymBook\Src\Services\StatsService.cs" Link="Shared\StatsService.cs" />
		<Compile Include="..\GymBook\Src\Services\RecoveryService.cs" Link="Shared\RecoveryService.cs" />
		<Compile Include="..\GymBook\Src\Services\WorkoutEstimator.cs" Link="Shared\WorkoutEstimator.cs" />
		<Compile Include="..\GymBook\Src\Services\Sync\ApiClient.cs" Link="Shared\Sync\ApiClient.cs" />
		<Compile Include="..\GymBook\Src\Services\Sync\ApiConfig.cs" Link="Shared\Sync\ApiConfig.cs" />
		<Compile Include="..\GymBook\Src\Services\Sync\AuthSession.cs" Link="Shared\Sync\AuthSession.cs" />
		<Compile Include="..\GymBook\Src\Services\Sync\SyncService.cs" Link="Shared\Sync\SyncService.cs" />
		<Compile Include="..\GymBook\Src\Services\Sync\LiveSync.cs" Link="Shared\Sync\LiveSync.cs" />
	</ItemGroup>

	<!-- The API, the same one the phone app uses (ApiConfig.cs reads it from [AssemblyMetadata]): -p:ApiBaseUrl=https://...,
	     an API_BASE_URL environment variable, API_BASE_URL in GymBook.Wear/.env (see .env.example), or else in
	     GymBook/.env. CI passes the same API_BASE_URL variable as for the phone app. -->
	<PropertyGroup>
		<ApiBaseUrl Condition="'$(ApiBaseUrl)' == ''">$(API_BASE_URL)</ApiBaseUrl>
		<_EnvFile>$(MSBuildProjectDirectory)\.env</_EnvFile>
		<_EnvFile Condition="!Exists('$(_EnvFile)')">$(MSBuildProjectDirectory)\..\GymBook\.env</_EnvFile>
		<_EnvFileContent Condition="Exists('$(_EnvFile)')">$([System.IO.File]::ReadAllText('$(_EnvFile)'))</_EnvFileContent>
		<ApiBaseUrl Condition="'$(ApiBaseUrl)' == '' and '$(_EnvFileContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_EnvFileContent)', '(?m)^API_BASE_URL=(.*?)\r?$').Groups[1].Value)</ApiBaseUrl>
	</PropertyGroup>

	<Target Name="ValidateApiBaseUrl" BeforeTargets="BeforeBuild;CoreCompile">
		<Error Condition="'$(ApiBaseUrl)' == ''" Text="ApiBaseUrl is not set. Set it via -p:ApiBaseUrl=https://..., an API_BASE_URL environment variable, or GymBook.Wear/.env / GymBook/.env." />
	</Target>

	<ItemGroup>
		<AssemblyMetadata Include="ApiBaseUrl" Value="$(ApiBaseUrl)" />
	</ItemGroup>

</Project>
